"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter10Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="10. Прокляття">
        <div className="space-y-7">
        <p>
          Утрьох вони з горем навпіл дотягнули книжку до столика. Трійця
          розгорнула її і в останніх проміннях денного світла побачили перші
          сторінки. Пожовклі та старі, на них були різноманітні малюнки, схоже,
          зроблені вручну олівцем. Десятки лісових істот із детальним описом
          походження та їхніх здібностей.
        </p>
        <p>— Памʼятаєш, що казала мавка? — спитала Амелі.</p>
        <p>— Так, це все записи мого діда. Офігіти…</p>
        <p>
          Вони гортали сторінку за сторінкою, поки геть не стемніло, тоді
          довелось увімкнути світло. Прогортавши добру частину, вони наткнулись
          на «раздѣлъ 2», тобто другий розділ, де вже в малюнках була зображена
          історія…
        </p>
        <p>
          «Колись дуже давно, в родині здібних мольфарів народилась і росла
          талановита дівчинка. Вона мала несамовиту вдачу і надзвичайну вроду.
          Звали її Меланія. І хоч ім’я дівчинки несло темряву, сама вона несла
          добро. Меланія допомагала батькам у зціленні людей, що приходили по
          допомогу. Вона наполегливо вчилась, що згодом принесло свої плоди.
        </p>
        <p>
          Так зростала собі дитина, не знаючи ні горя, ні образ, поки одного
          разу, в лютневу ніч 1944 року, в дім не привели раненого солдата ОУН.
          Його поранили в стегно, також у плечі була куля. Солдат зміг утекти та
          заблукав, і його знайшли місцеві мешканці, після чого одразу привели в
          родину цілителів. Через декілька днів важкої боротьби за життя хлопця
          вдалося врятувати. Батьки Мелашки, попри магію, були також лікарями —
          це прикривало їх від зайвих очей, бо в той час за дивне чаклунство
          могли підпалити хату.
        </p>
        <p>
          Коли солдат врешті отямився, він зміг назвати своє ім’я — Ян, що
          разом із своїм значенням принесло божественне милосердя і любов у
          серце Меланії. Хлопець був геть юний: йому було 18, а дівчині — 16, і
          вони закохались.
        </p>
        <p>
          Минув місяць, молоді люди спілкувались. Ян мав от-от одужати і
          повернутись на війну, тому Меланія зварила зілля, яке, коли хлопець
          випив, закарбувало йому вдачу на повернення додому, але остання ніч
          перед від’їздом Яна усе змінила.
        </p>
        <p>
          Щоб попрощатись, закохані під місячним сяйвом утекли з дому пройтись
          лісом та полюбуватись водяною гладдю нічного Синевиру. Це була глибока,
          темна і дуже тиха ніч. Надзвичайно тиха. Жодної тварини, жодної
          лісової істоти вони не зустріли на своєму шляху, що здивувало
          Меланію, та Янек її заспокоював, мовляв, вони всі сплять. Прибувши на
          галявину, пара вмостилась коло озера. Закохані серця билися в такт, і
          здавалося, що життя прекрасне, та в один момент усе змінилося.
        </p>
        <p>
          Все здригнулося, і вода в озері пішла великими хвилями, вона почала
          обертатись, закрутившись у вир, і звідти виринула на перший погляд
          звичайна дівчина, проте якщо придивитись, було в ній щось химерне: від
          довгого чорного волосся і посиніліших губ тілом пішли дрижаки. У мить
          її шкіра пожовтіла, з рук виросли кігті, а очі збільшились і
          почервоніли від люті. Вода навколо неї шубовснула вниз, і вона сміливо
          зробила декілька кроків по воді назустріч молодим людям.
        </p>
        <p>
          У Яна серце пішло в п’яти, він стис долоню коханої та побачив, що вона
          не здивована, проте легке стискання його руки у відповідь видавало
          легке хвилювання.
        </p>
        <p>— Я казала, погано, що тварин у лісі немає, — прошепотіла Меланія, дивлячись на дівчину.</p>
        <p>— Хто це?</p>
        <p>
          — Синь. Ми бовдури, прийшли попрощатись на місце, де сотні років тому
          дівчина втратила кохання. Дурні.
        </p>
        <p>
          Вираз обличчя Синь був спокійний, та коли вона підійшла ближче, вуста
          відьми розтягнулись у химерній посмішці — і тоді вона заговорила.
        </p>
        <p>
          — Комусь у цьому світі щастя дано, а комусь — ні, — її голос лунав
          неначе з потойбіччя, — і на превелике нещастя я отримала друге. Я —
          Синь, зраджена батьком і проклята сама собою. Мого коханого тут убили,
          і я не дозволю, щоб хтось збудував щастя на місці мого горя! — вона
          витягла руку і стисла пальцями щось невидиме.
        </p>
        <p>
          Ян почав задихатись. Він трусився в агонії, хапаючи повітря; руки
          билися об землю — вона його душила.
        </p>
        <p>— Перестань! — крикнула Меланія. — Прошу!</p>
        <p>— Цить, дурне дівчисько!</p>
        <p>
          — Прошу! — не вгавала вона. — Я зроблю усе, що захочеш, будь ласка,
          візьми мене, не його!
        </p>
        <p>
          Відьма завмерла. Очі її розширились, і вона раптом щось усвідомила.
        </p>
        <p>
          — Дійсно, — вона перестала душити Яна і опустила руку.
          <br />
          — Ти — донька мольфарів, дівчина з ім’ям темної несе світлу магію —
          якось це неправильно. Ти почнеш відповідати своєму значенню! —
          гаркнула вона. — Станеш моєю служницею, моїми вухами, руками і очима,
          будеш виконувати мої накази, коли я скажу.
        </p>
        <p>— А з ним? Що ти з ним зробиш?</p>
        <p>Відьма розреготалась.</p>
        <p>
          — Як це що? Вб’ю, звісно. Навіщо він мені здався? Та і тобі більше не
          знадобиться — тебе чекають сотні років служби, мольфарко.
        </p>
        <p>— Прошу, не треба! Я ж помру від горя! Я накладу на себе руки! Не вбивай його!</p>
        <p>Відьма спохмурніла.</p>
        <p>
          — Ти мене шантажуєш? Як ти смієш?! — вона задумалась. — Виходить, я
          втрачу слугу, якщо вб’ю його, правильно? — вона відпустила дівчину, і
          та впала додолу. — Я зроблю краще, тому нехай живе. Можете і далі
          будувати свою долю, але знай, — вона зло процідила наступні слова, —
          ти будеш жити вічно, а він повільно старітиме. Ще якісь 60 років — а
          потім він помиратиме у тебе на очах, поки смерть не забере його, а ти
          будеш жити довгі сотні років на самоті. Ось твоя плата за це кохання.
        </p>
        <p>
          Відьма розвернулась і, дійшовши до середини озера, знову закрутилась у
          вирі й зникла під водою. Ліс сповнився тиші, і тільки два серця шалено
          билися від страху.
        </p>
        <p>— Що ти наробила, Мелашко? — спитав хлопець, важко дихаючи.</p>
        <p>— Врятувала тебе, Янеку, — відповіла вона.</p>
        <p>
          — Навіщо? Ти би ще зустріла своє щастя, а так ми тепер обидвоє
          прокляті, — бідкався він, тримаючи її за руку.
        </p>
        <p>
          Тоді вона торкнулась його щоки і мовила:
        </p>
        <p>
          — Я краще помру, ніж буду жити без тебе, і хоч це будуть 30, 40, та
          хоч 5 років, але вони будуть з тобою і в щасті.
        </p>
        <p>
          Вони обійнялися і сиділи так ще дуже довго, прощаючись.
        </p>
        <p>
          З тих пір багато чого сталось. Мелашка хоч і залишилась вдачливою, та
          її змінила тьма, яку поселила в ній відьма. Єдине, що допомагало їй
          залишатись собою, — це любов. Проте темна магія, до якої вдавалась
          Мелашка, наробила багато біди. Вона продовжила лікувати людей, але
          вони дорого платили за це здоров’ям, захистом або вдачею рідних. Через
          це репутація її родини зіпсувалась, і їх прозвали чорними магами.
        </p>
        <p>
          Деякий час було тяжко, а потім зіграло на руку. Фактичний підпис угоди
          з дияволом дав змогу Мелашці заробити велику суму на своїй репутації і
          з часом побудувати власну імперію.
        </p>
        <p>
          Янек повернувся, коли закінчилась Друга світова війна. Вони
          одружились, і юнак не перечив дружині, що сильно змінилась через
          покору відьмі. Навпаки — завдяки коханню він зміг зберегти в ній крихту
          світла, щоб дівчину не поглинула пітьма. І хоч Мелашка всі роки
          намагається уникати Синь, ховаючись від неї, проте та її завжди
          знаходить. Не одне життя Мелашка забрала не по своїй волі, та така
          ціна щастя.
        </p>
        <p>
          Щодня вона страждає, усвідомлюючи це, невпинно і повільно разом із
          своїм безсмертям, споглядаючи, як старіють рідні та близькі, але не
          вона».
        </p>
        <p>
          Розповідь супроводжувалась картинками із чорними постатями хлопця та
          дівчини. Закінчивши читати, трійця перезирнулась.
        </p>
        <p>
          Яся сиділа із заокругленими очима. Вона намагалась переварити це та не
          могла.
        </p>
        <p>
          — Отже, твоя бабця — проклята мольфарка. От чому вона не старіє! —
          сказала Амелі. — Точніше, старіє, але значно повільніше за інших, і
          вона виконує накази Відьми, тому їй не вигідно, щоб сюди хтось ліз, а
          вхід у ліве крило заборонений… Проте, — вона задумалась, — чому вона
          нас досі не зловила?
        </p>
        <p>
          — Вона не знає, — пояснив Влад, — інакше нас би вже давно викрили.
          Скоріш за все стара Мелашка дізнається тоді, коли ми вперше
          познайомимось із нашими стихіями. Відьма це відчує, весь ліс це
          відчує.
        </p>
        <p>— Звідки ти це знаєш? — здивувалась Амелі.</p>
        <p>
          — Я живу із чаклункою, якій понад 100 років. Як гадаєш, звідки я це
          знаю? — в’їдливо відповів Влад, і Амелі здивувалась.
        </p>
        <p>— Пані Агаті більше 100 років?</p>
        <p>
          Влад закотив очі, і тоді вони обоє побачили ступор Ясі.
        </p>
        <p>— Все гаразд? — стурбовано спитала Амелі.</p>
        <p>Яся кивнула.</p>
        <p>
          — Так, просто дивно все це. Наче віриш, а наче дурня якась, — вона
          поглянула на книжку. — Гаразд, я ще матиму час це обдумати. Давайте
          дивитись, що там ще є.
        </p>
        <p>
          І усі троє перегорнули наступну сторінку, де закрученими чорними
          літерами писало «҃А ГЛАВѢ», після чого: «1.1 Як Бог сотворив 4
          Стихії». І, схиливши над книжкою голови, вони почали читати.
        </p>
        <p>
          «Колись давно, коли світу ще не торкалась нога людини, Бог вирішив
          створити собі помічників.
        </p>
        <p>
          Перша з них була пані Вітер. Через довгі спекотні дні помирали звірі,
          їм потрібна була прохолода. Легке тільце пані Вітер проносилось усюди:
          рівнинами, горами, кручами. Вона звіювала усе довкола, і повітря
          ставало прохолодним, що полегшувало життя флорі й фауні.
        </p>
        <p>
          Але цього було мало. Звірі помирали через постійні засухи. Вода в
          річках та озерах висихала, тому Бог створив Володарку Води. Завдяки
          їй, струмки і озера тепер завжди були наповнені, і звірі мали змогу
          напитись, а ґрунт не висихав, даючи змогу процвітати флорі. Вони з
          Володаркою Вітру об’єднували сили, ставши найкращими друзями.
          Здавалось, цього досить, і всього вистачало, та коли Бог створив
          людей, уже самі тварини звернулись до нього.
        </p>
        <p>
          Вони попросили захисника — того, хто оберігатиме їх від людини і не
          дасть витіснити їх з цього світу. Бог змилувався і створив Володаря
          Землі. Йому він доручив споглядати за своїм творінням та тримати
          баланс у світі, після чого Бог відправився у подорож іншими світами.
          Баланс процвітав довго, та невдовзі на Землю зійшла страшна буря: небо
          розсікла блискавка, вона вдарила в дерева, від чого з’явився вогонь, а
          з нього вийшов сам Володар Вогню. Завдяки ньому люди змогли готувати
          собі їжу, грітися довгими дощовими днями і майструвати посуд.
          Почалась еволюція, за що вогонь люди і полюбили.
        </p>
        <p>
          Інші стихії не з такою приязню ставились до нього, окрім Володарки
          Вітру. Їй подобалось до нього чіплятись і гратись з полум’ям. Вона
          вміла його як заспокоїти, так і розгнівати так, що Вогонь зносив усе
          на своєму шляху. З Водою він не ладнав, як і з Володарем Землі. Від
          Води його миттю чекала смерть, а звірям і природі він міг завдати
          болю, що непокоїло їхнього захисника. Вогонь завжди був поодинці, і
          якби не Вітер, мабуть, геть зажурився б. Люди кажуть, що це Бог
          розлютився і блискавкою хотів їх покарати за гріхи, та натомість
          подарував їм Вогонь. Ніхто не знає, чи це так. Навіть чотири стихії
          вже мільйони років не бачили свого творця, тому це переросло в
          легенду».
        </p>
        <p>
          На сторінках були з різних кутів зображені стихії Вогню, Землі, Води
          та Повітря. Роздивившись їх, Яся, не питаючи інших, перегорнула
          сторінку. Її щоки палали, а про те, щоб підняти голову і подивитись
          комусь в очі, і мови не було. Особливо — поглянути на Влада…
        </p>
        <p>
          Отже, перегорнувши сторінку, вони побачили наступне: «2.1 Стихії».
          Декілька сторінок було списано різноманітними здібностями та історіями
          Володарів Вітру, Вогню, Води та Землі. Прогортавши їх, трійця побачила
          наступний розділ:
        </p>
        <p>«ГЛАВѢ ТРЕТІИ. ЛЕГЕНДА ОЗЕРА. СИНЕВИРЪ».</p>
        <p>
          Пройшовшись очима, Яся зрозуміла, що це.
        </p>
        <p>— Це та легенда, яку розповідала твоя бабця? — спитала вона у Влада, не піднімаючи очей.</p>
        <p>Він сказав «угу», і вона, погортавши далі, дійшла до підрозділу:</p>
        <p>«3.1 Як стихії знову воз’єднаються».</p>
        <p>
          «Перш ніж прийде ця мить, пройде багато-багато віків. Ослабне Вітер,
          Вогонь, ослабнуть Вода з Землею — і тоді Володарі, залишивши своїх
          підопічних, покинуть цей світ і опиняться в ньому знову, але вже в
          тілах людей — донорів, якими будуть живитись. Вони подарують цим людям
          вдачу та не зможуть вберегти від усіх бід. Взамін отримуватимуть
          потужну енергію. Ці люди мали зробити великий внесок у цей світ, та
          тепер їхня доля буде присвячена для більш важливого — спасіння світу.
        </p>
        <p>
          Це буде затишшя перед бурею. Вони повернуться сильнішими і
          могутнішими, і здійсниться легенда, пророкована лісовими істотами 800
          років тому. Кожен із них спричинить злість відьми: здригнеться
          Північ, Південь, Схід і Захід, і коли останній прибуде, стане відьма
          очікувати своєї миті, збиратиме своїх посіпак і поступово забиратиме
          землю під воду. Як стихіям перемогти? — спитають мене нащадки наші, а
          відповідь проста: погасіть свою гординю, відпустіть злість і
          ненависть».
        </p>
        <p>
          — «Здригнеться Північ, Південь, Схід і Захід…» — задумалась Яся. —
          Перед тим, як я мала їхати до бабці, на Чернігівщині стався землетрус…
        </p>
        <p>
          — Я в той час прибув до бабці, у школі почалось дистанційне.
        </p>
        <p>
          — Північ… — прошепотіла Яся. — Коли я прибула, відбувся землетрус на
          півдні, і пройшовся аж до Києва, — пояснювала вона. — Далі — схід: це
          було тоді, коли поїхали німці і в маєток заселяли родину французів,
          тобто тебе, Амелі, — поглянула Яся на подругу, і та кивнула. — І
          останній землетрус — здригнувся захід країни, коли ми поїхали в центр
          села в магазин. Отже, Володар Землі прибув у той день і, скоріш за
          все, десь тут серед нас, — заключила вона. — Дивовижно!
        </p>
        <p>— Не те слово, — мовила не менш шокована Амелі.</p>
        <p>
          — Боже, та це ж було очевидно! — огризнувся Влад і, сіпнувши на себе
          книжку, продовжив читати:
        </p>
        <p>
          «Вас розбратали недуги — так помиріться через десятки років. Да
          воз’єднаються вони і вийдуть зі своїх тіл і полетять над Горганою і
          Синевиром; та пам’ятайте: вас об’єднає тільки ваш зв’язок. Дружба,
          чесність, доброта. Не забувайте про те, хто ви. Надіюсь, за ці роки ви
          отримали хороший урок, а якщо ні — то встане відьма 8 числа 21-тої
          весни 21 сторіччя, і настане нам усім кінець.
          <br />
          Не підведіть нас, Володарі 4 стихій. У ваших руках — життя України».
        </p>
        <p>
          Яся втупилась у слова. В їхніх руках — життя всієї країни. В руках
          трьох 15-річних підлітків десь посеред Карпат, у яких ще молоко на
          губах не обсохло. Чому саме вони? Вона відкинулась на стілець і почула
          шурхотіння листів — Амелі гортала далі, щось уважно розглядала і потім
          з вердиктом винесла:
        </p>
        <p>
          — Народ, тут пише: щоб об’єднатись і відділитись від тіла, ми повинні
          розповісти одну подію з нашого життя, яка залишила на нас великий
          шрам. А після першого «возз’єднання» у нас повинні на тілі з’явитись
          символи. Погляньте!
        </p>
        <p>
          Вони знову усі схилились над фоліантом і почали розглядати картинки.
        </p>
        <p>
          Велична морська змія звивалась своїм довгим тілом навколо тризуба,
          поєднуючи в цьому красу і небезпеку водної стихії. Луска змії блищала
          сріблом, немов вона зроблена з води, а на спині зображені дрібні
          плавники-крильця. Тризуб вбитий у землю, а довкола — водорості, мушлі
          і сотні різноманітних підводних мешканців. Внизу писало: «Володарка
          Води».
        </p>
        <p>
          Наступною картинкою був кінь, зроблений з вітру. Він неначе застиг на
          шаленій швидкості, його довга грива звивалась, а ноги були підняті одна
          за одною. Сіро-білий, він здіймав усе довкола буревієм. Внизу був
          підпис: «Володарка Вітру».
        </p>
        <p>
          Третя картинка показувала орла. Він стояв прямо, крила розправлені в
          сторони, весь червоний — неначе палав. Коло картинки красувався
          підпис: «Володар Вогню».
        </p>
        <p>
          Остання картинка показувала хлопця, що сидів на зеленому троні. На
          голові рівно височіла корона, він опустив руки на підлокітники,
          дозволяючи ліанам, квітам і травам обмотати усе довкола. Угорі в
          польоті спинилось декілька птахів, унизу, коло ніг, розташувалась купа
          тварин: зайці, лисиці, ведмеді, їжаки і багато, багато інших лісових
          мешканців. Усе було зелене.
          <br />
          Внизу був підпис: «Володар Землі».
        </p>
        <p>Після картинок йшов наступний текст:</p>
        <p>
          «Стережіться! Як тільки на вас з’являться мітки, ви воз’єднаєтеся з
          лісом та природою. Не дивуйтесь, якщо заснете у своїх кімнатах, а
          прокинетесь посеред лісу або на дні озера».
        </p>
        <p>
          Далі йшло ще багато нотаток, але в бібліотеці геть стемніло, тому,
          увімкнувши світло, вони сіли довкола столика і декілька хвилин усі
          троє мовчали. Вони не знали, як бути далі, що їм робити. Кожен хотів
          від цього відмовитись, але як — коли в тобі живе стихія, з якою ти
          роз’єднатись можеш тільки об’єднавшись.
        </p>
        <p>
          — А що буде в кінці? Як ми повинні перемогти Відьму? І якщо,
          гіпотетично, переможемо — що далі? — спитала Амелі, але ці слова так і
          повисли в повітрі.
        </p>
        <p>
          — Я спитаю в бабці, — сказав Влад. — А нам на сьогодні досить. Сховай
          книжку в себе в кімнаті, вона нам ще знадобиться, — поглянув він на
          Ясю, та вона вперто його уникала.
        </p>
        <p>— Не можу, в мене бабця лазить.</p>
        <p>
          — Тоді забере Амелі. І вже пізно — вас можуть схопити. Я повернусь
          сам, не проводжайте мене, це займе багато часу…
        </p>
        <p>— Ніхто і не збирався, — пробубніла Яся, але Влад, на щастя, не почув.</p>
        <p>
          — …а ми маємо, умовно, усі розминутись, — він підвівся і, закривши
          книжку, всучив її Ясі.
        </p>
        <p>
          Вона таки підняла погляд та одразу відвела, знову відчувши сором. Щоб
          більше не контактувати ні з ким, дівчина встала і хутко пішла до
          виходу. Утрьох вони дістались кімнати Ясі, там і попрощались. Але
          замість того, щоб піти на вечерю, Яся закуталась у ковдру і міцно
          заснула. Вночі її розбудила бабця, яка принесла якісь ліки. Яся випила
          запарений порошок, їй поміряли температуру, яка дійсно трохи піднялась
          (що зіграло на руку), і через годину лишили у спокої. Не в змозі
          більше заснути, вона доробила домашнє і ще дуже-дуже довго лежала та
          обдумувала усе, що вони дізнались, адже наступним їхнім кроком буде
          знову йти в ліс.
        </p>
     </div>

        <div className="mt-8 flex justify-between text-lg">
          <Link
            href={`/${lang}/reading/chapters/9`}
            className="underline"
          >
            ← Попередній
          </Link>

          <Link
            href={`/${lang}/reading/chapters/11`}
            className="underline"
          >
            Наступний →
          </Link>
        </div>
      </BookPage>
    </main>
  );
}
