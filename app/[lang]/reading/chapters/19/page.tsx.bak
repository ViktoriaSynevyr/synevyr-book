"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter19Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="19. Різдво та його наслідки">
        <div className="space-y-7">
        <p>
          З останнього походу в ліс минали дні, а за ними й тижні. Друзі
          вагалися знову туди йти, оскільки кожен перевтілення пережив по-своєму.
          Ясю ще декілька днів нудило, Влад казав, що все, до чого йому варто
          доторкнутись, може спалахнути, тому він почав ходити в рукавицях; та
          сама проблема була і з їжею. Все, що він міг собі дозволити, — це
          холодні напої і така ж холодна їжа на кшталт йогуртів та фруктів.
        </p>

        <p>
          Марк жалівся на головний біль, а ще у нього почало з голови та вух
          рости гілля й листя, які він щоразу намагався обрізати, тож тепер
          постійно ходив у шапці. Амелі одного разу прокинулась у
          напівзатопленій кімнаті, через що її з батьками ледь не виселили, але
          змогли прикрити це «прорваною трубою» (яку Амелі спеціально пробила).
        </p>

        <p>
          Тож усім було геть не до свят, які наближалися, а першим із них було
          Різдво за Григоріанським календарем — 25 грудня. Як завжди, для
          туристів напередодні в кафе зробили чудову атмосферу, і всі родинами,
          кожен за окремим столиком, сиділи при свічках та обмінювалися
          подарунками у в’язаних светрах. Яся в той день ледь не «померла» на
          зміні, тому о шостій, щойно закінчила, кулею вилетіла на вечерю.
        </p>

        <p>
          У хатчині на неї також чекав накритий стіл і компанія бабці з дідом.
          Як їй пояснили, вони намагались слідувати європейським традиціям, тому
          святкували Різдво двічі: з 24-го на 25-те і з 6-го на 7-ме. Працівників,
          як завше, раніше відпустили додому, а тренування з верхової їзди
          відмінили.
        </p>

        <p>
          Після вечері бабці подзвонили батьки Ясі, вони балакали кілька хвилин,
          після чого старенька передала телефон онуці.
        </p>

        <p>— Привіт, доню, — почула Яся в трубці.</p>

        <p>— Привіт, мамо, привіт, тату.</p>

        <p>— Як у тебе справи, як підготовка до іспитів?</p>

        <p>
          — Я все склала ще кілька днів тому. Оцінки хороші, у мене почалися
          канікули. Зараз дуже змучена через роботу.
        </p>

        <p>— Ми теж із татом змучились, — підхопила мама, — але ж працюємо для тебе.</p>

        <p>— Ніби я вас пр… — але мама її перебила:</p>

        <p>
          — Бабця запросила нас відсвяткувати Різдво в Міжгір’ї. Це родинне
          свято, тому ми погодились. Ми прилетимо 5 січня десь на тиждень, далі
          знову тур, але за кордоном. Наступний рік уже сплановано на 6 місяців
          уперед і обіцяє бути дуже насиченим. Ну все, мушу бігти, тато каже, що
          любить тебе, і я теж. Надобраніч і щасливого Різдва.
        </p>

        <p>— Щасливого Різдва, — сказала Яся і, навіть не встигнувши закінчити фразу, почула тишу — мама поклала трубку.</p>

        <p>Вона передала телефон бабці.</p>

        <p>— Вони приїдуть через кілька днів. Дякую за вечерю, я спати.</p>

        <p>— Добраніч, Ярославо, — мовила бабця, і Яся вийшла в морозну ніч, стримуючи сльози. Їй не вистачало батьків та їхньої підтримки, так само як і розмов із ними, які все життя скорочувала насичена робота.</p>

        <p>
          Минуло ще два тижні в роздумах. Друзі не наважувалися повернутись у
          бібліотеку, тому просто розтягували час і смак свят. Новий рік вони
          зустріли у великому колі туристів у кафе. Опівночі всі відраховували
          цифри, а о 12 відкрили шампанське, і ще кілька годин грала музика.
        </p>

        <p>
          Потім прийшло 5 січня — і батьки справді приїхали. Вони залишили
          шлейф парфумів коридорами маєтку і, на диво, їх поселили в крило
          гостей, що збентежило Ясю, але мама пояснила це тим, що вони з бабцею
          просто одна одну не долюблюють.
        </p>

        <p>
          — Скоріш за все, вона хотіла мене цим уколоти, але насправді мені
          начхати, ти сама знаєш, — казала вона, поки її помічники заносили й
          розпаковували валізи у номері.
        </p>

        <p>
          На Різдво усі зібралися в хатчині. Стіл був накритий червоною
          скатертиною, а по краях під неї запхали по головці часнику. Бабця
          накрила великий стіл із 12 пісних страв: кутя, мачанка з грибами,
          вареники з капустою, голубці з рисом, борщ (без м’яса), риба смажена
          та копчена, квасоля, відварена в олії, оселедець, картопля в мундирах,
          капусняк, узвар та пампушки з часником, від чого у Ясі аж слина текла.
        </p>

        <p>
          Перед вечерею родина помолилась, і дід Янек запалив свічку. Після
          вечері ввімкнули телевізор, де по Новому каналу показували фільм
          «Вечори на хуторі біля Диканьки». Десь на моменті, коли чорт прийшов у
          гості до Солохи, до них уперше постукали, і бабця пустила колядників.
          Діти по 7–10 років, закутані в теплі дублянки, шапки і шарфи, один
          тримав зірку на довгій палиці, прикрашену різнокольоровими стрічками,
          всі решта — по дзвіночку, що дзвеніли в такт мелодії. Вони заспівали
          одну з колядок, яку Ясю вчили в дитинстві:
        </p>

        <p>
          «Нова радість стала,<br />
          Яка не бувала,<br />
          Над вертепом звізда ясна<br />
          Увесь світ засіяла…»
        </p>

        <p>
          Бабця дала їм 50 гривень і зачинила двері, поки не прийшли наступні
          колядники. Яся, наївшись, задрімала від тепла, що йшло з дверцят
          каміна, та казкової мелодії фільму на фоні. Прокинулась уже зранку у
          себе в кімнаті, коли було геть світло. Хтось її відніс, поки вона
          спала, і навіть роззув та накрив одіялом.
        </p>

        <p>
          Зібравшись, Яся спустилася на сніданок і, йдучи подвір’ям, побачила,
          що біля ялинки діти, перевдягнувшись в янголят, баранчиків та інших
          персонажів, біля декорацій відтворили сцену народження Ісуса Христа.
          Вони співали колядки, а люди захоплено слухали, кидаючи гроші у
          великий кошик, що стояв поодаль.
        </p>

        <p>***</p>

        <p>
          Після Різдва прийшла Маланка. У кафе гучним вертепом завітала групка
          дітей, переодягнена у фольклорних персонажів: хтось був козлом, хтось
          циганом, хтось одягся на кшталт старенької пари баби та діда; друга
          Влада з «Ватри» Михасю, як зрозуміла Яся, одягнули в Маланку —
          запхали під сорочку надуті повітряні кулі замість грудей, одягли
          спідницю і намалювали губи червоною помадою. Його тримав під руку
          інший хлопчина, який назвався Василем, також навколо них крутився
          циган, а коли Яся з Амелі добачили, що останнім персонажем був чорт, у
          якого переодягли Влада, то ледь не попадали зі стільців від сміху.
        </p>

        <p>Діти першим ділом заспівали щедрівку:</p>

        <p>
          «Ой сивая тая зозуленька,<br />
          Щедрий вечір, добрий вечір,<br />
          Добрим людям на здоров’я…<br />
          Усі сади тай пооблітала —<br />
          Щедрий вечір, добрий вечір…»
        </p>

        <p>
          Щедро посипаючи кафе зерном. Потім усі затихли, вимкнули світло,
          залишивши лише одну лампу посередині кімнати, і діти почали
          розігрувати сценку.
        </p>

        <p>
          Невміло танцюючи, у середину зали вийшов Михась і заговорив,
          пародіюючи жіночий голос:
        </p>

        <p>— Я прийшла туй з Василем, аби радости принести! Де ж ти, Василю, ходиш? Покажи свою силу!</p>

        <p>Василь вийшов слідом, підняв руки вгору і крикнув:</p>

        <p>— Я Василь, я крепкий, принесу вам урожай густий! Буде в домі і здоровля, і багатства, і любови!</p>

        <p>
          Слідом до них пристрибала дівчинка, що зображала козу; придивившись,
          Яся впізнала Лізу і захоплено сплеснула в долоні. Ліза заговорила до
          Василя:
        </p>

        <p>— Ме-е-е! Я — Коза весела, де ходжу — там достаток! Де моє місце — там і щастя!</p>

        <p>— Козочко, козочко, покажи ґаздам, яка ти шпарка та крепка! — сказала Маланка, і Ліза почала весело стрибати та кружляти навколо гостей, але раптом упала на землю і, схоже, прикинулася мертвою.</p>

        <p>Василь із переляком нахилився до неї, прислухаючись до серцебиття.</p>

        <p>— Ой лишенько! Коза занедужала! Треба її рятувати! — сказала Маланка, розмахуючи руками.</p>

        <p>
          Раптом із темряви вибіг Влад, тримаючи палицю, і почав навколо Лізи
          стрибати та розмахувати атрибутом.
        </p>

        <p>— Ха-ха-ха! Нема вашій Козі порятунку! Це я, Чорт, відібрав у неї силу!</p>

        <p>— Ай ти, злодію! Верни Козі її силу, а то буде тобі лихо велике! — тикнула його в бік Маланка.</p>

        <p>Влад сплеснув руками:</p>

        <p>— Ага, так просто не віддам! Якщо ви мене переможете в танці, тоді подумаю!</p>

        <p>— Тоді зтанцюймо ж, Чорте! — крикнула Маланка, і двоє хлопців пішли у пляс.</p>

        <p>
          До них доєднався Василь, і вони з Маланкою почали танцювати навколо
          Чорта, роблячи смішні рухи, намагаючись його здивувати. Влад пробував
          повторювати їхні рухи, але зробив вигляд, ніби спіткнувся й упав, що
          викликало сміх у присутніх у залі. Врешті він здався.
        </p>

        <p>— Ой, все, здаюся! Забирайте свою силу назад! — сказав він.</p>

        <p>
          Маланка і Василь радісно крикнули, хтось засвистів. Коза ожила,
          піднялася і знову почала весело стрибати.
        </p>

        <p>— Ме-е-е! Я знову жива й весела! Буде вам рік багатий!</p>

        <p>
          Зала вибухнула оплесками. Хлопці з Лізою вклонилися, після чого всі
          стихли, і Михась знову заговорив:
        </p>

        <p>— Дякуємо за вашу увагу, любі гості! Ми бажаємо усім удачі й гарного врожаю, хай у вашому домі буде щастя й радість увесь рік! — і діти ринулися в танець, заохочуючи до нього гостей у залі.</p>

        <p>
          Побачивши Ясю, Ліза потягнула її до всіх; Амелі теж хтось витягнув із
          місця, потім вони побачили й Марка, і їхнє коло закріпив Влад. Вони
          кружляли в шаленому танку, аж раптом відчули, як по руках пройшовся
          струм і разом у всіх у голові спалахнула одна й та сама думка: час
          повертатися до лісу.
        </p>

        <p>
          До своєї домівки, до свого коріння. Вони — розпашілі й спітнілі —
          потім спинились, намагаючись віддихатися. Ніхто цього не помітив, бо в
          залі панував хаос: вертеп почали пригощати смаколиками й просити ще
          одну сцену.
        </p>

        <p>— Я хочу знову возз’єднатись зі стихією, — тихо мовила Яся. — Ви як?</p>

        <p>— Я теж, — погодився Влад. — На коли плануємо йти?</p>

        <p>— Сьогодні? — спитав Марк, але Яся одразу цей варіант відхилила.</p>

        <p>— Ні, давайте завтра ввечері. Мої батьки їхатимуть додому, я маю їх зранку провести; якщо мене не знайдуть у кімнаті — шукатимуть. Ну і самі розумієте наслідки.</p>

        <p>
          Друзі кивнули й домовилися вирушити наступної ночі. Решту часу
          провели, бешкетуючи в компанії фольклорних персонажів, спостерігаючи,
          як ті жартували з господарями — бабцею Мелашкою та дідом Янеком, — як
          намагались говорити англійською з туристами та смішити їх.
        </p>

        <p>Після довгого святкового вечора мама попросила Ясю переночувати в їхньому з татом номері.</p>

        <p>— Ти така щаслива, доню. Я рада, що ти знайшла собі друзів і підтягнула оцінки в школі.</p>

        <p>
          Яся кивнула, нічого не відповівши. Щось їй не сподобалось у маминих
          словах: там вчувався якийсь підступ. Але дівчина відігнала ці думки і,
          одягнувши піжаму, поринула в царство сновидінь. Усю ніч їй снилось, як
          вона тікає від Арідника, а зранку Яся пожаліла, що не додумалась узяти
          з собою полин під подушку. Останній тиждень їй перестали снитися жахи
          та й узагалі сни — просто темрява, вона нарешті почала висипатися. Але,
          заспокоївши себе, що наступну ніч ночуватиме в кімнаті, пішла на
          сніданок, де їй сказали те, від чого здалося, що кошмар продовжився
          наяву, а серце впало в п’яти: батьки вирішили забрати її додому.
        </p>

        <p>— Але чому?! — скрикнула Яся, коли побачила, що всі речі з її кімнати спаковані у валізи і разом із багажем батьків їх несуть до літака кремезні чоловіки. По її щоках потекли сльози.</p>

        <p>
          — Ти вийшла з депресії і нарешті знову добре вчишся, у тебе налагоджено
          режим і ти стала чемна. Я більше не бачу потреби тобі тут залишатись,
          — пояснила мама. — Та й домовлялись ми, що ти покарана тільки до
          Різдва.
        </p>

        <p>— Але в мене тут друзі!</p>

        <p>
          — На тебе в Києві чекає Дем’ян, — дорікнула жінка, ігноруючи сльози
          дитини, — але він став якийсь дивний… Останній раз, як я його бачила,
          він здався надто тихим для такого балакучого, ніби поринув сам у себе.
          Дуже дивно… Ну годі, ходімо, у нас через 5 хвилин виліт.
        </p>

        <p>
          Яся навіть не встигла попрощатися з друзями. Лиш ішла за мамою й татом
          слідом, а сльози текли й текли — безперервно й болісно осідаючи на
          душі. Навіть пані Вітер стала на бік Ясі, вона намагалась її
          підтримати, але марно: дівчині здавалось, ніби весь світ у мить
          зруйнувався.
        </p>

        <p>***</p>

        <p>
          Яся сиділа під ковдрою у себе в кімнаті. Вона накрилась із головою і
          згадувала останні три місяці, що прожила у бабці. Володарка Вітру теж
          сумувала: їй хотілося на волю, знову почути Володарку Води і побачити
          Володаря Вогню. Вона казала Ясі, що тій потрібно піти в старовинне
          місце, щоб пані Вітер могла підживитись енергією, але Яся вже не
          слухала.
        </p>

        <p>
          Від цього безперервного потоку слів дівчині часом здавалося, що вона
          божеволіє. Їй набридло чути голос пані Вітер у голові, але вона не
          знала, як її «заткнути», поки не додумалась одягнути навушники і
          ввімкнути музику. В такі моменти на деякий час наставала тиша, та
          потім починала нестерпно боліти голова.
        </p>

        <p>
          Тоді Яся вирішила піти на контакт. Вона просила залишити її в спокої,
          але стихія й не думала вгавати. Врешті Яся змирилася і поставила за
          мету дізнатися щось нове, тож почала більше з нею спілкуватись. Перше,
          що дівчину зацікавило, — чому стихії пішли саме з України.
        </p>

        <p>«Така вже була воля Господа нашого…»</p>

        <p>— Як тоді працює вітер в інших куточках світу?</p>

        <p>
          Пані Вітер одного дня не на жарт розійшлася: голос у голові настирливо
          казав вийти надвір і полетіти, побігти, зробити бодай щось, відчути
          бодай щось. Але Яся сиділа, як той стовбур, завмерши, бо розуміла: якщо
          вона вийде, то не полетить, а шубовснеться у сніг. І навіть якщо зуміє
          дати Володарці Вітру волю, як потім повернеться в своє тіло? В лісі за
          ними всіма стежила мавка, спрямовувала, а тут? Вона за сотні кілометрів
          від лісу — хто зна, що тоді буде? Тому, зробивши глибокий вдих і
          видих, Яся спробувала домовитись із голосом усередині.
        </p>

        <p>— Давайте почнемо з малого?</p>

        <p>«Наприклад?»</p>

        <p>— Покажіть, що ви найменше можете.</p>

        <p>«Люба моя, це не те, що ми маємо робити…»</p>

        <p>— Саме те. І краще, ніж нічого, хіба ні?</p>

        <p>Володарка Вітру задумалась.</p>

        <p>«Ну гаразд. Підійми руку.»</p>

        <p>Яся послухалась.</p>

        <p>— Що ти робиш?.. — здивувався Дем’ян, що писав конспект із біології.</p>

        <p>
          Але дівчина мовчала — слухала тільки голос у підсвідомості.
        </p>

        <p>«Зосередься на одній точці, наприклад…»</p>

        <p>
          Яся впіймала поглядом порожню чашку від чаю. Вона довго й зосереджено
          дивилася, після чого чашка поступово почала підійматися в повітря.
          Яся ворухнула пальцями, і горнятко зробило кілька обертів, піднявшись
          до самої стелі.
        </p>

        <p>«Змахни рукою.»</p>

        <p>
          Яся послухалася — і кружка з усієї сили вдарилась об письмовий стіл.
          Скалки полетіли в різні боки, і друзі вчасно встигли закритись пледом.
        </p>

        <p>— Навщо ти це зробила?! — скрикнув Дем’ян.</p>

        <p>— Це не я! Це… це…</p>

        <p>— Володарка Вітру, — зрозумів Дем’ян. — Ти чуєш її голос?</p>

        <p>Яся кивнула і знову зосередилась на думках.</p>

        <p>
          «Це дитячі забавки, давай зробимо щось цікавіше. Підійми руку, — знову
          мовила вона в голові. — Підійди до вікна і поглянь у далечінь.»
        </p>

        <p>
          Дівчина знов послухалась, і на цей раз її рука напружилась. Вона
          закрутила спіраль у повітрі. Потім ще і ще — і раптом у шлунку разом
          похололо. На горизонті виднівся смерч. Яся на мить забула, як дихати.
          Вона відкрила рот і лише дивилась, як він наближався. Це все робила
          вона!
        </p>

        <p>
          Ні! Ні! — кричала свідомість. А жінка в голові сміялась. Яся хотіла це
          зупинити, хотіла зробити бодай щось, та тіло наче закам’яніло.
        </p>

        <p>
          Тоді сміх пані Вітер урвався, Яся знов змогла дихати, а рука змахнула
          вниз — і смерч упав додолу, несучись у їхній бік потоком снігу та
          вітру. Хвиля вдарилась об стіни будинку, а друзі сховалися під
          підвіконня. Приблизно за хвилину до кімнати відчинились двері та
          забіг дворецький.
        </p>

        <p>— Пані Ярославо, пане Арисовський, з вами все гаразд?</p>

        <p>Яся кивнула.</p>

        <p>
          — Справжній смерч у нашій місцевості! — він схопився за голову. — Вам
          потрібно в лікарню? Ви не поранені?
        </p>

        <p>— Ні, — відповіла дівчина.</p>

        <p>— Тоді я можу вам чимось допомогти?</p>

        <p>Яся глянула на черепки від розбитої кружки.</p>

        <p>— Покличте пані Олю. І нам би ще чаю.</p>

        <p>***</p>

        <p>
          Поступово минули ще два тижні. За цей час Яся навчилась сама, без
          голосу в голові, підіймати різні речі в повітря і переміщувати їх по
          будинку. Часом вона легеньким вітерцем задирала спідниці служницям і
          намагалася збити слуг, що несли підноси із сервізом.
        </p>

        <p>
          Також дівчина нарешті ввімкнула телефон і побачила цілу купу
          повідомлень від друзів. Як виявилось, Влад, Амелі та Марк теж
          слухались своїх голосів у голові. Через Марка до маєтку почали
          збігатися тварини. Мухи заполонили його кімнату, немов надворі стояв
          липень. Влад навчився підпалювати речі одним поглядом, Амелі
          продовжувала вдосконалювати набуті навички.
        </p>

        <p>
          Та попри це друзі розповіли, якої сили вони набирались у лісі, і як із
          кожним разом дивніше їх туди затягувало. Після від’їзду Ясі, за
          кілька днів, до Амелі в кімнату прийшло кілька домовичків. Вони
          випрошували її піти з ними, тож, розбудивши Марка і написавши Владові,
          трійця мусила піти до бібліотеки. У лісі в той день почав падати сніг.
          Тваринам було страшно, як і всій нечисті разом узятій. Стояла
          справжня паніка.
        </p>

        <p>
          Та попри все час ішов, а Яся залишалась такою ж слабкою, і змоги
          повернутись на ферму не було. Дівчина придумувала всі можливі варіанти
          втечі, проте вони були провальні: вона розуміла, що на пів дороги її
          перехоплять люди батьків.
        </p>

        <p>— От би можна було клацнути пальцями і опинитись у вас, — якось сказала Яся, коли всі п’ятеро говорили телефоном. Дем’ян сидів біля неї на ліжку.</p>

        <p>— Це було б чудово, але ми поняття не маємо як, — знизала плечима Амелі.</p>

        <p>— Можливо, варто ще трохи поритись у бібліотеці? — запропонував Марк.</p>

        <p>— Мені здається, ми вже все передивились, чесно, — відповіла Амелі. — У мене шкіра на пальцях почала стиратись від тих старезних фоліантів.</p>

        <p>
          Друзі вели запеклу дискусію, рішення потрібно було прийняти негайно, і
          раптом Влад похмуро вставив:
        </p>

        <p>— Є один варіант.</p>

        <p>Усі різко замовкли.</p>

        <p>— Ну то кажи! — крикнула Амелі.</p>

        <p>
          — Бабця казала, що просто до Міжгір’я не потрапиш, але можна
          опинитись у лісі через часову межу. Вона є в усіх предметах або
          явищах природи, якщо вони є ровесниками Синевиру. Проте ні в якому
          разі не молодші. Варто лише загадати місце перед тим, як її минути.
        </p>

        <p>Усі знову замовкли. Після довгої паузи Амелі поставила хлопцеві питання:</p>

        <p>— Як давно ти знав?</p>

        <p>— Що ти маєш на увазі?</p>

        <p>— Як давно ти, бляха, це знав?!</p>

        <p>
          Влад, мабуть, піджав, як завжди, губи; Яся крізь трубку відчула, яка
          важка тиша повисла в їхній кімнаті.
        </p>

        <p>— Після того, як вона поїхала. Ввечері бабця розповіла мені про цей метод.</p>

        <p>Яся почула, як Амелі гучно випустила повітря з ніздрів.</p>

        <p>— Я тебе зараз задушу, кретине, — і, схоже, кинулась у його бік. Щось гучно ляснуло, і далі заговорив Марк:</p>

        <p>— Не сваріться. Ви пам’ятаєте? Коли ми сваримось, ми не зможемо воз’єднатися і перемогти відьму.</p>

        <p>— Що там сталось? — спитала Яся.</p>

        <p>— Я встиг її зловити і не дати набити Владові пику, — пояснив Марк.</p>

        <p>
          — Як ми, в біса, воз’єднаємось, якщо біля нас немає четвертої стихії,
          га? — крикнула Амелі. — Ти паршивий козел! Як таким, бляха, можна
          бути?!
        </p>

        <p>
          — Взагалі, це не така вже й безпечна подорож. Краще ввімкни свої
          маленькі мізки і подумай, що з Ярославою може статись! Вона має
          виринути у водах Синевиру, але чи встигнемо ми її витягнути? Чи все
          буде з нею гаразд, враховуючи, яка зараз холодна вода і які істоти там
          водяться?
        </p>

        <p>У трубці знову повисла тиша.</p>

        <p>— Відпусти мене! — сказала Амелі і, схоже, вирвалась із хватки Марка. — Запхай свої виправдання собі до дупи, Владe. Ти збирався до весни чекати? Чи до літа? Часу обмаль — нам потрібен план. Що у Києві може бути найстарішою пам’яткою?</p>

        <p>— Софійський собор? — запропонував Марк.</p>

        <p>— Ні, — відповів Влад. — Бабця казала, що через постійні реставрації часова межа стерлась в усіх старих храмах.</p>

        <p>— Тоді що? Що ще такого старого є в Києві? — тиша… і знову обурене: — Кажи вже! Я по погляду бачу, що ти знаєш! Не тягни!</p>

        <p>І через дуже довгу хвилину Влад відповів:</p>

        <p>— Дніпро.</p>

        <p>— Твою ж наліво… — видихнув Марк.</p>

        <p>
          — Вона повинна не просто зайти у воду, а прив’язати до себе камінь і
          стрибнути там, де найглибше. Тоді її перенесе до Синевиру, якщо вона
          все правильно зробить. Гадаю, з Водяником і русалками можна буде
          домовитись про допомогу.
        </p>

        <p>— Єдина проблема — це…</p>

        <p>— Крижана вода, — закінчила Яся. — Я можу померти?</p>

        <p>— Від переохолодження — так. Але бабця сказала, що знає, як допомогти. Тому можна ризикнути.</p>

        <p>— Ви хоч уявляєте, наскільки це небезпечно? Ясю, ти не повинна на це йти, — сказала Амелі.</p>

        <p>— А хто щойно кричав, що у нас мало часу? — перекривив її Влад.</p>

        <p>— Ти хочеш втратити друга? Хочеш, щоб вона померла? Це ж самогубство!</p>

        <p>— Ні, якщо все зробити правильно. Часова межа перенесе її сюди.</p>

        <p>
          Вони далі почали сваритися, але Яся їх раптом різко перебила:
        </p>

        <p>— Амелі права — часу обмаль. Але і Влад має рацію: нам потрібно ризикнути. І я згодна піти на це.</p>
      </div>

        <div className="mt-8 flex justify-between text-lg">
