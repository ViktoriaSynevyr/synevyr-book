"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter11Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="11. Гості лісу">
        <div className="space-y-7">
        <p>
          Наступні дні минули сіро й дощовито. Міжгір’я оповила пелена дощу,
          мряки і туману. Барвисте листя, що встеляло стежки, змішалося з
          багнюкою, яка з’явилася з розталої землі, усі статуї з подвір’я
          позабирали, і єдиною прикрасою залишилися закурені гори.
        </p>

        <p>
          Влад не з’являвся аж до наступного тижня, а Яся і Амелі не бажали
          тратити час, щоб іти й питати в його бабці, де воно ділось. На
          вихідних Яся нарешті змогла зідзвонитись із Дем’яном. Вони довго
          говорили про те, що у них сталось за останній час, і під кінець
          Дем’ян, якого аж розпирало від радощів, повідомив:
        </p>

        <p>— Ми вибороли канікули!</p>

        <p>— Справді?</p>

        <p>
          — Так! Ти ще не знаєш? Вчителі погодились відпустити нас на тиждень.
        </p>

        <p>— Наступний?</p>

        <p>— Ні, через один; це буде передостанній тиждень листопада.</p>

        <p>— Чудово! Ти приїдеш?</p>

        <p>
          Його брови підскочили, і він посміхнувся.
          <br />— Ой, ну якщо ви не хочете…
        </p>

        <p>
          — Я скучила, чесно, — засміялась дівчина. — Мені тебе не вистачає. І я
          маю дещо тобі розповісти… — наступну годину вона переповідала йому
          все, що сталось за останній місяць, від чого (Яся була впевнена, хоч і
          не могла побачити) у Дем’яна повипадали очі.
        </p>

        <p>— Господи Ісусе! Ти покажеш мені бібліотеку?</p>

        <p>— Якщо бабця дозволить тобі жити в нашому крилі.</p>

        <p>
          — О, звісно, я забув, що тебе там у залізних рукавицях тримають. Наче
          «втекла від руки города», а у висновку — ні полів безкраїх, ні свободи,
          нічого, бляха.
        </p>

        <p>
          — Перестань, я й без того правила порушую, але є новина — я повернулась
          до верхової їзди.
        </p>

        <p>— Жартуєш?!</p>

        <p>— Ні.</p>

        <p>
          — Боже, нарешті! Скільки ти тренуєшся? Ми мусимо виїхати на прогулянку,
          як у старі добрі. Проїдемось із вітерцем і влаштуємо десь пікнік.
        </p>

        <p>Яся розсміялася.</p>

        <p>
          — Побачимо, мене можуть не відпустити, хто зна куди.
        </p>

        <p>
          Яся була впевнена, що Дем’ян у цей момент закотив очі.
          <br />— Я спробую побалакати з твоєю бабцею, вона сучасна?
        </p>

        <p>
          Яся знизала плечима:
          <br />— Я бачу її тільки коли їм або коли в кафе, ми майже не говоримо,
          та й вона мене неначе уникає.
        </p>

        <p>— Так от чому у тебе виходить усе це провертати.</p>

        <p>— Еге ж. Ну гаразд, мушу йти в кафе, ще зідзвонимось, люблю тебе і удачі в школі!</p>

        <p>— І я тебе, бувай.</p>

        <p>
          Яся вимкнула телефон і, накинувши хутряну кіптаринку, пішла на зміну.
          Вихідні пролетіли непомітно. У неділю дівчина ще раз почистила Вітра і
          спробувала його одягти. Спершу вона дала йому понюхати попону. Він
          дозволив її накинути. Далі йшла подушка — її кінь теж схвалив. Та коли
          прийшла черга сідла, він забрикався і почав бити задніми ногами, так,
          що подушка злетіла, а вальтрап з’їхав набік.
        </p>

        <p>
          — Окей, окей, я зрозуміла: на сідло в тебе червоний прапор, — Вітер
          гордовито фиркнув і відвернув голову. — Пробач, — вона погладила його
          по мордочці, — я залишу його тут, — вона повісила сідло на ослінчик
          коло стійла коня, — просто спробуй з ним принаймні познайомитись. Я
          розумію, що неприємно, але нам треба з тобою краще поладнати. Стати
          командою, бо їздити на тобі без сідла я трішки побоююсь.
        </p>

        <p>Вітер мотнув головою, наче це щось елементарне, і Яся зітхнула.</p>

        <p>— Чому саме я? — вона зазирнула йому в ліве око і відчула потяг теплого вітерцю. — Воля.</p>

        <p>Вона ще мить повагалась і тоді допетрала.</p>

        <p>
          — Ти відчуваєш її так? Вітер… Вона куйовдила тобі гриву під час галопу
          і дарувала відчуття польоту, чи не так?
        </p>

        <p>
          Кінь не зводив із Ясі свого великого блакитного ока, наче був
          зачарований. А потім заіржав і потерся об неї доброзичливо мордою,
          наче вони старі друзі, і у неї склався остаточний пазл — символ вітру
          в тій книженції, яку вони знайшли, — це кінь.
        </p>

        <p>— Ти кінь Володарки Вітру? — Вітер гордовито махнув головою, і у Ясі аж мурахи пройшлися тілом. Вона дала йому пару кубиків цукру і завела назад у стійло.</p>

        <p>
          — Солодких снів, Вітре, — і, притулившись до прутнів, додала: — нехай
          тобі сниться Вона.
        </p>

        <p>⸻</p>

        <p>
          З початком нового тижня з’явились новини. Влад нарешті прийшов і
          сказав, що вони не можуть йти без четвертого хлопця, якого досі не
          виявили. Яся закотила очі і, віднісши замовлення Марку, що читав
          «Буремний перевал», по дорозі назад кинула:
        </p>

        <p>
          — Треба хоч спробувати, вони казали привести тебе, можливо, ми
          зможемо почати тренуватись уже, бо я в душі не гребу, хто четвертий.
        </p>

        <p>
          Через годину трійця дійшла висновку, що вони підуть у ліс сьогодні
          вночі. Як тільки Яся звільниться, вони зустрічаються з Амелі, і вона
          пише Владові, коли підходити. Бажано напитись кави, щоб бути
          бадьорими, бо невідомо, наскільки вони там залишаться. Також потрібно
          бути пильними і точно розрахувати час. На цьому Влад підвівся і,
          кинувши гроші за сік разом із чайовими, пішов геть.
        </p>

        <p>— Він лишив чайові? — здивувалась і посміхнулась Амелі.</p>

        <p>— А може, він…</p>

        <p>— Ні! — заперечила Яся і хутко сховалась на кухні.</p>

        <p>
          Вони говорили з Амелі щодо кохання за легендою між Володаркою Вітру і
          Володарем Вогню. Між стихіями це кохання було, але не між Владом та
          Ясею. Стихії сиділи всередині них, та мозок працював окремо. Як і
          серце. А Яся до Влада відчувала відразу.
        </p>

        <p>
          Ну… вже не таку, як спочатку: спільна праця їх трохи об’єднала, але в
          неї не було до нього симпатії або, господи прости, кохання. Вони ж
          різні: Влад занадто гордий і пихатий, часом здається, він ладен
          перевершити містера Дарсі, проте останній принаймні не огризався при
          кожній фразі, коли спілкувався з Елізабет, а в цього язик наче той
          віник. Яся труснула головою, відганяючи думки, і повернулась до
          роботи.
        </p>

        <p>
          Ввечері, закінчивши тренування в манежі, вона розсідлала коня, на
          якому займалась, і виділила пів годинки Вітрові. Через дощ вона не
          могла випустити його погуляти, тому, закривши двері, Яся водила його
          за собою по конюшні, щоб він міг трішки розім’яти ноги. Йдучи десь
          третє коло, вона раптом зупинилась, і Вітер здивовано торкнувся
          мордою її руки.
        </p>

        <p>
          Яся поглянула на відро, що стояло коло сіна під одним із денників, і
          їй раптом прийшла в голову ідея. Одягнувши тільки вальтрап, вона
          поставила коло Вітра відро, на нього — ще одне, що знайшла в
          комірчині, після чого подивилась на коня. Вона торкнулась його шерсті
          і погладила довгу шию. Вітер споглядав за нею одним оком, повернувши
          назад голову.
        </p>

        <p>
          Тоді Яся стала однією ногою на відро і, піднявшись, сперлась на його
          спину. Вона поклала другу ногу і знову обережно погладила коня. Вітер
          був спокійний. Тоді Яся дала йому ще кубик цукру і, закинувши на його
          спину праву ногу, підсунувшись далі, опинилась зверху. Вітер не
          ворушився. Яся нахилилась уперед і поплескала його по шиї.
        </p>

        <p>— Ти молодець, тримай, — кінь отримав ще один кубик цукру, і Яся легенько вдарила його в боки п’ятами.</p>

        <p>
          Вітер зробив пару лінивих кроків. Він пройшовся в один кінець конюшні,
          розвернувся і пішов назад. За ними споглядало декілька десятків очей
          із денників; під пильними поглядами Вітер ішов спокійно, розмірно,
          порушуючи тишу цокотом копит. Дійшовши до відер, Яся нахилилась і
          попросила його зупинитись.
        </p>

        <p>
          Він зробив декілька зайвих кроків, але став, і Яся, зіскочивши, почала
          його розхвалювати та годувати смаколиками. Потім вона завела його в
          денник і, попрощавшись, прибралась і побігла в прохолодні сутінки на
          вечерю, а потім забігла до Амелі. Та написала Владові йти в маєток, і
          вони удвох побігли на гору, в кімнату Ясі, чекати хлопця.
        </p>

        <p>
          Перевдягнувшись, вони лежали на ліжку, і Амелі заговорювала Ясю, щоб та
          не заснула. Перед цим Амелі ходила в осінній сад залишити для Влада
          відчинені двері, але після дуже довгих хвилин очікувань підкрадалося
          сум’яття: він міг або заблукати, або попастись комусь на очі. Та
          врешті хлопець з’явився.
        </p>

        <p>
          Він постукав чотири рази (наперед домовлений код), і утрьох,
          запасшись ліхтариками, вони пішли на гору. Опинившись у бібліотеці,
          діти, не вмикаючи світло, одразу пішли в бік останньої кімнати.
          Промені світла ковзали по стелажах і підлозі; друзі намагались бути
          уважними, споглядати кожен рух і звук, щоб, якщо щось почнеться, бути
          готовими… Їхні ліхтарики час від часу всі три сплітались в одній
          точці, до якої вони йшли. Неначе нагадування, що ще все попереду. У
          Ясі тремтіли руки, а тілом ходили сироти. Ой, що буде, якщо їх
          злапають…
        </p>

        <p>
          Так, у роздумах, вона й не помітила, як вони опинились коло останньої
          арки.
        </p>

        <p>— Стійте, — сказав він. Дівчата зупинились, і Яся відчула, як у неї до горла підкочується ком роздратування. — Погляньте, — сказав він, і тільки зараз обидві побачили напівпрозору стінку, перед якою зупинились.</p>

        <p>
          Вона звивалася, неначе дихала, наче це була величезна стіна води, яка
          відгороджувала другу кімнату.
        </p>

        <p>— Часовий бар’єр, — сказала Амелі.</p>

        <p>
          Влад кивнув і, простягнувши пальці, торкнувся стіни. Пальці пройшли
          крізь, і, запхавши руку, хлопець проковзнув далі плечем і рештою тіла.
          Він зник з іншого боку; раптом стало зрозуміло, що стінка показує лиш
          ілюзію того, що зазвичай люди бачать удень. Недовго думаючи, Яся пішла
          слідом, а за нею Амелі — і вони опинились у тій же кімнаті, тільки
          вона була неначе поглинута іншим світом.
        </p>

        <p>
          З прольоту між сходами, що вели вниз, йшло зелене сяйво, яке
          заповнювало всю кімнату. Тут і там літали метелики, життя неначе
          зупинилось у повітрі.
        </p>

        <p>
          Вони захоплено споглядали це. Один із блакитних метеликів сів Амелі на
          палець. Яся бачила, як у неї перехопило подих, та раптом метелик у
          мить почорнів, а потім перетворився на попіл.
        </p>

        <p>— Що це… було? — очманіло видушила Амелі.</p>

        <p>
          — Часова межа, дура, — сказав Влад. — Цей метелик існував у лісі 300
          років тому, тому, звісно, «сівши на машину часу», він зістарився і
          перетворився на те, чим у теорії зараз і є.
        </p>

        <p>— А не можна було це ввічливіше пояснити? Хіба ж я тебе обзиваю? — обурилась дівчина.</p>

        <p>
          На що хлопець лиш розвернувся і пішов сходами вниз. Дівчата
          перезирнулися, потисли плечима і пішли слідом.
        </p>

        <p>
          Сяйво охопило дітей, і вони знову опинились у бібліотеці, але не тій,
          що на горі. Ця знаходилась у лісі: землю вкривало різнокольорове
          листя, а стелажі і книги були обплетені ліанами та мохом із квітами.
        </p>

        <p>
          Поблукавши трішки, вони зрозуміли, що не можуть знайти галявину, через
          що Влад почав сердитись, Амелі — боротись із його злими викидами, а
          Яся — тримати себе в руках, щоб не зарядити Владу по пиці. Врешті
          знайшовши якусь лавку серед стелажів, Яся на неї плюхнулась і потерла
          очі. Вона була надзвичайно втомлена, а тут ще й ця маячня. Їй
          страшенно хотілось спати, схоже кава геть не допомогла. Та з цим усім
          потрібно розібратись, можливо, ще один ковток допоможе збадьоритися…
          Вона розкрутила термос, який приніс хлопець, і, наливши в кришку
          добрячу порцію, почала пити, поки Амелі намагалась вгамувати Влада.
        </p>

        <p>— Чому ти так нервуєш?</p>

        <p>
          — Це була погана ідея, я мав спитати в бабці детальніше, як сюди
          дістатись, а ти, бляха, навіть не постаралась запам’ятати з минулого
          разу, куди йшла.
        </p>

        <p>— Ну вибач, що в мене не компас у голові, але раз ти такий розумний, чому ж сам дороги знайти не можеш?</p>

        <p>
          І тут все сталось за секунду — так, що Амелі відкинуло на два метри, а
          Яся поперхнулась гарячою кавою.
        </p>

        <p>
          Очі Влада спалахнули блакитним полум’ям, каштанове волосся стало
          дибки, і, підіймаючись угору, він розпалив навколо себе вогняне
          кільце.
        </p>

        <p>
          Його голос долинав неначе з потойбіччя:
          <br />— Як ти смієш, смертна, так зі мною розмовляти?
        </p>

        <p>
          Амелі, перелякана, завмерла неначе вкопана від шоку. Яся відклала
          кришку з кавою і підвелась, щоб якось допомогти, та її раптом
          зупинив знайомий голос.
        </p>

        <p>
          — Я бачу, нахабності тобі не займати, — з-за стелажу вийшла сліпа
          мавка, її вели дві інші. — Отак ти, Володарю Вогню, хочеш повернутись?
          Де твоя ввічливість? Ти геть страх загубив?
        </p>

        <p>— Мовчи, інакше прокляну!</p>

        <p>
          — Ох ні, на цей раз я підготувалась, — відповіла вона, і раптом до вух
          усіх долинув чарівний спів.
        </p>

        <p>
          «Через роки і літа,
          <br />
          повернулись ви:
          <br />
          Чотири могутні стихії,
          <br />
          Володарі землі.
          <br />
          Зачарований один
          <br />
          нашою красою,
          <br />
          Друга любить нас усіх
          <br />
          і дає нам волю,
          <br />
          Третя нас рятує в спеку,
          <br />
          на собі катає,
          <br />
          А четвертий — наш володар,
          <br />
          все про звірів знає.
          <br />
          Тож візьміться, друзі наші,
          <br />
          сплетіть ваші руки,
          <br />
          бо чекали ми на вас
          <br />
          стільки років, друзі.
          <br />
          Та прийде вже ваша черга
          <br />
          світ цей визволяти,
          <br />
          бо єдині ви на світі,
          <br />
          хто є на це здатен.»
        </p>

        <p>
          Влад заціпенів. Він почав стрімко падати, і Яся з Амелі вчасно
          підбігли його підхопити. Пісня стихла, а хлопець прийшов до тями. Він,
          наче загнаний звір, поглянув на мавку.
        </p>

        <p>— Вітаю, Володарю Вогню, — сказала вона.</p>

        <p>— Вітаю, — видавив він.</p>

        <p>
          Трійцю раптом з усіх боків оточили маленькі чоловічки і почали їм
          допомагати встати. Це були домовички.
        </p>

        <p>
          — Піднімайтесь, пані, ну що ви, замаститесь же! — сказав один із них
          Ясі.
        </p>

        <p>
          Вона почула голоси дітей, що жваво сміялись, і підняла голову.
          <br />
          Напівпрозорі, в білих нічних сорочках, до них підлетіли і почали
          роздивлятись маленькі хлопчики. Вони були неначе маленькі янголята —
          купідони. Тільки якісь химерні і змарнілі.
        </p>

        <p>— Точно такі ж, як на вході в маєток бабці, — прошепотіла Яся.</p>

        <p>— Це вони і є, — пробубнів Влад, обтрушуючи джинси.</p>

        <p>
          — Потерчата, — підтвердила мавка, — душі нехрещених дітей, що
          передчасно померли. Ну що ж, любі гості, ходімо, я вас проведу до
          решти.
        </p>

        <p>— До решти? — спитала пошепки Амелі, дивлячись на Ясю, але та лиш потисла плечима і пішла вслід за мавками.</p>

        <p>
          Весь шлях йшли мовчки. Кожен думав про своє, згадуючи те, що сталось.
          Влад намагався зрозуміти, чому його у власному тілі раптом хтось
          витіснув; Амелі все прокручувала в голові страшний образ хлопця, що
          раптом спалахнув вогнем; а Яся дивувалась потерчатам і згадала, що
          забула на лавці термос із кавою, але повертатись і всіх затримувати не
          хотілось. Їхні думки раптом перервала мавка.
        </p>

        <p>
          — Добре, що ви прийшли вночі, — вони вже вийшли на галявину і,
          минувши арку, пішли далі, до гущі дерев. — Уночі бар’єр особливо
          сильний і показує те, що зацікавлене око не може побачити вдень.
          Володар Вогню посунув Влада в цей момент тому, що вперше за 15 років
          опинився знову вдома. Він відчув це і, скориставшись ситуацією,
          підпалив думки Влада, щоб той буквально спалахнув, наче сірник,
          давши йому волю. А ми вже, до речі, на місці, — вона спинилась, і
          трійця позаду неї теж. Вони здивовано витріщилися на дерева і ліс, що
          йшов далі.
        </p>

        <p>
          — Перепрошую, — почала невпевнено Яся, — але куди ми прийшли?
        </p>

        <p>
          — Часова межа, — пояснила сліпа мавка і зробила жест рукою, після чого
          решта мавок побігли стрімко вперед і десь за 30 метрів від друзів
          зникли, минувши щось невидиме.
        </p>

        <p>
          Лиш звук булькання води пояснював, що щось відбувається. Бульк! Бульк!
          І раптом, придивившись, Яся побачила, про що говорила мавка. Це був
          бар’єр — стіна на вигляд наче дзеркало, та варто доторкнутись — і вона
          йшла колами, наче вода в озері.
        </p>

        <p>
          Останніх мавок проковтнула межа, і залишились тільки вони утрьох та
          сліпа мавка Стефанія.
        </p>

        <p>
          — Не бійтеся, любі діти: якщо вас прийняла бібліотека і ліс, часова
          межа нічого вам не зробить.
        </p>

        <p>— А нас міг не прийняти той лабіринт зі стелажів? — спитала Амелі.</p>

        <p>
          Стефанія мовчала кілька довгих секунд, після чого пояснила стишеним
          голосом:
        </p>

        <p>
          — То ви не знали. Стара Агата навіть не додумалась вас попередити.
          Часова межа на горі — це квіточки. Вона для тих, хто не вірить у
          магію. Але ж є ті, хто вірять, проте їм не варто бачити наш світ.
          Гадаю, ви розумієте, про що я. Якби людина, що не належить до нашого
          світу, потрапила б сюди, вибралась живою і потім змогла б когось ще
          привести — ви уявляєте, що б почалось? — не отримавши відповіді від
          дітей, вона продовжила: — Ви не уявляєте, що живе в тій бібліотеці, і,
          можливо, вам знати не потрібно, — заключила вона і мовила вже більш
          спокійно, м’яко: — гаразд, нам час іти, вперед, — і мавка
          покрокувала до бар’єра, а за мить її з’їла гладь води, залишивши лиш
          кола, що пішли до крон дерев і могутніх стовбурів.
        </p>

        <p>
          Першою зробила крок Яся: вона спочатку торкнулась і відчула, як її
          пальці огортає щось желейне та прохолодне, пішла далі — спочатку
          захопило руку, потім усе тіло. Вона опинилась у закрученому
          блакитному і холодному місці, гравітація втратилась, вона пробула в
          якомусь блакитному небутті, у колах, декілька секунд, а потім її
          викинуло просто на якусь галявину.
        </p>

        <p>
          Дівчина скривилась від болю в плечі й перевернувшись на спину,
          побачила голубе небо, вкрите білими пухнастими хмарами; здавалось,
          ніби вони от-от торкнуться кінцівок дерев. Тоді Яся швидко
          перевернулась і озирнулась: вона знаходилась на неймовірних розмірах
          галявині, посеред якої, приблизно за 100 метрів від неї,
          розташовувалось величезне озеро Синевир. Галявину оточували високі
          дерева, а за лісом, у далині, за кілька десятків кілометрів, височіли
          гірські масиви Горгани.
        </p>

        <p>
          Раптом тишу розрізав крик — це на галявину коло Ясі впав Влад, а потім
          коло нього — Амелі.
        </p>

        <p>
          — Вона почала битись! — кричав він. — А потім вона мене штовхнула! Ця
          сук…
        </p>

        <p>
          — Ви вже тут, — перебила його Стефанія. — Чудово. Ходім, я все покажу.
          <br />— Нічого собі, — сказала Амелі.
        </p>

        <p>— Що таке? — спитала Яся.</p>

        <p>
          — Озеро — це дивовижно; нас, мабуть, відкинуло ще років на 200—300,
          адже в нашому часі тут все обставлено бруківкою, побудовані альтанки,
          плавають човники і ціла купа туристів.
        </p>

        <p>
          Яся поглянула на озеро ще раз і враз відчула, як кістками пройшовся
          холодок і слабкість. Подорож у часі на 300 років назад — це не так уже
          й легко, як здається. Амелі, схоже, теж ледве на ногах трималась, а
          Влад зблід.
        </p>

        <p>
          — Випийте, — нізвідки раптом з’явилась одна з мавок, простягаючи їм
          горнятко з водою, — Синевир допоможе відновити сили.
        </p>

        <p>
          Яся взяла горнятко і подякувала. Мавка вклонилась і пішла геть. Утрьох
          вони зробили по ковтку і потроху почали приходити до тями,
          роззираючись дивовижжю, в яку потрапили.
        </p>

        <p>
          Вони пішли назустріч Синевиру. Їхню увагу прикувала неймовірна
          картина: з правого краю озера, до якого вони прямували, якийсь
          чоловічок із зеленою борідкою, трикутними вушками та тілом, вкритим
          лускою, прямо на воді тримав свою чашку і час від часу щось із неї
          попивав, розмовляючи з трьома русалками, що, обіпершись на гілля
          дерев, яке впадало в озеро, захоплено його слухали. Вони були
          надзвичайно вродливі; їхнє довге волосся (в когось кучеряве, в когось
          пряме, різних кольорів) спадало і прикривало їм груди аж до пояса, а,
          поглянувши нижче, можна було побачити їхні ребра та кістляві хвости.
        </p>

        <p>
          — Звабниці, — сказала зневажливо мавка, помітивши, на що задивились
          діти. — У свій час вони заманювали красою юнаків і топили, потім
          з’їдаючи. Як то кажуть — краса тільки на поверхні.
        </p>

        <p>
          Побачивши трійцю, чоловічок раптом здивовано підскочив і поплив до
          них; от у нього хвіст був зелений, вкритий лускою.
        </p>

        <p>
          — Вітаю, любі друзі! Як ваші справи? Довго ж ми вас чекали!
        </p>

        <p>
          — Водянику, раз ти вже тут, хочу представити тобі наших гостів: це
          Ярослава — в ній наша Вітер сидить; Влада ти мав би знати через Агату
          — наш Володар Вогню; і, нарешті, Амелі — в ній сидить Володарка вод
          наших.
        </p>

        <p>
          Пан Водяник затремтів, коли Стефанія представила Амелі, і вклонився.
        </p>

        <p>
          — Яка честь, пані, ви повернулись, моя королево! Дозвольте, — він узяв
          руку Амелі і поцілував. — Без вас було надзвичайно тяжко, ми усі
          сумували за вами та нарешті раді вітати вас тут! Гадаю, ви матимете
          нагоду з вітерцем пролетітись каналами аж до Дніпра, як у старі часи?
          — він підморгнув, а Амелі не приховала здивування.
        </p>

        <p>
          — Звісно! Як тільки випаде нагода і я зможу дихати під водою.
        </p>

        <p>
          Пан Водяник здивувався, а мавка засміялась.
        </p>

        <p>
          — Це ще буквально проста дівчина, Водянику; Володарка вкрай зла поки
          що, і вони одна одній не розкрились, — похитала головою вона. — Тим
          більше, я так розумію, що Володаря Лісу досі нема.
        </p>

        <p>— Нема-нема, пані, — підтвердив Водяник.</p>

        <p>— Ви його не знайшли? — звернулась вона до трійці.</p>

        <p>— Поки ні, — відповіла Яся, — але, можливо, у нас щось вийде без нього?</p>

        <p>Мавка похитала головою.</p>

        <p>
          — Навряд чи. Та я б хотіла, щоб ви принаймні спробували. Дуже важливо,
          щоб ви об’єднались, інакше на шляху Відьми ви будете легкою
          перешкодою.
        </p>

        <p>
          Трійця кивнула, а Яся раптом роззявила рота і підняла голову догори.
          Земля затрусилась — це привернуло увагу і решти: на рівні дерев
          крокував велетень. Він був увесь із дерева, порослий мохом, з нього
          стирчало купа гілок, його облітала величезна кількість різних ліан,
          листя та живностей. Зараз, мабуть через осінь, на ньому вони були
          пожовклі, а ті, що відпадали, збирались позаду в шлейф і тягнулись у
          повітрі слідом. Із самих вух у нього стирчали довгі закручені гілляки,
          очі сяяли зеленим полум’ям, і аж до пояса тяглась довга листяна
          борода.
        </p>

        <p>— Батьку, вітаю! — скрикнула мавка.</p>

        <p>
          — Вітаю, дитя моє, — пролунало глибоке низьке відлуння. — Це три наші
          Володарі?
        </p>

        <p>— Так, батьку.</p>

        <p>— Де ж четвертий — друг мій та побратим?</p>

        <p>— Досі не знайшли.</p>

        <p>— Нічого, скоро знайдуть. Дай їм підказку, як будуть іти, — сказав він і покрокував далі.</p>

        <p>
          Усі прислухались до його кроків, від яких здригався весь ліс. Над
          деревами з переляку розлітались птахи.
        </p>

        <p>
          — У нас доволі мало часу, — першою отямилась Амелі. — Ми мусимо
          повернутись до світанку.
        </p>

        <p>
          — Тоді хутко сідайте в коло, — сказала мавка.
        </p>

        <p>
          Вони здивовано перезирнулися, але вона їх нагнала:
          <br />— Давайте, мерщій!
        </p>

        <p>
          Сівши в позу лотоса, кожен із питанням поглянув на сліпу мавку.
        </p>

        <p>— Вони сіли? — спитала вона свою помічницю.</p>

        <p>— Так.</p>

        <p>— Нехай візьмуться за руки.</p>

        <p>— Що?! — скрикнули усі разом.</p>

        <p>— Так потрібно, — пояснила Стефанія.</p>

        <p>
          Усі троє перезирнулись. Ніхто не хотів брати за руку Влада, але,
          схоже, вибору немає.
        </p>

        <p>
          Зліва Яся відчула тендітну долоню Амелі, а справа — суху і доволі
          більшу долоню Влада. Та замість ненависті вона відчула, як у животі
          запурхали метелики, і її організмом пройшовся струм.
        </p>

        <p>
          — Чудово, ви вже в процесі, — сказала мавка, поки їй на вухо нашіптувала
          щось друга.
        </p>

        <p>— Тобто? — здивувалась Яся і поглянула на Амелі, в якої очі світилися блакитним.</p>

        <p>— У тебе очі світяться сірим сяйвом, — відповіла та.</p>

        <p>
          Яся ще ніколи не відчувала того, що пережили Влад і Амелі. Її внутрішня
          Володарка ще ніколи не витісняла її зсередини. Але чому ж?
        </p>

        <p>
          — Зосередьтесь кожен на собі і один на одному, — почала казати мавка.
          — Згадуйте як хороші, так і погані пережиті моменти, відчуйте і
          переживіть кожною клітиною.
        </p>

        <p>
          Яся зосередилась на Ані. Згадала, як вони дивились фільми, як гуляли,
          веселились, проводили разом вечори — і раптом у голові спалахнула та
          страшна ніч: політ автівки, страшні крики і далі — лікарня.
        </p>

        <p>
          Яся відчула, як відірвалась від землі; вона привідкрила око і побачила,
          що Амелі з Владом теж над землею. Їх трішки розтягнуло і повільно
          закрутило по колу. Влад випромінював червоно-оранжеве сяйво, Амелі —
          блакитне. Яся відчувала, як її закручує якесь сіре світло з буревієм.
          Вона закрила очі і ще пильніше зосередилась.
        </p>

        <p>
          Далі — депресія більшу частину літа, школа, Дем’ян, що її підтримує,
          далі — переїзд сюди, знайомство з Амелі, і раптом вона згадує
          знайомство з Владом. Кожний момент — і пізніше кожне в’їдливе слово,
          кожне приниження. Її затрусило, вона захотіла вирвати руку з долоні
          Влада, тоді відкривши очі, вона побачила його лютий погляд, потім
          поглянула на Амелі. Вони обидві дивились на нього з палкою ненавистю,
          і коли вже Яся хотіла на нього кинутись, коло раптом розірвалось, і
          вони троє впали на землю, боляче вдарившись дупами. Люта ненависть
          зникла, і Яся потерла голову.
        </p>

        <p>— Що це було? — спитала вона.</p>

        <p>— Ви що, геть не ладнаєте? — спитала мавка.</p>

        <p>
          Трійця переглянулась, і мавка похитала головою, все зрозумівши.
        </p>

        <p>
          — Тоді не дивно, чому ви дві раптом захотіли йому горлянку розірвати.
          Вам потрібно попрацювати над вашими відносинами, розповісти найбільш
          травмуючі таємниці одне одному. Ви що, не читали книжку?
        </p>

        <p>
          Амелі раптом згадала дещо і, потягнувшись по рюкзак, відкрила його і
          дістала величезний фоліант.
        </p>

        <p>
          Дівчина простягнула його мавці; остання раптом зблідла і торкнулась
          його. Потримавши трішки, погладивши обкладинку, вона розплакалась.
        </p>

        <p>
          — Наша історія, наша надія, єдині наші спогади… Дякуємо вам велике.
        </p>

        <p>— Ми прочитали все, але не взяли до уваги, — пояснила Амелі.</p>

        <p>
          Мокрі доріжки, що бігли по щоках мавки, залишили на її шкірі опіки.
        </p>

        <p>
          — Вибачте, — вона втерла очі, — ми — нечиста сила; від будь-чого
          щирого і живого ми отримуємо рани, — вона підвелась. — Йдіть і
          знайдіть Володаря Лісу: пам’ятайте, він прибув 20 жовтня 2020 року за
          вашим літочисленням. І поладнайте усі, тоді знову прийдете. Ми вас
          зустрінемо… Удачі.
        </p>

        <p>
          — Лукреціє, проведи їх, — сказала вона одній зі своїх помічниць, і та,
          кивнувши, пішла виконувати прохання. Трійця, вкрай побита та
          змучена, пішла назад до бар’єра. Мавка йшла попереду. Її довге чорне
          волосся трішки впало набік, і усі троє змогли побачити органи мертвої
          дівчини, що коливалися під час її руху.
        </p>

        <p>
          Яся заціпеніла, Амелі ледь не знудило, навіть Влад — замість того, щоб,
          як завжди, бути набурмосеним і щось бубоніти під ніс — трохи зблід.
          Тоді Яся згадала, що є два види: мавки та нявки, і якраз у других видно
          органи на спині, а ще вони надзвичайно небезпечні. Але, не завдавши
          жодної шкоди, Лукреція провела їх до виходу з бібліотеки і там, не
          мовивши ні слова, зникла, а діти піднялись на гору.
        </p>

        <p>
          Потрапивши назад у свій час, вони відчули себе ще більш втомленими. У
          Ясі почорніло в очах, а тілом пройшовся струм: вона відчула різкий
          прилив енергії — ніби помолодшала на 300 років, — а потім титанічну
          втому.
        </p>

        <p>
          Амелі поглянула на годинник — була 3-тя ночі. Спустившись, вони
          попрощались із Ясею, що пішла в свою кімнату і, закутавшись в одіяло,
          заснула міцним сном. Амелі рушила в номер, не сказавши ні слова
          Владові, а хлопець тим самим шляхом, не звертаючи уваги на вовкулак,
          що ховались маленьким садочком, і щезника, що бігав між деревами,
          дійшов до таємних дверей під парканом. Не замикаючи їх на ключ, під
          світлом місяця пішов дорогою до химерного будинку посеред поля, де
          прямо в трьох великих старих вікнах, що дивилися на нього, миготів
          маленький вогник від свічки. Його чекали.
        </p>
      </div>

        <div className="mt-8 flex justify-between text-lg">
          <Link
            href={`/${lang}/reading/chapters/10`}
            className="underline"
          >
            ← Попередній
          </Link>

          <Link
            href={`/${lang}/reading/chapters/12`}
            className="underline"
          >
            Наступний →
          </Link>
        </div>
      </BookPage>
    </main>
  );
}
