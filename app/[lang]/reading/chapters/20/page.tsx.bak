"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter20Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="20. Подорож між Дніпром та Синевиром">
        <div className="space-y-7">
        <p>
          Через годину дискусій, всі (навіть Амелі) погодились спробувати
          ризикнути. Влад ще раз спитав бабцю, чи точно варто це робити, і
          уточнив деталі, які Яся занотувала і перечитала з десяток разів, поки
          не вивчила напамʼять. Через кілька днів, налаштувавшись і зібравши все
          необхідне, Яся і Демʼян поїхали в центр міста «погуляти». Впевнившись,
          що за ними ніхто не слідкує з людей батьків, вони пішли на Міст Метро.
          На верхньому ярусі, гучно тарабанячи, проїхав потяг, і Яся здригнулася.
          Вони йшли по пішохідній зоні на нижньому ярусі, поки величезною
          автострадою їх минали машини.
        </p>

        <p>
          Друзі спостерігали чудовий краєвид, хоч доволі й сірий у цей час: на
          правому березі Києва виднілись Лавра, Батьківщина-матір та парки, що
          були голі й понурі. З лівого берега можна було побачити новобудови та
          новітню інфраструктуру, що дуже контрастувало і створювало враження,
          ніби міст ділить теперішнє і минуле.
        </p>

        <p>
          Яся спинилась. Вона вирішила, що це варто зробити тут, і підійшла до
          перил, поглянувши вниз, де за 30 метрів повільно коливались води
          Дніпра. Дівчина видихнула з рота білу пару. Де-не-де плавали невеликі
          острівки льоду.
        </p>

        <p>
          Яся з Демʼяном були єдині на мості, тому їм ніхто не заважатиме. Тихо
          послідувавши прикладу дівчини, хлопець теж сперся збоку на перила і
          поглянув вниз. У Ясі у вухах зашуміло. Вона все думала і думала,
          наскільки ж холодна вода і як довго вона зможе протягнути. Рюкзак
          давив на плечі вагою двох цеглин.
        </p>

        <p>— Ти ж знаєш, що ти не зобовʼязана? — мовив дуже спокійним голосом хлопець. — Ми можемо взяти у мене одну з машин і поїхати…</p>

        <p>— Нас злапають, якщо не на виїзді з Києва, то упродовж пʼяти годин — точно, — перебила його Яся.</p>

        <p>— А якщо ти втопишся?</p>

        <p>
          — Є шанс, що ні, — вона скривилась і залізла рукою під куртку почухати
          мітку, що нестерпно пекла останні кілька годин.
        </p>

        <p>— Ти ж знаєш, що тільки гірше робиш… — дорікнув він.</p>

        <p>
          Яся поглянула на нього поглядом «відчепись», і Демʼян кивнув.
        </p>

        <p>
          Вони стояли так мовчки декілька хвилин, врешті тишу порушив Демʼян.
        </p>

        <p>— Він мені відмовив, — видихнув хлопець. — Марк… він не такий, як я думав. Йому подобається Амелі, але він для неї неначе ще один плюс магніту, що відштовхується. Вона його не помічає.</p>

        <p>
          У Ясі всередині аж усе тьохнуло. Скільки на цього хлопця всього
          звалилось. Спочатку його вбили, потім воскресили, а потім він відчув
          невзаємну симпатію. Дівчина торкнулась його руки, він не хотів
          поглянути їй в очі, а вона не знала, що сказати — їй було так боляче
          за нього.
        </p>

        <p>— Мені шкода, — мовила вона. — Ти чудова людина, Марк теж, але він тебе не вартий. Ти ще знайдеш своє щастя.</p>

        <p>
          Через кілька довгих секунд він перевернув долоню і взяв її теж за
          руку, вдячно стискаючи, і Яся зрозуміла, що все гаразд — він просто
          хотів цим поділитись. Демʼян все дивився кудись вдалечінь, з його рота
          йшла пара, а теплі руки хлопця зігрівали холодні пальці Ясі. В повітрі
          стояла напружена тиша. Врешті хлопець заговорив знову:
        </p>

        <p>— Ясю, я не хочу тебе втрачати… — його обличчя було непроникне, проте очі видавали невимовний сум.</p>

        <p>
          Це на нього так не схоже… Яся задумалась: колишній Демʼян уже би
          відмовляв її і, скоріш за все, плакав від паніки.
        </p>

        <p>— У мене є шанс на успіх, — твердо мовила вона. — Навіть якщо нічого не вийде, я скину рюкзак і випливу нагору.</p>

        <p>— І захворієш на гнійну ангіну, а потім помреш від неї.</p>

        <p>
          Від цих слів у дівчини пішли мурашки шкірою. Яся торкнулась руки
          хлопця, він спокійно стис її у відповідь, а потім вона його обійняла.
          Демʼян пригорнув Ясю до себе, і вони ще довго так стояли. Мороз щипав
          щоки і руки, але друзі продовжували вперто стояти, ніби прощаючись.
        </p>

        <p>— Я мушу. Демʼяне, я дуже сильно тебе люблю — памʼятай про це. І хочу подякувати тобі за все, що ти для мене зробив. Ти найкращий друг у світі. Ти найкраща людина у цьому світі. І якщо хтось посміє сказати протилежне, то згадай мене і дай їм смачно по писку.</p>

        <p>
          Він не відповідав, тоді Яся підняла голову, щоб поглянути йому в
          обличчя, і побачила ніщо інше, як слабку усмішку. Демʼян не посміхався
          відтоді, як Яся його оживила, тому тілом розлилося тепло, знищуючи
          страх перед холодною водою і майбутнім, що її чекало. Дівчина
          відсторонилася і зняла шапку, потім куртку та шарф, віддала все
          Демʼяну і знову одягла рюкзак. Вона витерла шар снігу з перил,
          схопилась за них і перелізла на другий бік — холодний вітер роздмухував
          її волосся. Яся востаннє поглянула другу в очі. На мить вона забула як
          дихати, від висоти крутилась голова та вона струснула міцніше перила і
          твердо вирішила, що робити.
        </p>

        <p>— Бувай, — сказала вона і відпустила перила, стрімко падаючи вниз.</p>

        <p>
          В голові все закрутилось, а душу знову скував невимовний страх. Навіщо
          вона це зробила? Проте було пізно. Коли стрибаєш з висоти в 30 метрів,
          на мить перед очима проноситься усе життя. Яся відчула, як вітер
          обійняв її, і вона розпростерла руки назустріч. Вона летіла,
          розсікаючи повітря і здригаючись від холоду, довгу хвилину, із
          завмерлим серцем.
        </p>

        <p>
          Ще мить — і тіло боляче вдарилось об крижану воду, а рюкзак почав
          стрімко тягнути її на дно. Тіло пронизало сотні гострих лез, а сіре
          світло Києва почало зникати, поки темрява стрімко огортала Ясю з усіх
          боків. Паніка захлистнула з головою, крижаний холод пронизав до
          кісток, аж голова загуділа. І в цей момент, коли так нічого і не
          відбулось, вона пожаліла про цей вчинок.
        </p>

        <p>
          Ясі було холодно. Настільки нестерпно, що голова неначе ладна була
          вибухнути від цього болю, а тіло відмовлялось слухатись від
          задубіння. Яся плакала. Отак вона і загине? Але голос у голові знову
          заговорив і змусив дівчину задуматись.
        </p>

        <p>«Зосередься, згадай, куди тобі потрібно».</p>

        <p>
          Яся послухалась. Від паніки та адреналіну, вона відокремила частинку
          важливих і цінних спогадів у своїй голові. Яся подумала про друзів,
          ліс і Синевир, згадала погляди Влада, як він намагався торкнутись її
          випадково. Вона згадала, як малювала з Амелі в її кімнаті, як вони
          їли цукерки, — і її огорнула така легкість і сум за цим простим часом.
          Поки спогади проносились у свідомості, вона заплющила очі і скинула
          рюкзак. Хотілось додому…
        </p>

        <p>
          Легені почало нестерпно пекти. Вона в паніці почала гребти руками, але
          сили швидко закінчувались, а верх був надзвичайно далеко, і коли Яся
          відкрила рот, щоб вдихнути, — захлинулась водою. Її душило, вона
          схопилась за горло в паніці, але свідомість почала залишати її тіло.
        </p>

        <p>«Ти не загинеш, ще трішки», — сказала пані Вітер.</p>

        <p>
          Тоді Ясю почала огортати темрява, і вона знову перекотилася з мозку
          кудись у груди. Легені більше не пекли, тіло розслабилось, і останній
          яскравий теплий спогад про дім пронісся у неї в голові. Крижана вода
          раптом змінилась на теплішу, ледь не літню. Далі відчуття тіла
          зникло.
        </p>

        <p>
          Володарка Вітру розплющила очі, і Яся побачила, що вода навколо набула
          зеленого кольору, а денне світло торкалося дна.
        </p>

        <p>— Ми вдома, — сказала радісно Вітер і стрімко попливла наверх.</p>

        <p>
          А Ясю всередині огорнуло полегшення. Вона не загинула. Все вийшло.
        </p>

        <p>Пані Вітер стрімко рухалась, наближаючись до поверхні, але її увагу різко привернуло щось чорне десь за 50 метрів від неї. Придивившись, вона зрозуміла, що це величезний кокон.</p>

        <p>— Що це? — поцікавилась пані Вітер. — Давай поглянемо ближче, — додала вона і попливла в бік кокона.</p>

        <p>
          І хто ж там може бути? Вона почала плисти навколо — нічого. Тоді
          стихія торкнулась кокона рукою, і він засяяв, перетворившись на
          напівпрозорий. І тут у Ясі аж подих перехопило — всередині була
          людина, і схоже, що це жінка.
        </p>

        <p>— Ой лишенько… — сказала пані Вітер. — Нам потрібно тікати!</p>

        <p>«Чому?» — спитала Яся. — «Її потрібно врятувати!»</p>

        <p>
          — Ярославо, ти не розумієш, це не людина, в її душі не залишилось ні
          любові, ні співчуття… — пояснила Володарка, поки кокон повільно
          крутився навколо, і коли поступово показалось обличчя, Яся зрозуміла
          чому.
        </p>

        <p>
          Це була дуже гарна жінка. Чорне волосся огортало її прекрасне обличчя
          з гострими рисами. Довгий ніс, великі очі та суцільна лінія звичайних
          губ. На ній була довга чорна сукня, що накривала ступні. Проте це все
          псувала сіра трупна шкіра. Це було настільки негармонійно, що просто
          лякало.
        </p>

        <p>
          Та раптом жінка розплющила очі, і душа Ясі затрусилась уся від страху.
          Очі жінки спалахнули химерним жовтим кольором хижака, що полює за
          здобиччю, і, спрямувавши свій погляд на дівчину, вона лихо
          посміхнулась, а потім її гостре підборіддя із носом видовжились разом
          із руками, ногами та навіть пальцями на руках, що перейшли у довгі
          жовті пазурі, наче в орла.
        </p>

        <p>
          Вона підняла свою праву руку і постукала довгим кігтем по кокону, а
          потім з усієї сили вдарила кулаком — і він пішов тріщинами.
          Зрозумівши, хто це, Яся всередині закричала і тільки побачила, як
          Відьма вишкірила свої ікла, бо пані Вітер уже хутко пливла геть.
        </p>

        <p>
          Дівчина заплющила очі і лиш чекала, коли Володарка добереться
          поверхні, та раптом її хтось схопив за руку і почав тягнути вниз.
          Володарка знову відкрила Ясі огляд, і вона побачила дивну чорну
          постать. Що це? Мара? Ні, вона має жіночі риси, а це — просто чорна
          тінь. Вдалині почувся жіночий крик. І їх раптом оточили ще з десятеро
          таких чорних тіней.
        </p>

        <p>
          — Це Блуд, — пояснила пані Вітер. — Він знає, що під водою я слабкіша,
          і часто робить вигляд, ніби поплутав мене зі звичайними утопленими,
          але забуває, що така нікчемна демонічна істота, як він, не зможе
          вбити саму стихію природи.
        </p>

        <p>
          Тому пані Вітер раптом зупинилась, опираючись тязі десяти пар чорних
          рук, пригорнувши їх до себе, заплющила очі, поки їх тягнули на дно.
          Пані Вітер все думала і думала. Тиша — така сильна — пронизала Ясю, і
          темрява, що її захлинула, — ще більша паніка. Здавалось, Володарка
          зникла і залишила тіло Ясі на призволяще. Дівчина дивилась, як Блуд
          зрадів: вони дотягнули її до самого дна і почали копати пісок із
          водоростями, щоб затягнути тіло під землю, а що далі? Вони хотіли
          поховати її живцем?
        </p>

        <p>«Володарко Вітру! — крикнула Яся. — Володарко Вітру!» — кричала вона, плачучи, але ніхто не відповідав.</p>

        <p>
          І коли вже обличчя Ясі засипало піском, вона раптом відчула потужний
          прилив енергії. І, розправивши всі кінцівки, вона виробила таку хвилю
          Вітру та світла, що тіні розлетілись у різні боки, а сама пані Вітер
          змогла вибратись із піску, що скаламутив воду. Раптом нізвідки
          зʼявився пан Водяник. Він з криком і сяючим тризубом почав розганяти
          Блуд, що тікав хто куди, у всі можливі шпарини. І коли справу було
          зроблено, він разом із Володаркою поплив догори.
        </p>

        <p>— Чого так довго, Водянику? — спитала Вітер.</p>

        <p>— Пробачте, пані! Пробачте! Не знав, не знав, що сталось!</p>

        <p>— Менше чай з русалками потрібно ганяти, негіднику! — обурилась Володарка.</p>

        <p>— Прошу, пані, не зліться, не зліться на старого дурня! Але ж я прийшов! Прийшов! — не вгавав він, та Вітер уже не хотіла з ним говорити.</p>

        <p>
          Вони випливли на поверхню, і Володарка пройшлась по воді просто до
          мавки, що чекала її на березі.
        </p>

        <p>— Ви в порядку?</p>

        <p>— Могло бути й краще, — відповіла вона, — але ми добре впорались.</p>

        <p>
          — Чудово, проте мушу вас квапити. Це буде грубо вас про це просити,
          але чи можете ви знову пустити Ярославу в її тіло?
        </p>

        <p>
          Пані Вітер завагалася. Їй не подобалась така перспектива — вона знову
          опинилась вдома і хотіла пролетітись своїми володіннями, але, трохи
          подумавши і вислухавши аргументи Стефанії, вона зрозуміла, що тіло
          може померти від такого перенапруження, і тому погодилась.
        </p>

        <p>
          Яся відчула, як її знову огортає темрява, і вона переходить із грудей
          назад у мозок. Дівчина розплющила очі і різко перевернулась на бік,
          виблювавши, мабуть, з літр води з водоростями, піском та іншою
          живністю. Отямившись і віддихавшись, Яся потерла долонями обличчя.
          Вона жива. Їй страшенно пощастило.
        </p>

        <p>
          А потім вона згадала Відьму — і тілом пройшовся холод. Вона озирнулась
          і побачила, що на неї дивляться Влад, Амелі, Марк та мавка. З озера
          визирав Водяник з русалками — усі були дуже схвильовані.
        </p>

        <p>— Відьма… вона на дні озера… — нарешті видавила дівчина.</p>

        <p>Стефанія спохмурніла і піднялась на ноги, у неї неначе відняло дар мови.</p>

        <p>— Про що ти таке кажеш? — здивувався Марк.</p>

        <p>— Насправді вона каже правду, — мовила Амелі і аж просіла під спопеляючим поглядом Влада.</p>

        <p>— Ти знала? — раптом зрозуміла Яся.</p>

        <p>
          — Так, — закивала дівчина. — Коли Володарка Води заволоділа моїм
          тілом, вона облетіла усі води на території країни. Синевир був
          першим. Вона сказала, що він, кокон, тут уже сотні років.
        </p>

        <p>— І ти мовчала? — дорікнув Влад. Амелі хотіла щось відповісти, але раптом звіявся надзвичайно сильний вітер. Небо затягнули сірі хмари, вітер був настільки сильний, що друзі ледь тримались на ногах, та потім всіх зірвало і підняло в небо. Не розуміючи, що коється і не в змозі щось зробити, вони почали панікувати, але раптово все спинилось, і все застигло в повітрі: дерева, гілки, тварини, мавки і решта лісових істот, а потім усі почули голос.</p>

        <p>
          «Я бачила тебе, Вітре, ти повернулась, отже і всі решта тут. Мене
          ослухались мої слуги. Мене зрадили мої помічники! Я скорочую терміни.
          У вас є 5 годин, щоб мені скоритись, інакше буде війна. Я заволодію
          цією землею і знищу все на своєму шляху. Кожну живу істоту. Якщо я у
          свій час не заслужила на прощення, то ніхто в цьому світі на нього не
          заслуговує».
        </p>

        <p>
          Голос зник, друзі ще трохи повисіли в повітрі, а потім упали на
          землю; усе повернулось на свої місця, і небо знову розвиднілось.
          Підлітки перелякано перезирнулись, після чого Яся різко підвелась і
          підійшла до мавки.
        </p>

        <p>— Чому вона отямилась раніше? Чому, коли Амелі тут зʼявилась, вона цього не відчула, а коли я — так, все? Як вона взагалі звіяла вітри, якщо вони належать стихії, а не Відьмі?!</p>

        <p>
          Мавка мовчала довгі кілька хвилин, після чого відповіла:
        </p>

        <p>
          — Я сама над цим міркую. Можливо, справа в тому, що Володарка Води —
          частина води, і її переміщення не були важливі для Синь, оскільки вона
          могла сплутати її з Водяником. А от ти була величезним поштовхом, від
          якого сколихнулись стіни її кокона, вона увібрала частинку твоєї
          енергії, якої вистачило утворити такий буревій, і, неначе той звір у
          сплячці, прокинулась. А тепер уявіть, на що вона здатна. Синь
          накопичувала сили сотні років.
        </p>

        <p>
          Стояла тиша, паніка поглинула всіх із головою, і першою не витримала
          Амелі:
        </p>

        <p>— Seigneur Jésus! — вигукнула вона.</p>

        <p>Всі подивились на неї з осудом, і тоді вона крикнула:</p>

        <p>— Чому ви дивитеся? Потрібно терміново щось робити! Якщо країна піде під воду — нам усім кінець!</p>

        <p>— Ми йдемо до моєї бабці, — твердо мовив Влад, — потрібно порадитись. Хутчіш, — казав він.</p>

        <p>— Поспішіть, стихії, — сказала услід мавка. — Ми вас чекатимемо.</p>

        <p>
          Вони минули смугу і, спинившись серед дерев у лісі, вкритих першим
          снігом, Яся знову відчула морозний холод. Влад озирнувся.
        </p>

        <p>— Десь тут… — бубонів він собі під ніс. — Кілька кроків правіше, — йшов далі, поки не знайшов дерево, помічене червоним хрестом, і тричі постукав. Кілька секунд — нічого, а потім у темряві серед дерев виникли два привиди.</p>

        <p>— Покажіть шлях до потаємного ходу в маєток Меінґоу.</p>

        <p>
          Привиди кивнули, і всі пішли слідом за постатями. Вони йшли в тиші;
          лишень шурхіт листя під ногами, змішаного з брудним снігом, трохи її
          порушував. Друзі квапились. Через деякий час вони вийшли на невелике
          округле місце, яке з усіх боків щільно оточували дерева. Привиди
          зникли, і Влад, впавши на коліна, почав розгрібати сніг, поки не
          знайшов ручку. Тоді він сіпнув її догори — і перед друзями відкрився
          потайний хід зі сходами, що вели вниз, у темряву. Влад заплющив очі —
          і раптом його каштанове волосся спалахнуло легким вогнем. Він поглянув
          на друзів палаючими червоними очима.
        </p>

        <p>— Ходімо, — сказав він. — Тільки спочатку дайте дещо зробити, — підійшов до Ясі і простягнув руку. — Я тебе зігрію.</p>

        <p>
          У Ясі аж перехопило подих, але вона послухалась, і холодна, мокра рука
          торкнулась вогню. Вмить тілом дівчини пройшло тепло, а одяг висох за
          лічені секунди. Тоді Влад відпустив її і пірнув у темряву.
        </p>

        <p>
          Кілька довгих хвилин вони йшли підземним ходом. Стеля була низька —
          так, що доводилось нагинатись, — а вузько настільки, що максимум
          можна було повернутись навколо своєї осі, підібгавши руки під себе.
          Вони йшли, мабуть, хвилин пʼятнадцять; у Ясі страшенно калатало серце,
          а коли друзі минули часову межу і опинились у їхньому часі, у неї
          зуби заклацали один об один від холоду, а руки задубіли. Вона аж
          трусилась від того, як різко впала температура.
        </p>

        <p>
          Думки про тепло квапили всіх, і коли Влад нарешті спинився і штовхнув
          усередину двері, вони вилізли в коридор будинку пані Агати. Старі
          половиці заскрипіли, від побляклих шпалер тягнуло сирістю, а єдине
          старе віконце в кінці коридору показувало, що надворі збираються
          сутінки.
        </p>

        <p>
          Вийшло, — подумала Яся, — вона знову в Міжгірʼї.
        </p>

        <p>
          Раптом із тіні в куті виникла домова Анфіса:
        </p>

        <p>— Вітаю господаря цього будинку. Пані Агата вже чекає вас та ваших друзів у гостьовій кімнаті.</p>

        <p>
          Нічого не відповівши, Влад кивнув і повів усіх у ту саму кімнату, де у
          свій перший раз побувала Яся. Вона тремтіла від холоду, а з рота йшла
          пара; та коли вони зайшли до кімнати, температура змінилась із холоду
          на тепло, що йшло з великого каміна в стіні. Яся хутко підійшла
          ближче і з благоговінням закрила очі, насолоджуючись теплом; усі
          послідували її прикладу. Бабця Влада сиділа на старому диванчику коло
          столика.
        </p>

        <p>— Вітаю вас, наші рятівники. Як вам перша зустріч із відьмою Синь?</p>

        <p>— Звідки ти знаєш? — спитав Влад.</p>

        <p>
          — У мене було видіння, де ви сидите на галявині, і раптом нізвідки
          зʼявляється її голос. Я так розумію, у нас часу обмаль?
        </p>

        <p>— Так. Мусиш розповісти, що нас чекає в битві з нею.</p>

        <p>— Що ж, дорогенькі, з чого почати… — пані Агата поглянула на них своїми очима, затягнутими білою плівкою, і відпила теплу рідину з чашки. — У першу чергу ви повинні довіритись вашим стихіям. Будемо боротись від найсильнішого до найслабшого. Першим на себе удар прийме Марко. У нього найліпша гармонія із його стихією, і він найкраще з вас із нею справляється, а останньою, скоріш за все, буде Ярослава, — усі поглянули на дівчину із жалістю, — оскільки ти майже не тренувалась. Ми надіємось, що…</p>

        <p>— Що Володарка Вітру сама знайде вихід із ситуації. Тому залишаймось спокійними, — закінчила Амелі, щоб так і не прозвучало те, від чого може впасти дух команди. — Ніхто сьогодні не помре.</p>

        <p>— Згодна, Володарко Води, — кивнула старенька. — Тому допиваємо чай і мусимо повернутись у ліс. Час і мені розімʼятися трішки.</p>

        <p>— Ага, навіть не думай. Я поговорю з Мавкою — ти будеш весь час у безпеці, — вставив Влад, від чого посмішка з обличчя старої зникла.</p>

        <p>— Хлопче, я брала участь у таких битвах між лісовими істотами, що тобі і близько не снилось. І не те що тебе — твого батька не було в планах. Тому не смій мені вказувати, що я маю робити. А якщо спробуєш крутити інтриги проти мене зі Стефанією, клянуся своєю душею: я зречуся тебе, і ти залишишся без прізвища і спадку.</p>

        <p>
          Влад аж просів під поглядом Агати, але потім устромив у неї лютий
          погляд, не сіпнувши жодним мʼязом. Тоді тишу перервала Амелі, як
          завше спитавши те, на що ніхто б не наважився:
        </p>

        <p>— А чому ви завжди так погано говорите про мавку? — поцікавилась вона. — У вас із нею давня ворожнеча?</p>

        <p>
          Пані Агата раптом усвідомила, що на мить втратила контроль,
          помʼякшала на обличчі й посміхнулась своєю фірмовою загадковою
          посмішкою, що трохи лякала, і взяла горня чаю.
        </p>

        <p>— Дитя, це старий конфлікт — йому вже майже сто років… буквально, — додала вона наприкінці, і в молочній плівці на очах раптом промайнув лихий вогник спогадів.</p>

        <p>— Гадаю, у нас є трохи часу послухати. Врешті, хто зна, що з нами буде після битви…</p>

        <p>— Не дави на жалість, — зробила їй зауваження пані Агата. — Я таке не люблю, але так і бути — розповім. Моя родина переїхала сюди, коли мені було 5 років, тобто у 1914 році…</p>

        <p>— Вибачте, — знову перебила Амелі, — але вам 111 років?!</p>

        <p>— Так, — сказала пані Агата, ніби це було очевидно, — а ти думала, що цвіт папороті так легко дістати? Це трапляється раз на сто років — навіть у Мелашки не вийшло. Отже, ми переїхали з Англії в цю місцину, маючи великі статки, проте, як казали мої батьки, вони хотіли втекти від галасу Лондона так далеко і в таку забуту місцину, щоб ніхто їх більше не міг знайти. Я була ще мала і не знала деталей, але згодом усе зрозуміла. Підростаючи тут, мене завжди дуже тягнуло до природи, тому в 13 років, коли вдома послабили контроль і я змогла втекти на кілька годин від няні, я добігла аж до лісу. Мене завжди манили ці велетенські, древні дерева і дива, що вибиралися з-за них. Няня називала це моїми вигадками, але того разу я відчула, що нарешті зможу відкрити таємниці, довести, що я не божевільна, як мене називали селяни. Я зайшла у перший ряд дерев і почула тріск гілок. Обернулася на звук — нічого. Потім сказала:</p>

        <p>— «Я знаю, що ти тут, виходь», — промовила я тоді.</p>

        <p>
          І після кількох довгих хвилин тиші з темряви вийшла гарна висока
          дівчина у довгому зеленкуватому платті, що сягало пʼят, і з чорним,
          як ніч, волоссям нижче пояса.
        </p>

        <p>— Стефанія була нявкою? — поцікавилась Амелі.</p>

        <p>— Тоді ще так, але потім усе змінилося.</p>

        <p>
          Вона була цікава: надзвичайно бліда, а очі світилися холодним
          смарагдовим блиском, ніби в них застиг відблиск лісових глибин. Вона
          посміхнулася — і мені стало моторошно. Азарт зник із серця, хотілося
          тікати, але вона зупинила мене.
        </p>

        <p>— «Не бійся, дитино, — сказала вона лагідно. — Я не ворог. Я берегиня цього місця. Люди давно забули, як слухати ліс, але ти ще можеш навчитися».</p>

        <p>
          Я стояла приголомшена. Вона говорила спокійно, але в її голосі
          відчувалася сила. І тоді я вперше побачила, як повітря навколо неї
          наче подихало разом із нею — трава повільно хиталась, ніби кланялась.
        </p>

        <p>— «То хто ти?» — спитала я.</p>

        <p>— «Я мавка, дух лісу. Моє ім’я — Стефанія. Я народилась у цьому місці задовго до того, як люди навчилися називати себе людьми».</p>

        <p>
          Я почала відвідувати її і доволі часто. Вона показала мені, як слухати
          подих землі, як розуміти дерева й тварин, як відчувати, коли у світі
          щось порушує рівновагу. Ми стали близькими подругами. Я вчилась у неї,
          а вона — у мене, бо мала цікавість до людських речей: книжок, вогню,
          музики. Вона сміялась, коли я співала їй старовинних англійських
          пісень, і казала, що в людських голосах є магія, якої немає навіть у
          лісі.
        </p>

        <p>
          Та минали роки, і я почала помічати, що Стефанія змінюється. Вона
          ставала похмурішою, недовірливою. Казала, що люди більше не заслуговують
          на милість. Їй боліло бачити, як вирубують дерева, як мисливці стріляють
          у звірів. І одного дня я побачила, що вона стала карати всіх підряд.
          Вона не розрізняла більше винних і невинних — топила мисливців, відьом,
          навіть дітей, що просто заблукали.
        </p>

        <p>Я просила її зупинитися.</p>

        <p>— «Ти не Бог, Стефаніє. Ліс не вибачить тобі цього».</p>

        <p>А вона лише гірко засміялась:</p>

        <p>— «Я і є ліс. Він говорить через мене. Я несу покарання тим, хто забруднив наш дім».</p>

        <p>
          Відтоді між нами все змінилося. Я розуміла, що маю зупинити її, навіть
          якщо це означатиме зрадити подругу. Тоді я вже відкрила свій дар —
          бачити майбутнє — і знала, що, якщо цього не зробити, вона втратить
          себе остаточно.
        </p>

        <p>
          Я пішла до Лісовика і благала його зберегти рівновагу. Він дав мені
          силу — силу прокляття. Коли я зустріла її востаннє, вона стояла
          посеред річки, у воді по коліна, а навколо мертві риби спливали догори
          животом. Її очі вже світилися жовтим, як у хижачки.
        </p>

        <p>— «Зупинись, доки не пізно!» — кричала я.</p>

        <p>— «Пізно?» — засміялася вона. — «Пізно було тоді, коли люди вбили мій ліс».</p>

        <p>І я вимовила слова, яких не можна було відкликати:</p>

        <p>«Якщо в тобі не залишилось любові, ти житимеш серед болота й тіні, поки не навчишся знову жаліти».</p>

        <p>
          Тоді земля під її ногами розійшлася, і вода засмоктала її. Вона
          кричала — не від болю, а від люті. Так народилась нова мавка — та,
          яку ви знаєте сьогодні. Її волосся тепер світиться зеленим — це знак
          прокляття. Вона більше не вбиває людей, бо клятва тримає її, але і
          прощення досі не прийшло. Вона не може залишити цей край, і ліс
          тримає її біля себе, наче на ланцюгу. Я ж… я лишилась із тягарем того
          вибору. Зрадити подругу, щоб врятувати ліс.
        </p>

        <p>— І тепер вона не може вас пробачити? — тихо спитала Амелі.</p>

        <p>— Не може, — кивнула пані Агата. — Бо в глибині душі досі вірить, що я її зрадила. А я лише зробила те, що мусила.</p>

        <p>Вона зробила ковток чаю і трохи помовчала.</p>

        <p>— Але ви ж потім помирились? — несміливо вставила Яся.</p>

        <p>— Може, колись. Якщо світ вистоїть після того, що нас чекає.</p>

        <p>
          Тиша затягнулась. Вогонь у каміні потріскував, кидаючи відблиски на її
          зморшкувате обличчя. В цей момент у кутку з’явилась домова Анфіса й
          прошепотіла:
        </p>

        <p>— Пані Агато, до вас ще гості.</p>

        <p>— І хто ж це?</p>

        <p>— Пані Мелашка.</p>
      </div>

        <div className="mt-8 flex justify-between text-lg">
