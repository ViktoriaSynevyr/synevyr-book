"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter21Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="21. Секрети розкрито">
        <div className="space-y-7">
        <p>— Неочікувано, — мовила Амелі.</p>

        <p>
          — Насправді, — сказала пані Агата, — я чекала, коли вона нарешті
          наважиться розкрити усі карти. Анфісо, проведи її, будь ласка, до нас
          і принеси ще одну чашку чаю.
        </p>

        <p>Яся заціпеніла від страху.</p>

        <p>
          — Навіщо ви це зробили? Очевидно ж, вона… — але дівчина раптом
          замовкла. Звідки бабця може знати, що вона тут, якщо максимум, що
          батьки могли їй сказати, — це те, що вона вирішила втопитись і її
          зараз шукає купа рятівників?
        </p>

        <p>Бабця Влада посміхнулась.</p>

        <p>
          — Дійсно, вона не може знати, але не все так просто, Ясю, зараз ти все
          зрозумієш.
        </p>

        <p>
          Двері кімнати відчинились, і на порозі з’явилась жінка середніх років
          у дуже хорошому вигляді. На ній була вишита хустка, светр, кожушок і
          довга спідниця, аж накривала стопи. Щоки жінки пашіли рум’янцем, а в
          блакитних очах застиг страх, що вп’явся просто в Ясю.
        </p>

        <p>
          — Она туй, — жінка схопилась за серце. — Господи, слава тобі!
        </p>

        <p>
          — Владику, дай пані Мелашці своє крісло, бачиш, їй погано.
        </p>

        <p>
          Хлопець послухався і допоміг жінці пройти від порогу до кола людей, що
          сиділи навколо столика. Вона сіла в м’яке велике крісло і ще раз
          оглянула компанію — здавалось, вона бачила привидів.
        </p>

        <p>
          — Боже, дитино, я ся так за тя перелякала! А родичі як! Якби ми нич не
          знали, ти би вже була бита!
        </p>

        <p>
          — Мелашко! — вигукнула пані Агата. — Вони чинили так, як я їм сказала,
          і з нею, в принципі, не мало нічого статись. Просто ти в цій грі
          зайняла не ту роль, от і не мала змоги знати все з найперших.
        </p>

        <p>Мелашка сплеснула в долоні.</p>

        <p>
          — Та ж як не знала, коли знала! Думаєш, вона би так просто тягала б до
          хижі твого бахура й лазила б по бібліотеці?
        </p>

        <p>
          — Так ви все знали! — вигукнула Яся. — Я так і знала: не могли ж ми за
          весь цей час жодного разу не попастись. І як мені взагалі усе з рук
          спускали…
        </p>

        <p>
          — Чекайте, чекайте, — перебила їх Амелі, — тобто весь цей час, усе, що
          ми робили, — ви про це знали і нічого нам не зробили? Чому?
        </p>

        <p>— Бо так вже мало бути, я просто, просто…</p>

        <p>— Забрехалась, — закінчила бабця Влада.</p>

        <p>— Агато, не вводи дітий в блуд!</p>

        <p>
          — Та я і не вводжу. Тобі зараз треба розповісти таке, після чого вже
          твоя онука невідомо, чи буде тобі вірити взагалі.
        </p>

        <p>
          — А може вже перестанете ходити ту і там й поясните, що відбувається?
          — влізла Яся.
        </p>

        <p>
          Усі стихли. Пані Мелашка розправила спідницю і ще довго розглядала на
          ній складки.
        </p>

        <p>— Є дещо, дитино, але я не знам, як то розказати…</p>

        <p>
          — Кажіть, як є, — сказала тремтячим голосом Яся, відчуваючи, як у
          грудях закрався химерний здогад, змією обплітаючи нутрощі.
        </p>

        <p>У бабці потекли сльози.</p>

        <p>— Кажіть! — крикнула Яся.</p>

        <p>
          — Як ти знаєш, — почала пані Мелашка, — з самого початку Володарка
          Вітру була не в тобі, а в твоїй сестрі Ані.
        </p>

        <p>Серце Ясі тьохнуло і впало в п’яти. Її почало трусити.</p>

        <p>— Як ви всі знаєте, я слуга Відьми вже 76 літ…</p>

        <p>
          — Стоп-стоп-стоп! — перебила Амелі. — Якщо події відбувались
          приблизно в 1944-му, і вам було 16, то зараз вам 92?!
        </p>

        <p>У всіх, окрім Влада і пані Агати, очі стали як тарелі.</p>

        <p>— Так.</p>

        <p>— Скільки тоді панові Мельнику?</p>

        <p>— 93 роки.</p>

        <p>
          — Але він не виглядає на 93! Максимум 60, вам взагалі від сили 40!
        </p>

        <p>
          — Дитино, — посміхнулась пані Мелашка, — я мольфарка, що кориться
          демонічній істоті. Конечно, я знаю рецепти зілля, що уповільнюють
          старість. Звісно, вони не можуть помочи, як на мені ся відображає
          служба Відьмі, але як не крути — воно допомагає.
        </p>

        <p>— А чому тоді пані Агата старіє?</p>

        <p>
          — На відміну від Мелашки, — влізла раптом пані Агата, — я пускаю
          життя на самотік і хочу відповідати своєму віку. До того ж не веду
          такий публічний образ життя, тому тут також потрібно врахувати, в
          якій місцині ми живемо.
        </p>

        <p>
          — Дякую, Агато, — саркастично кивнула Мелашка, — але вона права. До
          того ж, коли я робила всьо, аби мати то, що маємо нині, я через Відьму
          не старіла. Через 30 років у людей ся появили питання, тому ми з дідом
          Янеком на якийсь час щезли — нам уже було по 50. Я родила Михася, і ми
          скористалися історійов Агати — всьо підробили так, аби здавалося, що я
          померла по родах, а дід — від старости та жалю за мною. Всьо почало
          занепадати, і таку велику ділянку забрала держава. Тогди був Радянський
          Союз, а до того, завдяки моїм чарам, ніхто не знав про це місце, бо би
          моментально забрали і зробили колгосп, що врешті потому і сталося. То
          були кінці сімдесятих років. Більше як 10 років ми ся ховали, покоління
          в селі змінилися, про нас усі забули, а як совок нарешті розпався в
          1991-му, ми ся повернули і взяли назад нашу ферму, здобувши багато
          влади і добрий старт.
        </p>

        <p>— Дивовижно! — скрикнула Амелі. — Ви просто неймовірна!</p>

        <p>
          Пані Мелашка гордовито кивнула, ніби це очевидно.
        </p>

        <p>— Дякую, дитино. На чим я ся зупинила?</p>

        <p>
          — На тому, що дух Вітру мав бути в Ані, а не в мені, — нагадала Яся.
        </p>

        <p>
          — Дякую, Ярославо. Так от, она… она… — бабця запнулась, їй неначе не
          вистачало повітря, а Ясю почало трусити ще до того, як бабця
          продовжила, бо останній пазл склався в голові. — Она звеліла ми єї
          вбити, — закінчила врешті жінка, і в кімнаті стала така мертва тиша,
          що тілом пішли мурахи.
        </p>

        <p>
          Напівпорожня кружка з чаєм раптом випала з рук Ясі й розбилась об
          підлогу.
        </p>

        <p>— Seigneur Jésus… — мовила Амелі, прикривши рота долонею.</p>

        <p>
          А Яся, підвівшись, почала вибачатись і збирати уламки скла, та раптом
          з’явився домовий і посунув її геть. Тоді Яся стала на коліна. Вона
          схопилась за голову, їй до горла підійшли ридання, а бабця все
          говорила і говорила…
        </p>

        <p>
          — Знаєш, я мало слухала Відьму, усе находила способи, як обійти її
          накази, але тота разина вона залізла ми просто в голову, змусила мя
          зробити це. І часом ми ся здає, шо то було якесь Боже покарання, бо
          з-поміж мільярдів людей стихія вибрала саме мою онучку, мою кров.
          Ярославо, то через мене ви тої ночі попали в автокатастрофу. То я
          змусила оленя вибігти на дорогу. Того дня нечисть, зрадники, її слуги
          схопили мене за ноги і потягли в ліс. Вони могли зробити то сами, але
          бо Відьма хотіла помстити ми за мій не послух на протязі многих років.
          Вона змусила мене дивити, як я вбиваю свою дитину. Схопивши мене,
          нечисть перенесла нас у ліси Татарова через одну з часових меж. Моєю
          свідомістю вже тогди володіла Відьма, я лем спостерігала. Якийсь олень
          трапився нам на дорозі, я пам’ятаю, як моя рука піднялася, і як
          енергія стрімко вдарила в звірину, а потому вона побігла просто до
          вас, а далі — свист шин і ви летите в тоту прірву… — вона замовкла,
          дивлячись, як Яся здригається. — Та сталося диво, і ти вижила.
          Стихія перебралася в твоє тіло, а ми всі получили надію. Тато нічого
          не знав, як і мама, — бабця захитала головою. — Вона не просто так
          мене не долюблювала, Ярославо, вона якби знала, хто я, а я лем
          підтримувала тот образ, аби ніяк вам не нашкодити. Я полюбила твою
          маму як рідну доньку, як лишень Михась її привів, але я так ся бояла,
          що Відьма захоче й її вбити, що почала відштовхувати, — вона витерла
          очі. — Після аварії, коли твій тато сказав ми про твій стан, я
          переконала його, що у мене тобі буде ліпше. Я хотіла тебе вберегти і
          водночас помогти бодай якось розв’язати цю проблему. Я підштовхувала
          вас одне до одного…
        </p>

        <p>
          — Чекайте, — перебила Амелі, — як ви нас один до одного підштовхували?
        </p>

        <p>Бабця подивилась на неї червоними очима.</p>

        <p>
          — Ти думаєш, я не знаю, як виглядають тварюки-оберігачі із західних
          лісів? Побачивши твого кота, я зразу всьо поняла, а потому й відчула —
          він зі мною говорив. Більше того, я ніколи в житті не дозволяла туй
          селитися людям з тваринами, але ти перша за 40 років, для кого я
          зробила виняток, аби ви з Ярославою ся познакомили. То я сказала
          Маркови йти шукати гриби якраз тогди і якраз у тот ліс, куди їхали
          Ярослава й тот її друг, котрого вона воскресила. То я веліла Бомондови
          напасти й налякати Марка з Ясею тогди в лісі, аби хоть трохи вас
          зрушити з місця. Я з самого першого дня знала, що тогди між статуй на
          подвір’ю сховався Перелесник і пудив Ярославу. Я знала, що вона пішла
          у бібліотеку, і файно знала про кожен ваш хід, тому спускала вам з рук
          всі брехні: і коли Ярослава казала дідови Янеку, що хвора, і коли
          лінувалася. Я дала вам можливість розгадати тії таємниці і, зрештою,
          спинити це пекло, — закінчила вона і, просидівши кілька секунд у шоці,
          що нарешті виговорилась, раптом вибухнула: вона зайшлася риданнями. —
          Пробачте ми, будь ласка.
        </p>

        <p>
          Яся повільно переварювала сказане. Здавалось, кімната відлетіла кудись
          дуже-дуже далеко, бо вона залишилась тільки в своїй — сама з собою.
          Свідомість перенесла її назад у той момент, коли машина зламала паркан
          і полетіла вниз: як вона зробила кілька сальто, як вони стрибали, наче
          тенісні м’ячі, по салону; як скло врізалось у тіло і як дзвенів
          вологий хрускіт, а повітря раптом наповнилось запахом відчаю та смерті.
          Її плечі здригнулись раз, потім другий, а потім її поглинула істерика.
          Було дуже боляче згадати це знову.
        </p>

        <p>
          Усвідомити, що це насправді було. Запах смерті в повітрі — і такий
          поглинаючий страх, що здавалось, більше нічого хорошого в житті ніколи
          не станеться. Через кілька довгих хвилин Яся отямилась у тій же
          кімнаті й поглянула на всіх мокрими очима. Її обіймала бабця і казала
          щось про вибачення. Тоді Яся відсторонилась і підвелась.
        </p>

        <p>
          — Я хочу побути наодинці, пробачте, — і пішла геть.
        </p>

        <p>
          Руки тряслись, голова гуділа від перенапруження. Вона витерла мокрі очі
          і повернула в перші двері, що трапились на очі. Це була невеличка
          кімната; за вікном падав сніг, а вдалині виднілась ферма бабці. Ліжко
          було застелене синім одіялом, а на вицвілих шпалерах висіли постери
          футбольних команд. Навпроти ліжка, зліва від дверей, був розпалений
          камін. Яся сіла коло теплого вогнища і поринула знову у свої думки.
          Вона не знає, скільки так просиділа. В голові варилась купа думок, а
          на душі скребла і муляла розідрана стара рана. Яся згадувала усе
          пережите і намагалась зрозуміти, чому все склалось саме так.
        </p>

        <p>
          Мабуть, коли пройшла добра година, у двері постукали і, не дочекавшись
          відповіді, зайшла Амелі. Вона сіла поруч із Ясею і поглянула на дрова,
          які облизували язики полум’я.
        </p>

        <p>— Як ти?</p>

        <p>— Таке собі.</p>

        <p>— Розумію.</p>

        <p>
          — Вона досі там?
        </p>

        <p>— Так, вони про щось говорять з Агатою, ми всі в ступорі.</p>

        <p>— Ви щось вирішили?</p>

        <p>
          — Власне… ні. Це дуже ризиковано. На словах звучить круто — ми будемо
          битися із Відьмою і так далі, — але хто зна, що з нами може статись.
          Наші тіла не всесильні — це лише захист для стихії, та навіть якщо
          захист помре, стихія виживе. В цьому і полягає суть: вони живляться
          нами. Бабця Влада казала, що якщо ми виживемо після битви — це буде
          диво, проте ще деякий час будемо як овочі. Організм ослабне, почнемо
          частіше хворіти. Можуть піти роки на відновлення. І знаєш… — вона
          раптом запнулась. Яся поглянула на неї і побачила, що подруга плаче.
        </p>

        <p>
          Яся обійняла її і раптом відчула відчай. Вони лишень діти, вони не
          зобов’язані це робити, але що тоді?
        </p>

        <p>— Я не хочу помирати, — нарешті закінчила Амелі, і її тіло затрусилось у риданнях.</p>

        <p>
          — Ти не хотіла, щоб вони бачили, що ти плачеш? — спитала Яся і,
          відчувши кивок, обійняла подругу міцніше.
        </p>

        <p>
          — Вона, — всхлипувала Амелі, — каже, що все буде добре.
        </p>

        <p>— Ти про голос у голові?</p>

        <p>— Так.</p>

        <p>— Але ти їй не віриш, — зрозуміла Яся.</p>

        <p>— А ти свою не чуєш?</p>

        <p>
          — Вона зникла після того, як пустила мене назад у мозок. Вона
          неначе… впала в сплячку — і мене це радує, бо я вже задовбалась
          слухати її. І ти теж відчуваєш, як тебе пробирає енергія?
        </p>

        <p>
          — Так, пані Агата каже, що це магія стихії. Вони прокинулись і
          закріплюються міцніше і міцніше в нас.
        </p>

        <p>Амелі раптом поглянула на Ясю:</p>

        <p>— Навіщо нам це робити?</p>

        <p>
          — Щоб урятувати інших, звісно. Буде егоїстично, якщо ми дозволимо
          загинути цілій країні.
        </p>

        <p>— Але чому ми? Чому не Агата з Мелашкою?</p>

        <p>
          — Бо вони несуть інший тягар, — усвідомила Яся, — а от ми народились
          не в той час і не в тому місці. Точніше — у вигідному не для нас.
          Проте все так ідеально складається, що таке просто гріх казати,
          мабуть.
        </p>

        <p>— Ти підеш з нами?</p>

        <p>— Піду.</p>

        <p>— А тобі краще?</p>

        <p>
          — Звісно, ні. Я, до речі, усвідомила ще дещо.
        </p>

        <p>— Що саме?</p>

        <p>
          — Пані Агата все знала, з самого початку. Коли я перший раз завітала
          до неї в гості, вона повідала мені пророцтво про Синь, а потім уперше
          згадала, що Володарка Вітру повинна бути не в мені. Ми дійшли
          висновку, що це моя сестра, а потім вона сказала: «Впасти зі скелі з
          такої висоти і вижити — це диво». Я їй жодного разу не розповідала,
          як саме ми загинули. Перед цим вона з першого разу спитала, чи ми
          потрапили в автокатастрофу.
        </p>

        <p>
          — Лишенько, — сказала Амелі, — а як це ти не звернула увагу?
        </p>

        <p>
          — Я звернула, але знаєш, як вона вміє… — змінити тему і обкрутити
          навколо пальця, — Яся замовкла і подумала, а потім їй аж млосно
          стало. — Мало того, виходить, і Влад теж усе знав.
        </p>

        <p>Очі Амелі округлились до розміру тарілок.</p>

        <p>— Ні…</p>

        <p>
          — Так, авжеж так. Він просто… — вона вдихнула, — кретин.
        </p>

        <p>
          Раптом двері відчинились, і на порозі з’явився Влад. Він здивувався,
          побачивши тут дівчат, і вже роззявив рота, але не встиг, бо Яся
          підвелась і з розмаху вліпила йому ляпаса.
        </p>

        <p>
          — Часом потрібно говорити важливі речі, а не тільки сипати образами
          іншим, — пояснила вона і рушила до вітальні.
        </p>

        <p>
          Яся підійшла до жіночок, що сиділи на диванчику, і люто поглянула на
          обох.
        </p>

        <p>
          — Він заслужив, люба, — сказала пані Агата. — Я теж, але попрошу мене
          не бити, це було на благо усім. Бабця сама мала тобі це розповісти, а
          не я.
        </p>

        <p>— Як батько вас не зненавидів? — звернулась Яся до Мелашки.</p>

        <p>
          Та вже трохи заспокоїлась. Колишня впевненість ніби витекла з неї
          водою: вона сиділа дуже пригнічена, з неї неначе криком виривалась
          провина і жаль за все зроблене.
        </p>

        <p>
          — Уже зненавидів, — вона поклала горня з чаєм на столик. — Коли він
          подзвонив і сказав, що ти зробила, мені довелось усе йому розповісти.
          Він сказав, що вони виїжджають по тебе.
        </p>

        <p>— У мене ще одне питання.</p>

        <p>— Слухаю.</p>

        <p>
          — Якщо ви коритеся демонічній силі, як ви тоді на свято Богородиці
          могли перебувати в церкві?
        </p>

        <p>
          Бабця сіпнула бровою — мабуть, її здивувало це запитання, а точніше
          деталь, яку Яся відмітила, — тому вона почала пояснювати, неначе сама
          до цього нещодавно дійшла:
        </p>

        <p>
          — Я сама над цим довго думала. У нас завжди була дуже віруюча родина,
          але я боялась ходити до церкви. Перші роки два я шугалась ікон: мене
          починало сліпити і вбивати щось із середини, але поступово, після
          завершення війни, Янек повернувся до мене, і я знову відчула потужну
          і теплу силу всередині — це була любов, вона допомагала мені боротись
          із темрявою в мені і залишатися в здоровому глузді. Мене перестали
          вбивати ікони, а потім я спробувала перший раз за багато років прийти
          в церкву, але в храмі мені стало дуже погано, мене трусило в
          конвульсіях. Проте надія в серці не згасала. Я продовжувала молитись,
          і ми знайшли межі, завдяки яким я можу залишатись на боці світла і
          добра. Я стою завжди на порозі — це, власне, і почало породжувати купу
          дивних пліток про мене, завдяки яким туристи досі цікавляться нашою
          фермою.
        </p>

        <p>Яся кивнула.</p>

        <p>
          — Але повернімось до діла. Оскільки батьки все знають і скоро тут
          будуть, у вас час геть урізано.
        </p>

        <p>Яся схопилась за голову.</p>

        <p>— Що нам робити?</p>

        <p>Пані Агата теж поклала горня на стіл і мовила:</p>

        <p>
          — Як що? Діяти. Ходімо, гадаю, вже час, — вона накинула на плечі
          поїдену міллю хустину і взяла зі столу свічку. — Агов, усі! — крикнула
          вона, і Влад, що хотів наздогнати Ясю, Амелі, що намагалась його
          втримати, Яся, що тільки зараз це побачила, і Марк, який уже готовий
          був їх рознімати, поглянули на неї. — Ми вертаємося до лісу. Попрошу
          поводити себе чемно. Я буду йти попереду, позаду мене йтиме Владик,
          далі — Марк, Амелі і Ярослава, а замикатиме наш стрій Мелашка. І не
          дай Боже, хтось почне сваритись. Владе, мусиш запхати свою гордість
          куди подалі зараз, потім усе їй поясниш і визнай, що ти справді
          лицемірив перед друзями. Усе, ходімо.
        </p>

        <p>
          Спантеличені, вони ще кілька секунд дивились один на одного, а потім
          все ж пішли слідом за старенькою.
        </p>

        <p>
          Дорога назад холодним підземним ходом дала змогу кожному задуматись
          про своє, тому добрих 15 хвилин тиші та роздумів змусили усіх
          охолонути як морально, так і фізично, а в лісі їх зустріла мавка.
        </p>

        <p>— Вітаю, Агато.</p>

        <p>— Привіт, Стефаніє, давно не бачились, — кинула вона зневажливо.</p>

        <p>
          — Тільки перегукувались: у тебе ж коліна болять вийти.
        </p>

        <p>
          — Ой, втопилася б я в 20-річному віці, може, теж могла б по лісі
          щиголяти взад-вперед. Але ми зараз не про це. Я привела їх. Потрібно
          все підготувати. Є якісь зміни?
        </p>

        <p>
          — Водяник каже, що кокон тріснув і розпався. Відьма, наче готовий
          ембріон, готується до виходу в світ. От-от вилізе.
        </p>

        <p>
          — Зле, але у нас є хоч щось. Погано те, що Ярослава не дуже готова —
          вся надія на Володарку.
        </p>

        <p>— Ти тренувалася? — поцікавилась мавка у Ясі.</p>

        <p>— Трохи.</p>

        <p>Та похитала головою.</p>

        <p>
          — Будемо бачити, — і, розвернувшись, кивнула: — Ходімо, у нас багато
          роботи.
        </p>

        <p>
          Вона провела їх назад на галявину до Синевиру, де зібрались сотні
          лісових істот. Вони дивились на них із цікавістю, подивом та надією.
          Якщо не ці четверо — їхній світ може зруйнуватись назавжди.
        </p>

        <p>
          — Отже, кожен повинен зайняти свої позиції. Ви повинні, як завше,
          впустити у свідомість стихії — і далі вони усе зроблять за вас. Ваша
          енергія живить їх. Тому, якщо після того, що станеться, ви виживете,
          то почуватиметеся, наче космонавт після польоту в космос — слабкими і
          знесиленими, навіть ходити не зможете. Ви відновитесь, але дуже не
          скоро.
        </p>

        <p>Усі мовчки кивнули.</p>

        <p>
          — Отже, нумо-нумо! Сідайте в коло — усе, як я вас вчила.
        </p>

        <p>
          Друзі перезирнулися і чемно послідували вказівкам нечисті.
        </p>
      </div>

        <div className="mt-8 flex justify-between text-lg">
          <Link
            href={`/${lang}/reading/chapters/20`}
            className="underline"
