"use client";
import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter5Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="5. Легенда про озеро Синевир">
        <div className="space-y-7">
        <p>
          У понеділок зранку Ясі, на диво, вдалося легко встати. Скоро
          поснідавши, вона повернулася до кімнати й приєдналася до уроку.
          Домашнє завдання доробила між перервами, звільнилася близько обіду і,
          в супроводі Федька, пішла їсти. Руки вже не так «свербіли» за
          телефоном, як у перший тиждень, — можна було видихнути.
        </p>

        <p>
          До зміни лишалося пів години. Оскільки робити було нічого, дівчина,
          трохи поговоривши з батьками, у яких, на диво, за стільки часу
          знайшовся вільний час для дитини, спустилася на ґанок допити каву й
          розкласти все «по поличках» у голові, спостерігаючи за мармуровими
          фігурами на подвір’ї.
        </p>

        <p>
          Погляд упав на білу статую мавки — згадалися ельфоподібний хлопець,
          якого вона бачила, слова Лізи про ліс та істот, про яких учора
          розповідав Михась біля вогнища. Яся раптом усвідомила, що саме їй
          треба шукати: міфічні істоти карпатського лісу. Точно!
        </p>

        <p>
          Вона легенько гримнула кулаком по перилах і, допивши каву, на радощах
          залетіла назад до хатчини, віддала бабці телефон і побігла на зміну в
          кафе. Відпрацювавши, повечеряла і, вже в супроводі Федька (якому це
          теж набридло), повернулася до кімнати. Сівши за ноутбук «робити
          уроки», вбила у пошук потрібний запит. Натрапивши на книжку про
          міфічних істот, до пізньої години виписувала всіх дивних персонажів,
          поки не натрапила на Перелесника.
        </p>

        <p>Ось він.</p>

        <p>
          Тілом пробігли сироти. Ті самі довгі вуха, та сама врода, те саме
          довге руде волосся. Тільки це не ельф — це злий дух, один із
          мешканців лісу, що хоче звести Ясю з глузду, набираючи подоби її
          сестри Ані.
        </p>

        <p>
          «Перелесник, або вогняний змій, — у слов’янській міфології злий дух, що
          шкодить людям, набуваючи подоби їхніх близьких…»
        </p>

        <p>
          Вона відкинула ручку й торкнулася долонями вологого обличчя. Істерика
          накрила на дві хвилини. Потім Яся витерла сльози і почала ходити
          кімнатою туди-сюди, потираючи плечі. Але ж це вигадки. Оповіді
          пращурів, що довгими вечорами при свічці вигадували казки. Тоді що
          Перелесник робив тут? У будинку бабусі, просто над Ясиною кімнатою?
          Чому він полює саме на неї?
        </p>

        <p>У двері постукали — дівчина підстрибнула. В кімнату зазирнув Федько.</p>

        <p>— Час спати.</p>

        <p>— Знаю.</p>

        <p>
          — Добрануч. Ночка ся буде холодна, — сказав він, і Ясі аж млосно
          стало. Побачивши це, хлопець заходився заспокоювати: — Гой, не журисі
          ти так, просто закутайсі більшо в ковдру тай усьо.
        </p>

        <p>Яся кивнула.</p>

        <p>
          Він подивився на неї мовчки ще кілька секунд і додав:
        </p>

        <p>— У тебе точно всьо файно? Ти шо плакала?</p>

        <p>— Ні-ні! — випалила Яся й зрозуміла, що видала себе.</p>

        <p>
          — Сумуєш за домом? То нормально, але нич помочи не можу. Надобрануч,
          — він зачинив двері й пішов.
        </p>

        <p>
          Кімнату поглинув морок, а дівчина ще довго не могла заснути, ховаючись
          під ковдрою, здригаючись від завивання вітру за вікном, що розгойдував
          гілля, й увесь час прислухаючись до тиші, в якій їй, здавалося, час від
          часу чулося, як її кличе сестра.
        </p>

        <p>***</p>

        <p>
          Ранок видався не дуже. Після напівбезсонної ночі Яся почувалася, як
          підкошений заєць. Відсидівши уроки й прийнявши зміну в кафе, вона
          дізналася дві важливі новини.
        </p>

        <p>
          По-перше, все селище гуділо від повідомлень про землетрус на півдні
          країни. Бабця перемикала канали на плазмі в кафе, і майже на кожному
          показували зруйновані будинки в Миколаєві, Херсоні та Запоріжжі.
          Розворушивши ґрунт, землетрус докотився до Чорного моря, через що вода
          затопила будинки в радіусі десяти кілометрів.
        </p>

        <p>
          По-друге, зник старий лісник. Він майже все життя провів у лісі —
          селяни одразу загомоніли про нечисть, але Яся тільки закотила очі.
          Проте фото дідуся пані Мелашка приклеїла на вході до кафе з підписом
          «Розшук».
        </p>

        <p>
          І по-третє (це вже інсайдерська інформація персоналу): з неділі в
          маєток заселилася французька родина.
        </p>

        <p>
          Серед них була дуже вродлива дівчина — ровесниця Ясі. Вона знала
          російську, й усіх аж передьоргувало, коли та заговорювала. Хтось
          пустив плітку, нібито це «коханка тієї родини» і як їм не соромно
          возити її з собою.
        </p>

        <p>
          Яся одразу зрозуміла, що це нісенітниця: з характером її бабці їх би
          тут не поселили. Додали, що сьогодні вони прийдуть на сніданок. Уже за
          годину Яся побачила, як у кафе увійшла дівчина з довжелезним бордовим
          волоссям.
          <br />
          Гостре бліде обличчя, дуже мила посмішка, витончена повільна хода і
          довгі акуратні пальці.
        </p>

        <p>
          Вона була сама. Замовила каву — на диво російською (від чого Ясю аж
          пересіпнуло) — зі стриманим акцентом і притаманною французам
          картавістю. Яся десь чула, що картавити французи почали, наслідуючи
          одного зі своїх королів. Кумедно.
        </p>

        <p>
          Отримавши замовлення, дівчина розгорнула книжку «Падіння дому Ашерів»
          у російському перекладі й просиділа так близько години. Потім
          розрахувалася, подякувала й пішла, залишивши чайові, а разом із ними —
          шлейф парфумів і змішане відчуття здивування, неприязні та цікавості.
        </p>

        <p>
          Люди далі шепотілися, а Яся в плітки не лізла — слухала й аналізувала,
          що варте уваги, а що ні.
        </p>

        <p>
          Під кінець зміни прийшла Ліза по ще одну діжку молока. Привіталися,
          трохи потеревенили. Тоді Яся спитала, чи знає Ліза щось цікаве про
          бабцю Влада, але та лише знизала плечима: якщо Яся хоче знати — хай
          побачить стареньку сама.
        </p>

        <p>
          Увечері, прямуючи на вечерю, Яся на хвильку озирнулася на дім, що
          самотньо стояв серед поля біля дороги. Скоро наздогнала Федька, в
          голові вже крутився план, тож, дійшовши до хатчини, спинилася й
          заговорила:
        </p>

        <p>
          — Хочу дізнатися про бабцю, що живе в тому дивному будинку, — кивнула
          в бік дороги.
        </p>

        <p>— Чому би то? — посміхнувся хлопець.</p>

        <p>
          — Усі про неї теревенять, але ніхто не каже, що саме з нею не так.
        </p>

        <p>— Усі?</p>

        <p>
          Яся затримала подих (здається, Федько щось знає, але палитись не
          можна), тоді якнайспокійніше додала:
        </p>

        <p>— Відвідувачі в кафе.</p>

        <p>
          — Ах от воно шо, — протягнув він. — У такому разі… она добрий знавець
          туйошніх країв і створінь, што жиют у лісі.
        </p>

        <p>— Справді? — ледь не підскочила Яся.</p>

        <p>— Еге ж. А шо?</p>

        <p>— Та цікаво просто.</p>

        <p>
          Федько хмикнув:
        </p>

        <p>— Не накой дурниць, Ярославо.</p>

        <p>— Чого б це?</p>

        <p>
          — Бо кльочі від дверий на дорогу я лишаю зубцьом на вихід, а не у
          трубу.
        </p>

        <p>
          Усе в Яси всередині обірвалося, обличчя заллялося рум’янцем. Хлопець
          розреготався й заходився заспокоювати:
        </p>

        <p>
          — Все файно, я тоже на Вечурниці Лізи ходжу, але тоту неділю роботи
          було дай Боже. Я тебе не суджу. Як-ніяк, тут як у тюрмі бути, — кивнув
          у бік маєтку.
        </p>

        <p>
          Кілька секунд Яся переварювала почуте, потім полегшено видихнула:
        </p>

        <p>— Дякую, що не здав бабці.</p>

        <p>
          Хлопець підморгнув:
        </p>

        <p>
          — Від того ліпше не було би ані мені, ані тобі. Скоріш всего, мене би
          поставили тебе пантрувати по кілько годин, а може і зовсім не
          відходити.
        </p>

        <p>— Слухай, якщо це невигідно ні тобі, ні мені — пропоную співпрацю.</p>

        <p>— Прикривати тя? — посміхнувся. — Нашо ми то?</p>

        <p>
          — Зайві чайові ще нічию кишеню не обтяжували, вірно? — Яся витягла зі
          штанів 50 гривень і простягнула хлопцеві.
        </p>

        <p>
          Він узяв купюру, подивився, тоді — на Ясю:
        </p>

        <p>— Як я ся спалю, то она мене покарає.</p>

        <p>— Думаєш?</p>

        <p>
          — Пані Мелашка не проста жона. Хто знає, што їй у голову прийде. То
          вже як у якому настрої буде.
        </p>

        <p>— Отже, в теорії покарання можна оминути?</p>

        <p>Кивнув. Ще трохи повагавшись, сховав гроші до кишені.</p>

        <p>— По руках, — мовив. Новоспечені компаньйони потисли руки.</p>

        <p>
          Після вечері, коли Федько проводжав Ясю до кімнати, дівчина попросила
          послугу: завтра, під час останнього уроку — фізкультури — вона піде до
          будинку загадкової пані.
        </p>

        <p>
          — Та без питання, як ніщо. Айбо за додаткову плату, само собою, —
          додав.
        </p>

        <p>— Домовилися.</p>

        <p>— Тогди до завтра.</p>

        <p>— До завтра.</p>

        <p>
          Вони попрощалися, і дівчина зачинила двері. План вималювався чітко:
          піти «в гості», прикинувшись туристкою, яка заблукала. Старенька
          прийме — і Яся зможе з нею побалакати. Мало б спрацювати… Еге ж?
        </p>

        <p>⸻</p>

        <p>
          Ранок минув як по маслу. Ніщо не віщувало біди. Яся приєдналася до
          уроків, а о десятій побачила в ноутбуці сповіщення в Telegram від
          Федька: бабця повела туристів на Синевир. Це займе близько чотирьох
          годин — часу вдосталь. Та страх і хвилювання все одно шугали під
          грудьми, нагадуючи про можливі наслідки. Проте, згадавши Перелесника,
          дивні звуки, Аню й лісника, що зник, Яся вирішила: прагне розібратися.
          Бабці не скаже — та одразу збагне, що Яся була на третьому поверсі й
          щось планує; надмірного нагляду не треба. Ситуацію знав і Дем’ян:
          заспокоював Ясю, казав, що це наслідки переїзду і стресу, що варто
          повернутися до психолога.
        </p>

        <p>Можливо, це наслідок пережитого влітку — але Яся відмовилася.</p>

        <p>
          Психолог казала: іноді треба відпустити. Не опускати рук, але
          відпускати людей. Болісно, та з часом притупиться. Головне — не йти на
          повідку у свідомості, яка під час стресу може накоїти дурниць. Та Яся
          не йде на повідку… правда? Усе в її руках. Вона береться за ситуацію й
          вирішує її. Дізнатися щось від мертвої сестри — хіба це погано?
        </p>

        <p>
          І не можна відкидати ймовірність існування тих самих міфічних істот. І
          фраза старослов’янською, викарбувана на дощечках; і сповільнення та
          прискорення часу; і зникнення лісника — все це відбувається, отже
          варто заглибитися.
        </p>

        <p>
          Яся виринула з думок і помітила, що з уроку вже почали
          від’єднуватися. Увімкнула мікрофон, сказала «до побачення» і закрила
          чат. Останній урок — фізкультура. 11:10. Дівчина приєдналася,
          привіталася, вимкнула камеру та мікрофон, як і всі. Накинувши рюкзак і
          кофтинку, вийшла в коридор — за дверима чекав Федько.
        </p>

        <p>— А фізкультура — це хіба не вправи?</p>

        <p>
          — Ні, вчителька читатиме презентацію про баскетбол. Єдине — в кінці
          замість мене скажи «до побачення» і від’єднайся, якщо я затримаюся.
        </p>

        <p>— І як мені то зробити?</p>

        <p>— Дай свій телефон.</p>

        <p>
          Яся записала на диктофон «До побачення» і віддала хлопцеві.
        </p>

        <p>
          — Я хочу знову піти через праве крило. Там відчинено?
        </p>

        <p>Кивнув.</p>

        <p>— Удачі, — кинув услід. Яся, нічого не відповівши, побігла дерев’яними сходами вниз.</p>

        <p>
          Опинившись за парканом, дівчина вирушила вже знайомою стежкою — до
          темного будинку, що вирізнявся своєю незвичайністю на тлі гір. Із
          кожним кроком невпевненість брала гору. «А раптом не спрацює?» —
          долоня, якою стискала шлейку наплічника, спітніла. «Дурна
          невпевненість,» — картала себе. «Візьми себе в руки!» Вона пригадала
          все, що обмірковувала зранку, і, коли від страху тілом знову пройшли
          сироти, крокувала твердіше, воліючи дістати відповіді.
        </p>

        <p>
          Осінь уже всіма барвами заявила про свій прихід. Жовтогаряче листя
          встеляло дорогу; пожовкла скошена трава обіймала поле; гори палали
          теплими червоними, помаранчевими та жовтими відтінками. Їхні ліси
          дихали меланхолією повільного передзимового завмирання.
        </p>

        <p>
          Яся спинилася перед парканчиком, що рівною стежкою вів до старовинних
          дверей. Дивилася на них якийсь час, не в змозі поворухнутися. Щойно
          ступила кілька кроків назустріч невідомому — двері різко
          розчинилися. Яся, підскочивши від переляку, шмигнула вліво, ховаючись
          серед дерев.
        </p>

        <p>О Боже! Господи, господи, господи!</p>

        <p>
          Що робити? Вийти з-за дерева — неввічливо й підозріло, ніби шпигує.
          Тож, тримаючись схованки, Яся обережно визирнула. Старенька була в
          довгій чорній сукні з мережаним коміром. Сиве волосся стягнуте в
          шиньйон, очі — сірі, затягнуті прозорою плівкою. Совість смикнула: їй
          би допомогти — раптом упаде? Але жінка спокійно озирнулася й,
          повернувши ліворуч, пішла стежкою за будинок.
        </p>

        <p>
          Як… вона це робить? Лінзи? — майнула думка. Та цікавість узяла гору, і
          Яся, крадучись між дерев, рушила слідом. Садок тягнувся вздовж усього
          паркану, кронами затуливши вид на заднє подвір’я. Підійшовши ближче до
          першого ряду, Яся побачила: попри сірість погоди, на подвір’ї стояли
          два лежаки. Між ними — невеличкий столик із графином, либонь, чаю, і
          двома склянками. Жінка озирнулася, налила собі чаю й вмостилася на
          одному з лежаків, діставши книжку.
        </p>

        <p>Зачекайте… Книжку?</p>

        <p>
          Дівчина дивилася, як старенька — чи то читала, чи просто дивилася на
          сторінки, перегортаючи їх кожні кілька хвилин. Що тут, у біса,
          відбувається?
        </p>

        <p>
          Вийти не може, повертатися — теж. Як сліпа жінка самостійно гуляє і
          читає книжку?
        </p>

        <p>
          Закортіло підповзти ближче. Ось дерево з низькими гілками; одна —
          довга, на ній можна сидіти. Стараючись ступати якнайтихіше, Яся
          підійшла до стовбура і вилаяла себе за спідницю. Власне, вона
          збиралася культурно посидіти на диванчику й поговорити зі старою пані,
          а не лазити по деревах. Та, зважившись, полізла. Масивні черевики
          стали в пригоді — за хвилину вже сиділа на гілці, маючи чудовий огляд.
          Зелений светр протиснувся в кору, чорні колготи й спідниця, здається,
          теж; русяве густе волосся заплуталося в листі. Швидко розв’язавши
          «клубок», вона завмерла, сподіваючись, що вітерець замаскує її
          ворушіння.
        </p>

        <p>
          — У тебе наглості як у тої кози, чесне слово, — озвався хлопець, і Яся
          ледь не зірвалася.
        </p>

        <p>Схопившись за гілля, озирнулася.</p>

        <p>— Правіше, — підказав голос. Придивившись, побачила Влада на сусідньому дереві — у гірчичному светрі, з насмішкуватим виразом.</p>

        <p>— Хто б говорив, — кинула Яся.</p>

        <p>— Я то? Шановна, я тут живу.</p>

        <p>
          Після цих слів Яся спалахнула до коренів волосся. Пауза затягнулася —
          її перервала старенька:
        </p>

        <p>
          — Владику! Злазь з дерева, я тобі скільки разів казала там не лазити!
          І поклич нашу гостю на чай.
        </p>

        <p>
          Яся глипнула на хлопця спантеличеним поглядом. На чай?
        </p>

        <p>— Поясниш?</p>

        <p>
          — А може, не ставитимеш мені питань, на які я не хочу відповідати? —
          зістрибнув він із гілки, чекаючи.
        </p>

        <p>— Відвернись, — процедила Яся.</p>

        <p>
          Влад усміхнувся і зник серед дерев.
        </p>

        <p>— Один — один, Ярославо.</p>

        <p>— Що ти верзеш? — буркнула вона, зісковзуючи додолу. Вийшла з тіні, схрестивши руки на грудях.</p>

        <p>— Це тобі за глінтвейн, — кинув. — Що, цікаво стало після байки біля ватри?</p>

        <p>Яся промовчала.</p>

        <p>— Я так і знав.</p>

        <p>— Що саме?</p>

        <p>— Що ти попадешся.</p>

        <p>
          — Стривай. Ти її онук?
        </p>

        <p>
          — Допетрала нарешті, — вишкірився. — Подейкують, що вона вбиває дітей і
          закопує на задньому подвір’ї за те, що ті лазять по її грушках.
        </p>

        <p>
          Холод прошив спину. Влад хмикнув, задоволений уколом:
        </p>

        <p>— Два — один, Ярославо.</p>

        <p>Терпець урвався.</p>

        <p>
          — Ти що, «Кайдашеву сім’ю» перечитався? — кинула. — Розумію, у кожного
          свій смак, але не варто брати приклад суто з Мотрі. Там, загалом,
          позитивних персонажів немає, проте раджу притримати зміїну отруту, бо
          зараз — перше й останнє попередження. Інакше станеш видрооким, як та
          стара мерзенна баба, — відрізала Яся і, штовхнувши його плечем, пішла
          до будинку.
        </p>

        <p>
          Усередині на мить завмерла: просто перед нею височіли величезні
          готичні сходи. Вони займали значну частину вітальні; стіну вздовж
          маршу прикрашало кілька десятків портретів. Поки дівчина розглядала цю
          дивовижу, старенька вже стояла на одному з прольотів, а Влад підходив
          до першої сходинки. Оглянувся, побачив, що та застигла, і, добираючи
          слова, сухо кинув:
        </p>

        <p>— Ти йдеш?</p>

        <p>
          Краще вже так, ніж: «Я зістарюся разом із бабцею, поки ти позбираєш
          очі по паркету, три — один, Ярославо», або «Ти сходів ніколи не
          бачила? Може, не віриш у їхню реальність — показати документи? Чекай,
          спитаю в бабці, де вони завалялися, три — один, Ярославо».
        </p>

        <p>
          Швидко отямившись, дівчина витерла ноги об килимок і побігла слідом.
          Старі дерев’яні підлоги скрипіли, перила вкривала пилюка. На другому
          поверсі ліворуч виднівся овальний коридорчик, просто — ще один, із
          кількома розгалуженнями й різким поворотом праворуч. Влад зайшов у
          середню кімнату, Яся за ним. Просторе приміщення: посередині —
          невеликий диванчик, круглий журнальний столик і м’яке крісло
          навпроти. За диваном у лівому куті — ще одні двері. Три великі вікна з
          тюлями; прохолодно.
        </p>

        <p>
          Бабця Влада сиділа на диванчику, запрошуючи Ясю сісти поряд. Її
          блідо-сірі очі лякали — здавалося, вона дивиться просто на дівчину.
          Влад примостився у кріслі. Коли всі вмостилися, бабця заговорила,
          втупившись кудись у бік дверей. У Ясі знову побігли сироти.
        </p>

        <p>
          — Бракує дечого, — вона тричі плеснула в долоні. — Анфісо, люба,
          принеси чаю.
        </p>

        <p>
          Яся сподівалася когось побачити — але, крім них трьох, нікого не було.
          Вона запитально зиркнула на Влада; той лише спопеляюче дивився на неї.
        </p>

        <p>
          — Отже, Ярославо… — почала бабця, та Яся перебила:
        </p>

        <p>— Звідки ви знаєте, як мене звати? І чому говорите не так, як усі тутешні?</p>

        <p>
          — Почнемо з того, що я навіть знала, що ти прийдеш, — відповіла вона.
          — Не хвилюйся, дорогенька, — лагідніше додала, — я маю дар
          яснобачення. Сьогодні зранку мавки сказали мені, що на мене просто з
          дерева звалиться гостя. А говорю не як усі, бо я не зовсім тутешня. Не
          люблю зливатися з сірою масою, але діалект, коли треба, відтворю з
          точністю.
        </p>

        <p>Яся насторожилася — з усіх слів її зачепило одне:</p>

        <p>— Мавки?</p>

        <p>— Вони самі.</p>

        <p>— А… гаразд, — кліпнула Яся.</p>

        <p>
          — Тому я трохи підготувалася до твого приходу. Мене, до речі, звати
          Агата, — усміхнулася. — Бо як же це — я знаю, як тебе звати, а ти мене
          — ні. Ну, дитино, вітерець і сьогоднішня похмура погода шепочуть, що
          маєш до мене запитання. Я уважно слухаю.
        </p>

        <p>
          Ясю стискало зсередини: тиск погляду Влада, погляду Агати й загальна
          атмосфера будинку. Дивина останніх п’яти хвилин зовсім відібрала мову.
        </p>

        <p>
          — Розумію, дитино, тобі некомфортно. Та запевняю: будь-яке питання про
          мене чи цього злого парубка навпроти нас не образить.
        </p>

        <p>
          Взявши себе в руки, Яся нерішуче спитала перше:
        </p>

        <p>— Як ви мене бачите?</p>

        <p>
          Старенька помовчала, тоді глянула на стіл:
        </p>

        <p>— О, чай принесли!</p>

        <p>
          Яся сіпнулася: справді, на столі стояв чай, хоча кілька секунд тому —
          нічого. Серце пішло вгалоп. Досить. Вона не готова. Час тікати. Яся
          підвелася, та пані Агата м’яко зупинила її, взявши за зап’ясток:
        </p>

        <p>
          — Усе гаразд, люба. Повір, твоя стара ще й не таке вміє — просто не
          показує.
        </p>

        <p>— Ви знаєте мою бабцю?</p>

        <p>
          — З самого дитинства. І про неї можу розповісти чимало. І про
          Перелесника, що являється тобі, і про фразу на дощечках.
        </p>

        <p>
          Ноги в Ясі стали ватяні; щось у грудях обірвалося і скотилося в п’яти.
          Звідки вона все це знає? У цю мить, відчувши, як кімната пішла
          обертом, Яся зрозуміла: або вона справді хоче знати, що відбувається,
          і приймає це як належне — або тікає і живе, як жила, доки наприкінці
          грудня не повернеться додому.
        </p>

        <p>
          Знову плакатиме над могилою сестри, зустрічатиме Новий рік у депресії
          — і так ніколи не дізнається, яка дивина коїться тут. І головне — що
          їй хотіла сказати сестра. Коли земля під ногами «зупинилася», Яся
          повернулася на місце й уважно подивилася на жінку:
        </p>

        <p>— Я вас слухаю.</p>

        <p>
          — Дякую тобі, Ярославо, за це рішення. Отож, ти питала, як сліпа жінка
          пересувається без допомоги. Скажу так: бачу я не зовсім так, як ви
          обоє, — вона кивнула на Влада. — Маю певні здібності: бачу все, мов у
          сепії; люди для мене — наче намальовані й обведені контуром. І все.
        </p>

        <p>— А решта? Звідки ви знаєте?</p>

        <p>
          — Мавки, — відповіла так, наче це очевидно. — Вони Перелесника
          недолюблюють, але саме він мав привести тебе у їхній світ. Ти ж не
          віриш. Звісно, він трохи нашкодив: хотів заманити й убити, як усіх, та
          Шугайстр його вчасно спинив.
        </p>

        <p>— Перепрошую… у що?</p>

        <p>
          — В інший світ. Дитино, ліс вивчений на чотирнадцять відсотків.
          Гадаєш, там, окрім білок, лисиць та ведмедів, нікого немає?
        </p>

        <p>
          Яся вдихнула:
        </p>

        <p>
          — Ви хочете сказати, що міфологічні істоти, яких «вигадали» наші
          предки, геть не вигадані?
        </p>

        <p>— Саме так.</p>

        <p>— Але чому мене в це втягують?</p>

        <p>
          — Ось ми й підійшли до головного. Бабця розповідала тобі легенду про
          озеро Синевир?
        </p>

        <p>— Ні.</p>

        <p>
          — Лишенько, — зітхнула. — Як це: туристів «вчить», а тобі не
          розповіла?
        </p>

        <p>— Яку байку?</p>

        <p>
          — Ой, дитя, дитя. Мелашка знає більше, ніж я, але правду перекручує та
          подає зовсім під іншим соусом.
        </p>

        <p>— Як саме?</p>

        <p>— Приховує деталі.</p>

        <p>— І в чому ж легенда?</p>

        <p>
          — Слухай. Давним-давно, коли наші предки жили в достатку, а на столі
          сидів сам Данило Романович, жив тут один пан — боярин, власник цих
          земель. Мав доньку — Синь. Ой, яка врода була! І серце добре.
          Покоходила простого хлопця Вира, що був у них підмайстром. Кохали вони
          одне одного, та батько зневажав ту любов: хлопець не рівня. Раз вони
          домовилися втекти. На світанку Синь мала прийти в ліс, на галявину
          біля озера, де Вир чекатиме. Втічуть на схід. Усе йшло за планом, та
          батько дізнався. Наказав схопити Вира й утопити, а Синь змусив
          дивитися — аби знала, що буде, якщо не слухатиметься. Хлопця вбили,
          тіло кинули в озеро, Синь забрали додому. Плакала день і ніч, не їла,
          а згодом вчинила крайнощі: уклала угоду з дияволом. Той пообіцяв
          повернути коханого, але надурив, забравши душу. Не знаючи цього, вона
          втекла вночі, прибігла до озера й, забігши у крижану воду, кричала,
          шукала тіло, а потім, замерзнувши, пішла на дно за коханим. Вранці
          батько виявив зникнення. Шукали довго, допоки рибалки не побачили біле
          плаття, що пливло, мов ганчірка. Зрозуміли — і пошуки припинили. Та на
          цьому історія не скінчилася.
        </p>

        <p>— А бабця що розповідає? — перебила Яся.</p>

        <p>
          Агата закотила очі:
        </p>

        <p>
          — Що вони щасливо перетнули озеро і прожили в мирі та достатку до
          кінця життя. І що пара, яка торкнеться води, матиме ту саму долю.
          <br />
          «Торкнутися можна за 50 гривень із людини». Кінець історії. Але не
          кінець моєї, — додала. — Люди вирішили боротися з зникненнями.
          Прийшли до озера й почали молитися, благаючи прощення для Синь. Марно.
          З води вийшла вона. Повисла над гладдю й промовила:
        </p>

        <p>
          «За вашу халатність і бездушшя страждатимете багато поколінь».
        </p>

        <p>
          І почала вбивати селян направо й наліво. Перерізала пів села, здійняла
          страшний землетрус — Закарпаття й Галичина сколихнулися. Збиралася
          йти далі, нищити все на шляху: уже дійшла до Києва, піднімаючи води
          Дніпра. Та її зупинили чотири стихії. Разом скували в кокон і вже
          хотіли знищити, як у останню мить вона заглушила всіх своїм вереском —
          і світ стих. Потім заговорила:
        </p>

        <p>
          «Ви не знищите мене так просто. Я чекатиму 800 років, перш ніж
          помщусь; тоді мене ніхто не спинить, і вся країна потоне у водах
          Синевиру, як колись я та моя любов».
        </p>

        <p>
          Після того пустила потужну хвилю вітру, що змела все в радіусі ста
          кілометрів (у тому числі й стихій), і впала у води Дніпра, зникнувши.
        </p>

        <p>
          Країну огорнув відчай. Люди молилися — марно. Тоді селяни, що
          лишилися в Міжгір’ї, пішли на розмову з лісом. Кажуть, після довгих
          перемовин лісові духи дали пророцтво: зупинити напасть зможуть тільки
          нащадки тих людей. Дівчина — вільна, наче вітер; хлопець — із
          характером дракона; дівчина, що здатна осідлати хвилю; і хлопець,
          поєднаний із природою. Чотири стихії, чотири нащадки. Вони або дійдуть
          згоди, або зруйнують усе, що будувалося віками. Символи орла, змія,
          коня і короля Лісу досі викарбувані на одному з дерев у лісі, —
          закінчила жінка й поглянула на спантеличену Ярославу.
        </p>

        <p>
          Забагато нової інформації. Каша в голові лише побільшала.
        </p>

        <p>
          — Тобто ви стверджуєте, що якщо четверо обраних, призначених
          вісімсот років тому, не знайдуться, — Україна піде під воду, як
          Атлантида?
        </p>

        <p>
          — Цілком імовірно. І бажано, аби це сталося найближчим часом, бо, за
          прогнозами Лісовика, Синь повстане в останній місяць зими.
        </p>

        <p>— Лісовика? Чекайте, то він не зник?</p>

        <p>
          — Я про справжнього Лісовика, дитино, — того, про якого ти читала з
          ноутбука. А нашого Стефана забрали духи: він уже був старий. Все життя
          в лісі, зморився. Ліс і так кликав його, бо невдовзі має прийти їхній
          справжній володар.
        </p>

        <p>— Гаразд, — протягнула Яся. — Але я тут до чого?</p>

        <p>
          Стара кілька секунд дивилася своїми очима, затягнутими білою пеленою,
          не кліпаючи.
        </p>

        <p>
          — Є ще одна причина, чому ти тут, дитино, — кивнула на стіл. —
          Скуштуй чаю й подай мені горня.
        </p>

        <p>Яся недовірливо глянула на чашку.</p>

        <p>
          — Він не отруєний, — урвав тишу Влад. — Зроби ласку: просто випий і не
          тягни. Якби ми хотіли тебе вбити, давно б зробили. — Затримав паузу й
          уже спокійніше додав: — Перелесник не дарма намагався показати тобі
          вхід у їхній світ. Зараз доля цілої країни залежить від тебе. Не
          просри все.
        </p>

        <p>
          — Гарно сказано, юначе, — з докором мовила пані Агата, — але зайвих
          слів можна було й уникнути. Пий — це всього лише чай.
        </p>

        <p>
          Яся послухалася. Випила до дна, випльовуючи зернятка, й подала кружку
          жінці. Та покрутила її, роздивилася всередині й усміхнулася:
        </p>

        <p>— Я так і знала.</p>

        <p>— Що там? — не витримала дівчина.</p>

        <p>
          — Ти — обрана, Ярославо. Твоя стихія — вітер.
        </p>

        <p>
          Очі в Ясі округлилися.
        </p>

        <p>— Що? Що?</p>

        <p>
          — Не дивуйся так…
        </p>

        <p>
          — Але ж… — слова не зводилися. — Стихія вітру — це вільна людина. Я
          скорена родичам.
        </p>

        <p>
          — Згідна, щось тут не клеїться, — зосередилася Агата. — Володарка
          Вітру покинула нас вісімнадцять років тому. Тобто тобі мало б бути
          вісімнадцять. А тобі…
        </p>

        <p>— Чотирнадцять, — сказала Яся.</p>

        <p>— Саме так. Хтось спадає на думку?</p>

        <p>Поміркувавши, Яся прошепотіла:</p>

        <p>— Моя сестра. Аня.</p>

        <p>— Вона. Та вона загинула в автокатастрофі?</p>

        <p>— Так.</p>

        <p>
          — І ти була з нею, — кивнула старенька. — Стихія перебралася в твоє
          тіло, Ярославо. Саме тому ти й вижила. Впасти в автівці зі скелі й
          вижити — це диво.
        </p>

        <p>— Я не казала, що ми впали зі скелі.</p>

        <p>
          — Це не важливо. Важливо, що пані Вітер робить свою справу: ти
          руйнуєш межі, які вибудовують перед тобою дорослі. Якби ти була
          «скорена», ти б злякалася — і зараз не сиділа б тут. Та щоб повністю
          звільнитися, мусиш відкрити свою найбільшу травму, ту, що залишила
          шрами болю й горя. Як і всі інші. Отже, лишилося знайти доньку Води та
          Володаря Землі — або Короля Лісу, як забажаєш, — підсумувала вона.
        </p>
      </div>

        <div className="mt-8 flex justify-between text-lg">
          <Link
            href={`/${lang}/reading/chapters/4`}
            className="underline"
          >
            ← Попередній
          </Link>

          <Link
            href={`/${lang}/reading/chapters/6`}
            className="underline"
          >
            Наступний →
          </Link>
        </div>
      </BookPage>
    </main>
  );
}
