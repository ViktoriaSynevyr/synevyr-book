"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter12Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="12. Остання підказка">
        <div className="space-y-7">
        <p>
          У недільний вечір, після гостьового прийому в лісі, не сталося
          абсолютно нічого. Яся провела в роздумах цілий день: за сніданком, за
          зміною в кафе (принаймні туди прийшла Амелі, і вони змогли бодай
          трішки обговорити все, що вичитали в старезному фоліанті) і на
          конюшні, за вечерею, а потім і в ліжку у своїй кімнаті.
        </p>

        <p>А ще — в очікуванні, бо наступного дня зранку мав прилетіти Дем’ян.</p>

        <p>
          Як пообіцяла Ясі бабця (а їй сказали про це батьки), для дівчини
          скасували заборону користуватись телефоном, тому вперше за півтора
          місяця Яся знала, що його не заберуть зранку за сніданком, і ця думка
          страшенно тішила. По-перше, їй подзвонив Дем’ян, і вони вже годину
          теревенили телефоном, поки хлопець пакував валізу, — це чудово
          відволікало від нав’язливих думок.
        </p>

        <p>
          По-друге, завдяки канікулам, які учні вибили страйком, Ясі не потрібно
          завтра вставати зранку на уроки. І післязавтра, і післяпіслязавтра. А
          найголовніше — ці дні вона проведе в компанії найкращого друга. Що
          може бути краще, враховуючи, як у неї минув останній місяць?
          Відволіктись від цієї химерної карпатської дивини — саме те, що
          потрібно.
        </p>

        <p>
          Дем’ян повинен прибути завтра приблизно о 12-й, особистим літаком. Для
          цього Ясю звільнили від роботи в кафе на декілька днів, і навіть дід
          пішов на поступки, тому Яся мала змогу не тільки зустріти друга, але й
          провести з ним цілий день. Попрощавшись десь далеко за північ,
          дівчина, збуджена від емоцій, ще довго не могла заснути, але коли о
          десятій продзвенів будильник, вона забула про сон і скоро кинулась у
          ванну чистити зуби та перевдягатись.
        </p>

        <p>
          На сніданку вона швидко поїла і поговорила з бабцею, що на диво була в
          хорошому гуморі. Після детального опису Дем’яна і розтлумачення, що
          Яся дружить із ним з пелюшок і як важливо гарно його прийняти, та, хоч
          і без великого бажання, дозволила приїхати йому як гостю на цілий
          тиждень — з умовою, що він житиме в готельній частині маєтку. Цього
          було цілком досить. Дем’янова мама оплатила номер на тиждень уперед
          (мабуть, додавши зверху кругленьку суму, щоб з хлопцем нічого не
          сталось — Яся це зрозуміла, коли бабця зойкнула, побачивши сповіщення
          з ПриватБанку), тому гарний прийом був забезпечений.
        </p>

        <p>
          — Йой, диви на ню, аж підскакує від нетерпіжі, ти трохи піжди, їште, —
          примовляла старенька. — Йой, шо то за парубок має бути, га, Яну?
        </p>

        <p>Дід хмикнув:</p>

        <p>— Мелашко, тобі ж повіли, шо они приятелі.</p>

        <p>
          — Та знав, знав, — казала вона, — та всьо ж я… Куди ти? — спитала
          бабця, та Яся вже підірвалась і вибігла з хатчини.
        </p>

        <p>
          Вона почула характерний звук — це сповіщало, що в небі летить літак.
          Вона щодуху побігла повз стайні, налякавши курей, що кинулись у різні
          боки, помчала повз конюшню і загін із кіньми, що паслися на
          пасовиську, просто до парканчика, який вів у чисте поле, де вже
          поступово приземлявся той самий літак. Яся перелізла маленьку огорожу,
          а серце в неї закалатало від нетерпіння й хвилювання. Невже після
          стількох днів у цій глуші вона знову зустріне свою людину?
        </p>

        <p>
          Пожовкла трава здіймалась навкруги хвилями, а листочки, що налетіли,
          закружляли довкола в шаленому вихорі. Двері гелікоптера відчинились, і
          звідти усміхнений виліз довготілий юнак. Він так широко посміхнувся, що
          здавалось, зараз сам лусне від радощів. Друзі кинулись один до одного
          і скріпились у міцних обіймах.
        </p>

        <p>— Пахнеш коровами і кіньми, — сказав він їй на вухо.</p>

        <p>— Пішов до сраки, — відповіла Яся, і вони розреготалися.</p>

        <p>
          Слідом за хлопцем із гелікоптера виліз провідник Дем’яна, дворецький
          родини, пан Степан, а за ним витяг із літака три дорогі валізи
          кремезний чолов’яга. Низький та сивий Степан підбіг до Дем’яна з Ясею і
          заговорив, перекрикуючи гучний літак:
        </p>

        <p>
          — Вітаю, пані Ярославо, радий вас знову бачити. Мушу провести пана
          Арисовського до господарів, упевнитись, що він потрапить до свого
          люкс-номера і, якщо вас, — він поглянув на Дем’яна, — усе
          влаштовуватиме, мушу спішити назад у Київ.
        </p>

        <p>
          — Як завжди, ділова ковбаса, — сказав Дем’ян пошепки Ясі на вухо; вони
          розреготались, і він потягнув подругу наперед у бік ферми.
        </p>

        <p>
          Яся вказала на маєток, куди кремезному чолов’язі потрібно було
          віднести валізи, а сама повела Дем’яна до хатчини. Там їх зустріла
          бабця, сперши руки в боки. Мабуть, вона очікувала побачити щось геть
          погане, бо вигляд її був суворий, та щойно роздивилась хлопця, обличчя
          її пом’якшало, і вона усміхнулась.
        </p>

        <p>
          — То це ти наш довгочеканиц гость! Рада ті вітати тебе в родиннім
          кругу, можеш кликати мене пані Мелашка.
        </p>

        <p>— Радий познайомитись, — Дем’ян трішки зашарівся.</p>

        <p>
          — Перерошую… — раптом озвався маленький Степан. — Я лишень хотів
          упевнитись, що з паном Арисовським все добре. Ви проведете його до
          номера?
        </p>

        <p>Брови бабці Мелашки злетіли вгору.</p>

        <p>
          — Проведу, — мовила вона і, витерши руки в рушник, пішла на вихід. —
          Ходімо тогди, у мене купа роботи, окрім вас двох.
        </p>

        <p>
          У маєтку бабця вивела їх на другий поверх і віддала ключі від номера.
          Степан видихнув і з чистою душею пішов геть разом із бабцею, яка
          додала: «Набувайтесь».
        </p>

        <p>
          Позбувшись усіх, друзі розкладали речі і без перестанку говорили про
          події, які не встигли розповісти телефоном.
        </p>

        <p>
          — То тобі за хорошу поведінку в цій тюремниці дали цілий тиждень
          вихідних?
        </p>

        <p>
          — Еге ж, — Яся лежала на ліжку, задерши ноги на стіну. — Сама
          здивована. Навіть не знаю, що ми будемо робити. Ти знаєш, у мене за
          два місяці вже сформувався графік, а тепер такий розслабон — аж дивно,
          що я зараз не бігаю в кафе між столиками.
        </p>

        <p>
          — Забудь про ті столики, у тебе у спадку лежить цілий статок, а тебе
          змусили офіціанткою працювати!
        </p>

        <p>Яся підвелась на ліктях і поглянула на хлопця.</p>

        <p>
          — От тому ти такий пихатий нахаба. Ти жодного дня у своєму житті не
          працював, а це добре загартовує.
        </p>

        <p>
          — Не дай Боже! — здійняв руки вгору Дем’ян. — Ці прекрасні долоні
          ніколи не візьмуться за якийсь підніс! Я занадто прекрасний для
          такого.
        </p>

        <p>У Ясі аж живіт заболів від сміху.</p>

        <p>— Що будемо робити сьогодні?</p>

        <p>
          — Я покажу тобі свою кімнату, а потім підемо на обід у кафе. Я
          пригощаю.
        </p>

        <p>Хлопець сплеснув у долоні:</p>

        <p>
          — Та у нас феєричні плани, чудово! Тут, до речі, так атмосферно: всюди
          гори, ліс, туман і мряка.
        </p>

        <p>— Карпати, — потисла плечима Яся. — І осінь.</p>

        <p>
          Розклавши речі, вони піднялись у кімнату до Ясі, і Дем’ян деякий час
          любувався видом з вікна на садок унизу.
        </p>

        <p>
          — Ти певна, що це сад? Схоже на міні-ліс під хатою.
        </p>

        <p>
          — Там фруктові дерева і кущі з малиною та суницею ростуть, де-не-де
          мох та гриби, і дуже дивні звуки, тому я без поняття.
        </p>

        <p>— О, то ти там була?</p>

        <p>
          — Звісно. У перший тиждень туристка-німкеня показала мені шлях до
          дверей у паркані. І треба ж було якось Влада всі ці рази пускати.
        </p>

        <p>
          — То ти чула звуки, але вас ніхто не чіпав?
        </p>

        <p>— Так… — сама задумалась дівчина.</p>

        <p>— Цікаво, цікаво все це…</p>

        <p>
          У кафе за їхній столик підсіла Амелі, і Яся познайомила її з Дем’яном.
          За розмовами пройшла друга половина дня. Амелі й Дем’ян, як
          виявилось, мали багато спільного. Вони обидва любили класику, чай (на
          що Яся закотила очі, бо їй була по душі кава) і спекотні літні дні (на
          що Яся теж закотила очі, бо літо у неї було не з найкращих).
        </p>

        <p>
          Вечеряти трійця відмовилась, і, напхавши кишені яблук (які знайшли в
          мішку в хатчині), побігли в маєток, де нишком чкурнули в кімнату Ясі.
          Вечір провели за розмовами і переглядом фільму «на фоні», а десь
          опівночі Амелі й Дем’ян пішли у свої номери.
        </p>

        <p>
          Вранці, прокинувшись, Яся пішла сама на сніданок, бо Дем’яна раніше
          десятої нічого не підніме, а потім зайшла до друга в гості.
        </p>

        <p>
          Дем’ян, як виявилось, був уже зібраний — у чорну водолазку і бежеві
          брючні штани. Схоже, Яся перервала його на читанні книжки — це було
          щось зі шкільної літератури, здається, «Меланхолійний вальс» Ольги
          Кобилянської (як розгледіла Яся на обкладинці). Книжка незграбно
          валялась на ліжку, велику кімнату наповнювало тепле жовте світло, а на
          підвіконні горіла ароматизована свічка, через яку в приміщенні стояв
          аромат яблук та кориці.
        </p>

        <p>— Я очікувала тебе застати сонним, — сказала Яся і плюхнулась на ліжко.</p>

        <p>
          — Взагалі-то я дещо запланував для нас, — він кивнув убік на
          невеличкий кошик. — Взяв нам продуктів, зараз доскладаю речі — і їдемо
          на пікнік верхи.
        </p>

        <p>
          Яся аж підстрибнула:
          <br />— То чого ми ще тут?!
        </p>

        <p>
          Тож, хутко взувши черевики для верхової їзди, загасивши свічку й
          світло, друзі попрямували в бік конюшень. Яся показала Дем’янові Вітра
          (який, задерши голову, повернувся до них дупою), після чого Дем’ян
          спробував задобрити коня яблуком, але той навідріз відмовився йти на
          контакт, тому вони пішли далі конюшнею дивитись, хто зараз є в
          деннику.
        </p>

        <p>
          — Карамельку не можна — вона через годину має заняття; Каштана теж —
          він на продаж іде завтра; так, так… — казала Яся, минаючи стійла. Коли
          вони пройшли ще зо сім і нарешті Яся згадала про двох коней, яких
          завжди дають на парну прогулянку, вони підійшли до денників у самому
          кінці конюшні, коло вікон: — Ось вони, знайомся, Берта і Ромашка.
        </p>

        <p>
          Яся вказала на двох кобил, що стояли в сусідніх стійлах, і Дем’ян
          схвально кивнув. Вони їх осідлали і пішли в бік лісу. Дорогою зайшли у
          критий манеж спитати в діда Янека дорогу.
        </p>

        <p>
          — За манежом йдете лиш прямо, і коли за 20–30 минут дойдете до крутих
          скал, повернете наліво, вийдете на поле, з котрого буде видко село.
          Заблудити не вдасться, бо для туристів навісили купу знакôв на всяких
          мовах. А перед входом у ліс увидите білборд з мапов, сфотґрафуєте — й
          тіштеся.
        </p>

        <p>
          Друзі подякували і, хутко застрибнувши верхи, поволі прокрокували
          стежкою до густих дерев, коло яких стояв малий парканчик, а зверху
          висіла табличка:
        </p>

        <p>«Ласкаво просимо до Чарівного лісу».</p>

        <p>
          — Чарівного? Твої бабця з дідом на повному серйозі назвали його
          Чарівним?
        </p>

        <p>
          Яся потисла плечима:
          <br />— Враховуючи, що тут відбувається, гадаю, є в цьому крихта
          іронії. Врешті, бабця — мольфарка, вона на цьому розкрутилася.
        </p>

        <p>
          У лісі було прохолодно, тому друзі раділи, що вдягли теплі куртки,
          шарфики та рукавички. Під ногами хрускотіли гілки, в хащах було чутно,
          як перебігають звірі. Ліс уже давно проковтнула осінь, яку поволі
          змінювала зима. Напівголі дерева стояли, сумно дивлячись на своє
          листя, що спало на землю, і тільки де-не-де тримали свої поодинокі
          листочки, які вітер не встиг зірвати.
        </p>

        <p>
          Та всі ми знаємо, що настане час, коли, якщо не зірвані вітром, то
          вони самі впадуть додолу до братів, яких потім сховає товстий шар
          снігу. Довкола було доволі тихо. Пташки вже давно відлетіли на південь,
          тому друзі з благоговінням вдихали життя, що завмерло просто в
          повітрі. Коні граційно ступали далі.
        </p>

        <p>
          Десь за пів години лісової стежки Яся та Дем’ян побачили світло, що
          вивело їх з-поміж дерев до скель. Звернувши ліворуч, як і казав дід, і
          ще кілька хвилин покрокувавши, вони потрапили просто на широку
          галявину, де просто майорів горизонт.
        </p>

        <p>
          Яся вдихнула повні груди повітря і заплющила очі, насолоджуючись
          миттю, але Дем’ян усе зіпсував, різко порушивши тишу:
        </p>

        <p>
          — Ну що, хто останній — той москаль! — крикнув хлопець, ударив Берту
          в боки і галопом ринув полем.
        </p>

        <p>
          — А щоб тобі! — крикнула Яся і, штовхнувши п’ятами Ромашку, теж
          кинулась у галоп за другом.
        </p>

        <p>
          Спочатку було лячно. Вона вчепилася колінами в сідло, пальцями — у
          вуздечку і притислась до коня, та, проїхавши так деяку відстань,
          зрозуміла, що можна розслабитись. Тижні тренувань дали свій результат
          — тіло автоматично згадало всі минулі тренування та їзду. Тому,
          видихнувши, Яся випрямилась і підбадьорливо поплескала по шиї Ромашку
          — вони майже наздогнали Дем’яна.
        </p>

        <p>
          Вітер розвівав Ясине волосся і лоскотав обличчя, охоплював усе тіло й
          ніс на своїх крилах кудись догори, здіймаючи вгору. Вони порівнялися з
          другом, і раптом останній почав гальмувати. Яся повторила його дії і
          потягнула вліво поводи — кінь повернув, і Яся побачила внизу прірву з
          рікою, а просто — краєвид Міжгір’я. Серце закалатало від відчуттів:
          вона так давно цього не відчувала — воля думок, неначе після довгої
          засухи зробити ковток води. У Ясі мимоволі скотилась сльоза, яку вона
          одразу ж стерла. Стільки часу були думки тільки про Аню…
        </p>

        <p>
          Просто майорів горизонт із пагорбами та хатинками, з димоходів яких
          йшла пара. Міжгір’я восени виглядало дивовижно, і друзі на мить
          відчули, ніби вони опинились у казці.
        </p>

        <p>
          Намилувавшись удосталь краєвидом, Яся та Дем’ян «приселили» коней до
          огорожі перед обривом, розстелили покривало і розклали пожитки, які їм
          роздобув Дем’ян: з десяток канапок із шинкою, запакованих у пластиковий
          контейнер, мармеладки, фрукти та чотири апетитні заварні тістечка, а
          також термос із гарячим чаєм. Декілька годин пролетіли непомітно. Вони
          все теревенили про минуле, про аварію, про події тут і думки обох
          загалом. Коли обидвоє змерзли до кісток, а бабця за годину подзвонила
          двічі — спитати, як справи, і нагадати, що час іти вечеряти, — Яся із
          Дем’яном зібралися і пішли тим самим шляхом назад до ферми.
        </p>

        <p>
          Вони тихо теревенили, намагаючись не порушувати лісовий спокій, тому,
          крокуючи деякий час у цілковитій тиші, одразу почули шурхіт. Потім щось
          тріснуло і стрімко покотилось вниз пагорбом десь із правого боку.
          Друзі спинились і перезирнулись. Ехом до них пройшов стогін, і вони,
          не роздумуючи, обидвоє пострибали в бік звуку. Приблизно за 50 метрів
          від них, за деревами, йшла гірка, вкрита купою гілок, пнів та моху, а
          під нею лежав темношкірий хлопець.
        </p>

        <p>
          Він тримався за руку і щось шепотів собі під ніс, та, почувши шум, який
          спричинили коні, різко повернувся, і Яся впізнала Марка — хлопця, з
          яким познайомилась під час землетрусу і з яким час від часу теревенила
          в кафе.
        </p>

        <p>
          Дівчина зіскочила з коня і допомогла Маркові встати. Окуляри впали — і
          вона допомогла знайти їх серед листя, щоб хлопець бодай щось побачив.
          Він був увесь у листі й брудний, особливо руки, бо з правої стирчала
          ручка. Яся відсахнулась.
        </p>

        <p>— Господи! Це як у тебе так вийшло?</p>

        <p>
          — Я пішов роздивитись місцевість щодо рослин та грибів і побачив дуже
          цікавий вид квітів, які досі збереглися в таку глибоку осінь.
          Нахилився, щоб придивитись, і хотів занотувати, але перечепився і
          покотився вниз; мій зошит десь зник, а з ручкою ви самі бачите, що
          сталось, — сказав він, і Яся помітила, що бідний ледь стримує сльози.
        </p>

        <p>
          — Тобі потрібна терміново перша допомога і в травмпункт. Ти дозволиш?
          — кивнула дівчина на пошкоджену руку.
        </p>

        <p>Марк зажмурив очі й кивнув.</p>

        <p>
          Тоді Яся обережно витягла ручку, промила водою, яка в них лишилась, і,
          відірвавши клапоть від тканини, що накривала кошик із продуктами,
          обмотала йому руку і зав’язала міцний вузол.
        </p>

        <p>— Скільки тобі років, що ти вмієш таке? — здивувався Марк.</p>

        <p>
          — П’ятнадцять. У нас у школі регулярно проводять майстер-класи з
          надання першої допомоги для дівчат і стрільби з автоматів — для
          хлопців. Ходім, сядеш зі мною, треба поспішати. Ти вмієш їздити
          верхи?
        </p>

        <p>Марк схвально кивнув:</p>

        <p>
          — «Захист Вітчизни». Але є ще дещо — я загубив зошит. Допоможете мені
          його знайти?
        </p>

        <p>— Він такий важливий?</p>

        <p>
          — Там усе, що я нотував останній місяць для курсової роботи, — потис
          він плечима. — Я вас розумію, можете їхати, я впораюсь, тим більше
          рука полікувана, — він жваво підняв пошкоджену руку вгору, але його
          ніхто не підтримав.
        </p>

        <p>Яся тяжко видихнула і задумалась, тому Дем’ян узяв усе у свої руки.</p>

        <p>
          — Давайте, я візьму його з собою, а ти, Ясю, пошукай зошит. Він,
          мабуть, десь тут. Ось тобі про всяк випадок для самозахисту, — хлопець
          кинув Ясі складний кишеньковий ніж. — Доженеш нас за кілька хвилин. Але
          скажи, де шукати лікаря?
        </p>

        <p>
          — Зазвичай вона у своєму офісі в кафе, але спитай краще діда Янека.
          Напишеш мені — я під’їду.
        </p>

        <p>— Згода, — мовив Дем’ян і зіскочив із коня.</p>

        <p>
          Вони з Ясею допомогли Маркові застрибнути верхи; він вчепився в
          Дем’яна, і хлопці чимдуж пострибали геть.
        </p>

        <p>
          Яся озирнулась, опинившись у цілковитій тиші. Лиш вітерець, зачіпаючи
          сухе листя, порушував цю ідилію. Отже, пагорб… Він був угорі. Можливо,
          звідти буде краще видно, де той зошит… Вона прив’язала коня до дерева
          і полізла вгору. Опинившись угорі, роздивилась навкруги: все було
          вкрите пнями і маленькими сухими деревцями. Пройшовши трохи по
          периметру, вона раптом помітила на засохлому кущі краї білих сторінок.
          Обережно і дуже-дуже поволі спустившись до того місця, вона схопилась
          за сусіднє гілля, що стирчало із землі, і таки досягла того зошита.
          Потім вона поволі спустилась і хотіла відв’язати Ромашку, але та
          почала брикатись і фиркати.
        </p>

        <p>— Все, все, — вона зробила кілька кроків назад, — не чіпаю.</p>

        <p>
          А потім — різкий звук, хрускіт, і з-за дерева вискочила пухнаста чорна
          велика потвора. Вона скочила на Ясю і, зловивши погляд, паралізувала.
          Дівчина не могла рухатись, лиш відчувала паніку, що облила неначе
          відро крижаної води, а ще — страх. Безмежний і тягучий.
        </p>

        <p>
          — Поспішіть, ваша підказка прямо у вас перед носом.
        </p>

        <p>
          Яся придивилась і побачила знайому морду: це був кіт Амелі, тільки
          втричі більший. Він нахилився ближче своєю мордою, і Яся відчула, як із
          пащі з гострими жовтими іклами повіяв сморід. Він принюхався до неї:
          — Ви знайдете його сьогодні ввечері, мене просили передати не
          зволікати і одразу бігти до Агати. Ти мене почула?
        </p>

        <p>
          — Так! — сказала Яся подумки і здивувалась, бо кіт почув, тому хутко
          додала: — Чому ти такий?
        </p>

        <p>
          — Я лісова нечисть. Такі, як ми, родом із Франції; нас відправляють
          оберігати наших побратимів у людській подобі. Четверту стихію сьогодні
          ледь не схопив Перелесник, але я його врятував. Він вам брехатиме, але
          правда вилізе назовні рано чи пізно, — додав він і раптом зник, а Яся
          втратила свідомість.
        </p>

        <p>
          Вона отямилась, лежачи на землі. Надворі вже геть стемніло, а телефон
          дзвонив і дзвонив. Вона поглянула на екран — минуло пів години, відколи
          Дем’ян і Марк її залишили. Дівчина підняла трубку і сказала, що все
          добре: кобила не хотіла її слухатись, довелось зачекати, коли
          заспокоїться. Поговоривши з бабцею, вона підвелась і посвітила
          ліхтариком на Ромашку.
        </p>

        <p>
          — Ти знаєш дорогу назад? — та промовчала. — От і я ні. Зараз будемо
          шукати.
        </p>

        <p>
          Щоб вийти з лісу, у неї пішло ще десь 20 хвилин блуканини з
          ліхтариком. На виїзді її вже чекав дуже схвильований дід, Федько і
          кілька працівників.
        </p>

        <p>— Господи, слава тобі, — сказав дід. — Федьку, дзвони Кирилові та Андрію, кажи, шо всьо добре — най вертаються. А ти, — він поглянув на Ясю, — бігом, ходи за мнов.</p>

        <p>
          Дівчина злізла з коня, передала Ромашку Федькові і пішла слідом за
          дідом. Він привів її в хатчину, де були Дем’ян, бабця і медсестра.
          Бабця говорила телефоном із батьками Ясі, поки її оглядали.
          Впевнившись, що з дівчиною все гаразд, лікарка пішла геть, а на Ясю
          спрямували люті погляди.
        </p>

        <p>
          Вона поглянула на схвильованих рідних і вибачилась.
        </p>

        <p>
          — Твої вибачення нічим не поможут, голов тре було думати. Бери
          телефон, — сказала бабця, простягаючи Ясі слухавку.
        </p>

        <p>— Ярославо, я місця собі знайти не можу, що сталось?</p>

        <p>
          — Вибач, мам, я шукала зошит мого друга і потім трішки заблукала, але
          все гаразд, правда. Мені дуже шкода, що я змусила вас усіх
          хвилюватись, — вона знову поглянула на бабцю і діда, мовляв, ці слова
          теж для них.
        </p>

        <p>
          — Добре, я рада, що все добре. Михасю, з нею все добре, — сказала вона
          татові за трубкою.
        </p>

        <p>— Більше в ліс ні ногов! — гаркнула бабця і забрала телефон попрощатись із мамою.</p>

        <p>
          Яся схвально кивнула, не сперечаючись. Верта́тись туди їй і самій уже
          не хотілось. Дівчина подивилась на найкращого друга. Він поглядом
          «кричав», що їм потрібно все обговорити й він не може дочекатися, коли
          вони спекаються дорослих, а ще в очах читалась паніка — дуже сильна.
        </p>

        <p>
          Договоривши з мамою, бабця поклала трубку і поглянула на двох друзів.
        </p>

        <p>— Што ви собі двоє думали?!</p>

        <p>— Взагалі-то нічого… — почала Яся, але її перебили.</p>

        <p>
          — У мене ледве серце не стало! Пів години трубку не бере — шо я собі
          маю думати?
        </p>

        <p>
          — Мені правда шкода… — Яся потисла плечима. — У мене в один момент зник
          зв’язок, я перелякалася. Правда, я сама більше туди не хочу, вибачте…
        </p>

        <p>Бабця раптом пом’якшала поглядом і розгладила фартух.</p>

        <p>
          — Дитино… ай, як з тобов бути?… Тебе ж нема за шо карати — ти ж то не
          нарочно зробила, та й мамка погодилася, так што того разу тобі з рук
          зійде. Обмежень ставити не буду, але як шось ше раз станеться, я
          контроль посилю й знову приставлю до тебе Федька, — додала вже
          строгішим тоном, і Яся кивнула. — От і всьо, йдіт собі, але не далеко.
          В маєток або в кафе, або туй сидіть, як хочете, але дальше — ні ногов.
        </p>

        <p>
          Друзі погодились і, вставши, пішли геть. На вулиці вони обидвоє миттю
          випалили:
        </p>

        <p>— Що будемо робити?</p>

        <p>— Що з тобою сталось у лісі?</p>

        <p>
          — Розкажу, але пізніше. Які у нас зараз плани?
        </p>

        <p>
          — Ти мене не покоїш, подруго, — захитав головою він. — У тебе таємниці
          від мене?
        </p>

        <p>
          — Мені досі здається, що я сильно вдарилась головою, але це було
          страшенно лячно. Дай мені отямитись.
        </p>

        <p>Хлопець неохоче, але, кілька секунд подумавши, кивнув.</p>

        <p>— Як там Марк?</p>

        <p>
          — Все добре. Ми домовились за годину зустрітись у кафе. І, до речі, —
          він поглянув на годинник, — ми спізнюємось. А ще до нас підійде Амелі —
          я з нею говорив.
        </p>

        <p>
          — Ти тут непогано без мене собі ради даєш, — сказала Яся, вибудовуючи
          маршрут до кафе, що світилось нічними вогниками.
        </p>

        <p>
          — А ти що думала? Я не такий безпорадний, як здаюсь. А ще, господи, як
          від тебе смердить кіньми!
        </p>

        <p>Яся закотила очі й принюхалась:</p>

        <p>— А від тебе чого — ні?!</p>

        <p>Він потис плечима:</p>

        <p>— Тебе не було дуууже довго.</p>

        <p>
          — Мало того, — вона нюхнула його ще раз, — ти що, духами
          набризкався? — і тут вона зрозуміла; вуста дівчини розповзлися в
          хитрій посмішці: — Що, Марк сподобався, так?
        </p>

        <p>
          Навіть у світлі тьмяних вуличних ліхтарів Яся побачила, як загорілись
          щоки Дем’яна рум’янцем.
        </p>

        <p>— Ні…</p>

        <p>
          — Ну-ну, — сказала вона і пішла наперед, відчиняючи двері в кафе.
        </p>

        <p>
          Марк сидів за столиком коло вікна, друзі сіли з ним, і за кілька хвилин
          до них підійшла офіціантка взяти замовлення.
        </p>

        <p>
          Яся дістала з-під светра зошит Марка і передала хлопцеві.
        </p>

        <p>— Надіюсь, він того вартував.</p>

        <p>
          — Ще б пак! Дуже, дуже тобі дякую! До речі, що сталось?
        </p>

        <p>
          Яся хотіла розповісти, але її урвала Амелі, яка раптово з’явилась і,
          привітавшись із усіма, сіла в їхнє тепле коло — і тема одразу
          змінилась.
        </p>

        <p>
          Розмови лились одна за одною, чай у кружках зігрівав руки, гаряча їжа —
          шлунок, а атмосфера створювала навколо новорічний настрій, поки Федько
          потрохи одягав величезну ялинку, яку затягнули всередину і поставили
          під куполом посеред зали.
        </p>

        <p>
          Камін хрускотів розпаленим багаттям, а люди навколо насолоджувались
          теплим осіннім вечором. І все було дуже чарівно, допоки в приміщення не
          зайшов Влад. Він був закутаний у шарф, шапку та куртку, що вкрились
          снігом. Судячи з погляду, він був явно розлючений.
        </p>

        <p>
          Побачивши столик, де сиділи друзі, він трохи охолонув, після чого
          гордовито задер підборіддя і пішов у бік столу, де його вже чекала
          компанія місцевих дівчат і двох хлопців. Знявши з себе теплі речі, він
          розкуйовдив своє каштанове волосся і, відкинувшись на спинку крісла,
          більше не глянув у їхній бік. Яся фиркнула і відвернулась.
        </p>

        <p>
          — Це хлопець тієї божевільної старенької, з яким ви останнім часом
          вештались? — спитав Марк.
        </p>

        <p>— Еге ж, — кивнула Амелі. — Була одна справа, та шкода — він свиня.</p>

        <p>
          — Сумно. В таких людей зазвичай є причини бути такими гівнюками, —
          потис плечима Марк, і усі четверо задумались.
        </p>

        <p>
          А дійсно, яку таємницю може приховувати Влад? Кинувши декілька
          варіантів про звичайного зіпсованого підлітка, вони змінили тему.
        </p>

        <p>
          — Слухай, Марк, а коли ти приїхав? — раптом спитала Амелі, зробивши
          ковток чаю.
        </p>

        <p>Він задумався:</p>

        <p>— Здається, 20 жовтня.</p>

        <p>Амелі поперхнулась, і вони з Ясею перезирнулись.</p>

        <p>— А що? Що таке? — здивувався такій реакції хлопець.</p>

        <p>— Нам терміново потрібен Влад, — сказала Амелі, і Яся покликала офіціантку.</p>
      </div>

        <div className="mt-8 flex justify-between text-lg">
          <Link
            href={`/${lang}/reading/chapters/11`}
            className="underline"
          >
            ← Попередній
          </Link>

          <Link
            href={`/${lang}/reading/chapters/13`}
            className="underline"
          >
            Наступний →
          </Link>
        </div>
      </BookPage>
    </main>
  );
}