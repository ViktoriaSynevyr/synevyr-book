"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import BookPage from "../../../../components/BookPage";

export default function Chapter6Page() {
  const params = useParams<{ lang: string }>();
  const lang = params.lang === "uk" ? "uk" : "en";

  return (
    <main className="min-h-screen bg-[#050505] px-6 py-12">
      <BookPage title="6. Амелі">
        <div className="space-y-7">
        <p>
          Яся перебувала в глибокому шоці. Вона на хвильку забула, як дихати, і просто дивилась на вікно позаду старенької. Мавки, Лісовик, Перелесник, якась Синь, дивне озеро, вбивства, лісник зник, Аня… Аня. Точно. Це ж заради неї Яся тут? Яся нишком подивилась на горня, яке тримала старенька, а потім — на столик.
        </p>

        <p>
          Її очі почали бігати по кімнаті — хотілось кричати. Вона обрана? Та що ви таке верзете? Час забиратись. Вона встала, струсила зі спідниці уявні крихти і вже хотіла почати вибачатись, але замість слів із вуст вирвався крик, бо просто коло столика з’явилось створіння. Маленьке, замурзане, зі спухлим личком, крихітним акуратним носиком, великими блакитними очима й білим кучерявим волоссячком, що гніздом стирчало в різні боки; за зростом — приблизно пів метра, головою якраз досягало журнального столика. Істота торкнулась порожньої кружки, яку щойно поклала на стіл бабця Влада, але скоро відсахнулась через крик.
        </p>

        <p>— Ви чого кричите? — обурено звернулась вона до Ясі й поглянула на бабцю.</p>

        <p>— Все гаразд, Анфісо, просто Ярослава ніколи не бачила домових.</p>

        <p>— Хіба в маєтку Мельників не мешкають близько ста моїх братів та сестер? Та пані Мелашка стільки ворожить, стільки з неч…</p>

        <p>— Годі! — обірвала її пані Агата.</p>

        <p>— …що там потрібна постійна чистка і захист будинку, — гордовито закінчила вона і зникла разом із горням.</p>

        <p>— Ну що за домова! А Владику?</p>

        <p>— У неї свій характер, — відповів той.</p>

        <p>
          Тоді бабця поглянула на дівчину — Ясю трусило, тож, тяжко видихнувши, старенька обережно підібрала слова.
        </p>

        <p>
          — Розумію, не щодня таке побачиш, але мусила ж ти хоч трішки повірити в те, що відбувається. Оскільки ти вже знаєш усе, тобі можуть відкриватись наступні таємниці.
        </p>

        <p>Яся кілька хвилин мовчки думала. Ще таємниці? Тобто це не все? У що її втягують? Навіщо?</p>

        <p>— Отже, дитино, у тебе більше нема запитань до мене?</p>

        <p>Яся похитала головою і поглянула на Влада.</p>

        <p>
          — В такому випадку краще поспіши назад, бо урок фізкультури скоро закінчиться. Владику, проведи нашу гостю до виходу.
        </p>

        <p>
          Яся не стала питати, звідки пані Агата знає, що в неї зараз іде урок фізкультури. Влад кивнув і, піднявшись, пішов до дверей, але дівчину раптом знову спинила стара, підскочивши й гукнувши:
        </p>

        <p>
          — Стривай! Я дещо згадала. В бібліотеці твоєї бабці повинна бути книжка «Лісові істоти Карпат» — там також будуть деякі важливі записи про те, що робити обраним зі стихіями та як розвивати свої сили. Знайди її.
        </p>

        <p>
          Яся спантеличено кивнула і почала повторювати про себе назву книжки, щоб, не дай Боже, не забути. Господи! Знову йти на третій поверх? Звідки пані Агата знає про бібліотеку? Вона поплелась слідом за Владом і в роздумах отямилась аж на виході з будинку.
        </p>

        <p>
          Хлопець красномовно «пропалював» у ній дірку — натякаючи, що їй варто якнайшвидше опинитись за дверима на вулиці, — але Яся не поспішала, бо мала ще одне питання, яке змогла витягти з густої каші в голові. Завагавшись трішки, дівчина врешті спитала:
        </p>

        <p>
          — Твоя бабця сказала, що залишилось знайти дівчину, пов’язану з водою, і хлопця, об’єднаного з природою. А як же той, хто пов’язаний із вогнем?
        </p>

        <p>
          Влад поглянув на неї роздратовано і процідив:
        </p>

        <p>
          — Це я, Ярославо. А тепер іди й перевари все як має бути, — сказав він і зачинив двері перед носом дівчини.
        </p>

        <p>Подивившись іще мить на дерево навпроти і відпустивши хвилю гніву за таке поводження, Яся розвернулась і пішла геть.</p>

        <p>
          Абсурд. Хлопець із «вогняним» характером. Він хлопець із занадто сильно задертим носом — ось що йому підходить. Гівнюк. І все ж… Яся пообіцяла собі не обертатись, але таки озирнулась поглянути на старий темний будинок. Домові… існують? Перелесник, що затягнув її в бібліотеку, і той напис на дощечках…
        </p>

        <p>Потрібно справді все обдумати, затвердила Яся — і варила цю кашу в голові весь наступний день, вечір на роботі і пів ночі, поки безсила не «відключилася».</p>

        <p>
          Зранку вона прокинулась украй втомленою і, щоб хоч трохи відволіктись, прийняла душ. Нав’язливі думки все одно повертались, але вже були більш утрамбовані.
          <br />
          Отже, все ж таки Аня її не кликала — це все була брехня Перелесника, якого попросили мавки провести Ясю у їхній світ… у ліс, де місце всім міфічним істотам, а також чотирьом стихіям природи, що підтримують життя в лісі: Вогонь, Повітря, Вода та Земля. І Яся є однією з них. Чи готова вона це все побачити? Однозначно ні.
        </p>

        <p>Вона ствердно кивнула головою, та сумнів усередині — десь на дні живота — протестною хвилею пройшовся всім тілом.</p>

        <p>
          Ліс вивчено на 14 відсотків, як сказала пані Агата. Невже мавки, уся українська міфологія й сотні популярних творів, побудованих на легендах про карпатських істот, не є вигадкою? Можливо, письменники справді бачили їх? І невже Ясі — саме їй, одній із сорока восьми мільйонів у країні — підвернулась можливість побачити все це на власні очі?
        </p>

        <p>Чи варте воно того?</p>

        <p>Вона ще довго роздумувала над цим питанням.</p>

        <p>
          Останній урок закінчився, і дівчина очікувала побачити за дверима Федька, що проведе її на обід, але його не було. Після вчорашнього вона вручила йому двісті гривень, і вони дуже чемно розійшлись. Можливо, щось сталось — або Бог його знає, — але сидіти голодною Яся не хотіла, тож зібралась і сама пішла їсти.
        </p>

        <p>
          Дорогою, в холі, з правого крила відчинились двері й вийшла групка людей, серед яких яскраво виділялось довге-довге бордове волосся, що блищало в промінні сонця, яке падало з віконець коло дверей. На мить дівчина зустрілась із Ясею поглядом. Незнайомка посміхнулась і, не відстаючи від інших, попрямувала до виходу.
        </p>

        <p>
          Яся пішла слідом. Компанія йшла в кафе, а Яся звернула до хатчини. За трапезою Яся дізналась, що Федько прихворів, і, оскільки дівчина себе добре веде та й «втягнулась» у графік, їй дарують трохи свободи на декілька днів.
        </p>

        <p>Добре. Це дуже добре. Це означає, що вона втерлась у довіру. І якщо бути обережною — все йтиме як по маслу.</p>

        <p>
          Пообідавши, вона пішла на зміну. Того вечора в кафе весь персонал знову спостерігав за новоприбулими — французькою родиною з тією самою дівчинкою з бордовим волоссям. Вони довго вечеряли, теревенили щось своєю мовою — і всі були такі тонкі, такі вишукані і чемні. Закінчивши, родина пішла геть, а все кафе наче видихнуло і почало шепотітись щодо нових гостей, на що Яся тільки закочувала очі: плітки на плітках — і одна краща за іншу.
        </p>

        <p>
          Відпрацювавши і здавши зміну, дівчина повечеряла і пішла назад у маєток. Було прохолодно, тому вона запхала руки до кишень і, штурхаючи листя під ногами, йшла та думала про те, що її чекає в кімнаті тепла постіль; і, що найприємніше, — від тотального виснаження голова не варила кашу, як учора, тож дівчина вже «літала» десь між хмарами, мріючи про сон.
        </p>

        <p>
          Опинившись під маєтком, Яся раптом підняла голову, щоб не зашпортатись об сходи, і побачила на ґанку високу фігуру. Яся одразу зрозуміла, хто це: бордове волосся цього разу огортав зелений шарфик із сріблястими смугами. Дівчина курила.
        </p>

        <p>
          Ой ні-ні — цікавість як рукою зняло, Ясі не потрібні проблеми. Якщо її побачить бабця або дід із кимось із правого крила — ще й із сигаретами… Дівчина хотіла проскочити повз, не вітаючись, але француженка зупинила її, привітавшись.
        </p>

        <p>— Привіт, — відповіла Яся, будучи вже однією ногою в будинку.</p>

        <p>— Ты здесь живёшь, но не в крыле гостей, — почала говорити вона ніжним невинним голосом із крихтою акценту. — Мне стало интересно, кто ты, расскажешь?</p>

        <p>— Пані Мелашка — моя бабуся.</p>

        <p>— Это владелица, да? Боже, у неё такая невероятная кожа в шестьдесят! Не зря она мольфарка. К тому же сказала мне, мол, ждёт меня очень мутное будущее — размытое и неясное; помню, она добавила, что стоит быть аккуратной, принимая выбор в ближайшее время.</p>

        <p>
          Раптом на перила заскочив величезний звір і, махнувши пухнастим хвостом, почав тертись об дівчину, муркочучи.
        </p>

        <p>Яся здригнулась.</p>

        <p>— Що це?!</p>

        <p>Амелі розсміялася.</p>

        <p>— Это мой кот Бомонд. Он мейн-кун, поэтому такой большой и напоминает зверя, — вона почухала його за вушком. — Он нашёл меня, когда мы были с родителями на прогулке в лесу во Франции. Буквально прилип. Я была ребёнком — лет пять, — так что теперь это мой проводник повсюду, — величезний чорний кіт зістрибнув із перил і зник у темряві.</p>

        <p>— Кстати, это единственный отель, где разрешили заселиться с животным; твоя бабушка очень добрая.</p>

        <p>
          Яся стояла в ступорі. Вона переварювала все, що їй сказали, і раптом зловила те, що здивувало найбільше.
        </p>

        <p>— Стривай, бабця — мольфарка? Я цього не знала, — дівчину це страшенно зачепило. Можливо, ця дівчина зможе розповісти їй щось про бабцю. Вона озирнулась довкола. Нікого не було. Дід Янек — на конюшні, бабця — в хатчині. Можливо… ніхто її і не помітить? Яся підійшла ближче і сперлась на перила.</p>

        <p>— Да ну! Как так? Она же твоя бабуля! — здивувалась дівчина.</p>

        <p>— Я з нею познайомилась два тижні тому. Мене батьки сюди відправили в якості покарання.</p>

        <p>— Правда? — вона посміхнулась. — А ты не такая уж и простая, как кажется на первый взгляд. Я — Амели, — вона простягнула руку.</p>

        <p>— Ярослава, скорочено — Яся, — дівчина потисла руку у відповідь, відчувши надзвичайно м’яку й делікатну шкіру — мов до водяної гладі доторкнулась.</p>

        <p>— Значит… — Амелі затягнулась. — Ты тут в плену. И надолго?</p>

        <p>— До Різдва.</p>

        <p>— Рождества? Долго. Ну, у меня родители любят обосноваться на одном месте, если им понравится. Мы тут на месяц, может, даже больше.</p>

        <p>Вони замовкли. Обидві дивились на небо. З Амелі було надзвичайно комфортно. Раптом Яся забула і про бабцю Мелашку, і про діда Янека. Вона дивилась на зоряне небо і шукала тему для розмови.</p>

        <p>— Отже, Слизерин? — Яся кивнула на шарф дівчини.</p>

        <p>— Дааа, обожаю Гарри Поттера. В детстве посмотрела фильмы, потом перечитала все части, обожаю Тома Фелтона и его персонажа — Драко Малфоя! У меня даже есть тату с его портретом на левой руке и тату змеи за ухом, — вона прибрала пасмо волосся, і Яся справді побачила змію, що плелась від скроні за вухо і аж до шиї.</p>

        <p>— Ого, батьки дозволили тобі набити тату? Скільки тобі?</p>

        <p>— П’ятнадцять, — потисла плечима Амелі. — И в нашей семье это нормально: мне дают свободу самовыражения, чтобы я могла воплотить в жизнь почти все пубертатные мысли и не застряла в возрасте ребёнка, когда мне будет двадцать. Но вернёмся к фандому, — вона раптом заплющила очі й з насолодою продовжила: — Гарри — это дом, в котором тебе всегда будут рады. Место, где тебя согреют наколдованным пледом и чашкой горячего шоколада, рассказав историю у горящего камина.</p>

        <p>— У холодному слизеринському підвалі?</p>

        <p>Посмішка з обличчя Амелі зникла, і вона змучено мовила:</p>

        <p>— Гриффиндор?</p>

        <p>— В точку. Але книжки я не читала. Проте передивлятись усі частини «Гаррі Поттера» в грудні — це традиція.</p>

        <p>— Боже, ты столько деталей упускаешь! Фильмы — это лишь верхушка огромного айсберга. Они очень многое упустили из-за экранного времени.</p>

        <p>— Ти мені натякаєш на те, щоб я прочитала книжки, так? — Яся позіхнула. — Я подумаю.</p>

        <p>— Вот и славно!</p>

        <p>Дівчина подивилась на перила і раптом дещо згадала:</p>

        <p>— А як ти мене розумієш?</p>

        <p>— Я знаю русский. Украинский с русским схожи немного. Мы перед этим были в Ужгороде несколько недель, и тут уже пару дней — я слушаю говор; слова, которых не понимаю, — переспрашиваю и быстро улавливаю. Я — полиглот.</p>

        <p>— Скільки мов знаєш?</p>

        <p>— Поки що три — англійську, іспанську, звісно французьку, ну і російську. Українська — це мій четвертий.</p>

        <p>— Круто.</p>

        <p>— Знаю, — вона загасила цигарку об черевик і викинула її в смітник коло янголятка.</p>

        <p>— Тоді тобі варто прочитати деякі українські твори, щоб поповнити словниковий запас.</p>

        <p>— Какие ты бы мне посоветовала?</p>

        <p>Яся думала, що дівчині це не сподобається, але Амелі питала серйозно, тому вона відповіла тим, що якраз почали в школі; вчителька зранку дуже хвалила цей твір.</p>

        <p>— «Тіні забутих предків».</p>

        <p>— Погоди, я запишу, — вона витягла телефон і скоро занотувала почуте. — Есть. Merci beaucoup.</p>

        <p>— Будь ласка, — Яся позіхнула. — Ну гаразд, рада була познайомитись, Амелі, я дуже змучилась — хочу якнайшвидше лягти спати.</p>

        <p>— Bonne nuit — тобто «надобраніч», — відповіла дівчина з сильним акцентом, але Яся посміхнулась.</p>

        <p>— Сільвупле, тобі теж.</p>

        <p>Скоро, піднявшись у кімнату, Яся схопила піжаму, прийняла душ і вляглась у ліжко. Зранку вона, як завжди, поснідала і, повертаючись у кімнату, знову зустріла Амелі на ґанку. Цього разу дівчина пила каву, і Яся приєдналась до неї зі своєю чашкою.</p>

        <p>— У тебе є якісь плани на ранок?</p>

        <p>— Нету.</p>

        <p>— А чого тоді так рано встала?</p>

        <p>— Я ранняя птичка.</p>

        <p>— Тоді дозволь запросити тебе в гості.</p>

        <p>— Повидать запретное левое крыло? Звучит как приключение. Давай!</p>

        <p>Допивши каву, дівчата викинули стаканчики і скоро піднялись нагору. Яся доєдналась на урок і, вимкнувши звук та камеру, сіла на ліжко. Амелі розглядала пейзаж осінніх дерев унизу і ліс у далині.</p>

        <p>— У тебе є тут друзі?</p>

        <p>— Відносно.</p>

        <p>— Это как?</p>

        <p>— Вони є — і їх одночасно нема.</p>

        <p>— Волк-одиночка? Новенькая?</p>

        <p>— Типу того.</p>

        <p>— Хочешь развеяться?</p>

        <p>Яся підняла брови.</p>

        <p>— Як?</p>

        <p>— Можно поехать в центр вашего села, посмотреть, какая там обстановка. К тому же мне нравится, когда люди смотрят на меня, слыша русский язык.</p>

        <p>— Обережно, можна залишитись без зубів.</p>

        <p>— То есть?</p>

        <p>— Буквально. Тому краще переходь на українську.</p>

        <p>— Мне пока тяжело составлять предложения…</p>

        <p>— Нічого, я виправлю, якщо що. Треба ж із чогось починати, — Яся посміхнулась, подумки дякуючи Всесвіту за шанс перемкнути цю огидну какофонію на рідну мову.</p>

        <p>— Что ж… мабуть, ти права.</p>

        <p>— Що ж, — виправила Яся.</p>

        <p>— Що ж, — кивнула вона.</p>

        <p>— То що щодо села?</p>

        <p>— На рахунок…</p>

        <p>— На рахунок.</p>

        <p>— Я — за, але туди, мабуть, далеко.</p>

        <p>— У вас нету зайвих двох велосіпедов?</p>

        <p>— Нема і велосипедів, — виправила Яся. — Навряд чи. Мені тут кроку зайвого не можна ступити, але… — у Ясі спалахнула в голові думка. — Чекай, я в декого спитаю.</p>

        <p>Дівчина зайшла через ноутбук у телеграм і написала Федькові:</p>

        <p>«На фермі є два ровери?»<br />«Є, а що?»<br />«Можна мені їх?»<br />«А кому другий?»<br />«Побачиш»<br />«На коли треба?»<br />«Вже, на заднє подвір’я правого крила.»<br />«Ризикована штука.»<br />«Ти отримаєш винагороду, щедру, з відсотком.»<br />«Зрозумів, тоді буду через годинку.»<br />«Домовились.»</p>

        <p>— Ну що там? — спитала Амелі.</p>

        <p>— Ми покатаємось, але через годинку.</p>

        <p>— Excellent.</p>

        <p>— Але…</p>

        <p>— Та ну! Ці ваші «але»… — закотила вона очі.</p>

        <p>— У нас буде максимум година, оскільки в мене заняття, а я під суворим наглядом та не можу надовго відлучатись. Вчителі помітять, що мене немає, повідомлять батькам, ті — бабці, а вже тут за мною ходитимуть по п’ятах наглядачі — і жодної волі.</p>

        <p>— Seigneur! Крутишся, як той вуж: пролазиш у всі возможные отвори и шпарини.</p>

        <p>— Еге ж, — погодилась Яся.</p>

        <p>Коли закінчився урок, дівчина доєдналась до наступного і отримала повідомлення від Федька, що все готово.</p>

        <p>Дівчата спустились униз і обережно вибрались за межі будинку тим самим ходом через сад. Вони міцно вхопилися за ручки старих роверів і поїхали просто назустріч будинкам. Проїжджаючи повз старий маєток пані Агати, Яся напружилась, та сильно здивувалась, коли побачила, що будинок світився різноманітними прикрасами до Геловіну: купа гарбузів із вирізаними страшними обличчями, скелети на подвір’ї, павутина на деревах, гірлянди і багато інших дрібниць.</p>

        <p>Але будинок скоро промайнув; за ним — і той, де були вечорниці Лізи; а потім Амелі обігнала Ясю і полетіла вперед. Її зелено-сріблястий шарфик розвивався на вітрі хвилями до самих шерстяних кінцівок.</p>

        <p>І раптом Яся зрозуміла, що вперше за два тижні опинилась так далеко від ферми бабусі. Вона розглядала сільські хатинки, значно менші за маєток, у якому жила. Люди працювали на городі, носили воду з криниці або переганяли худобу. Осіннє листя підіймалось від вітерцю, який здіймали дівчата, проїжджаючи на роверах. Воно торкалось їхніх коліс і одягу, розліталося навкруги. Врешті знову почалась ділянка з полем, а через кількасот метрів у далині розвиднилась хатина. Коло неї зібралось декілька молодих людей на мотоциклах, що тримали стаканчики з паруючою рідиною. Дівчата перезирнулись.</p>

        <p>— Там магазин, сто відсотків, — сказала Яся.</p>

        <p>Під’їхавши ближче, дівчина впізнала Михася з вогнища. Він теж її впізнав, але вони не обмовились ні словом.</p>

        <p>І раптом Яся зрозуміла — їй гаплик. Це ж село: зараз піде слух, що онука з міста — тієї мольфарки — була в центрі села, і все. Настрій зник, Яся поникла, всередині все скрутилось комом від страху. Але відступати пізно.</p>

        <p>Вона глибоко вдихнула, стримуючи сльози. Як можна бути такою дурною?</p>

        <p>— Что-то случилось?</p>

        <p>— Ні, не зважай.</p>

        <p>Дівчата залишили ровери коло входу і піднялись на ґанок, де на дверях побачили два оголошення: одне — з фото зниклого лісника, друге — із запрошенням на свято Геловіну в темний будинок на краю села. Обіцяли цукерки й багато цікавих історій від мешканки маєтку.</p>

        <p>— Так вот почему тот будинок был украшен, — сказала Амелі.</p>

        <p>— Еге ж, — відповіла Яся.</p>

        <p>— А у вас больше никто не святкує це свято?</p>

        <p>— Ні, в Україні таке не дуже сприймають; у нас дещо інші традиції й звички.</p>

        <p>— Тогда почему это делает твоя бабушка? А… стривай, я поняла — пиар-ход?</p>

        <p>Яся кивнула, і дівчата зайшли всередину, позбувшись пропалюючих спину поглядів.</p>

        <p>Ось що означає мешкати в селі: всі один одного знають, і варто приїхати комусь новому — вас миттю обійме багато зацікавлених поглядів. Опинившись усередині, дівчата озирнулись, глянувши на стелажі, і Амелі першою ступила крок, обравши відділ солодкого.</p>

        <p>— Що будеш брати?</p>

        <p>— Не знаю, але я так шаленію від цієї пригоди, що в мене розбігаються очі, — сказала Амелі, і Яся в ту мить відмітила, що це перше речення, яке дівчина вимовила без помилок.</p>

        <p>І тут до Ясі дійшло: Амелі її обманювала — вона вміє говорити українською. Дивовижно, як можна бути такою? Авантюрною, хитрою — і при цьому такою спокійною й веселою одночасно. Після пережитого Ясі взагалі важко виражати емоції: зазвичай це йде через силу, але зараз, уперше за багато часу, вона помітила, як щось усередині поступово її «розв’язує» — і стає легше.</p>

        <p>Вона досі живе минулим, але нещодавні події й зацікавленість майбутнім дещо зупинили цей депресивний стан втрати й горя. Яся отримала стимул рухатись далі. І поки що їй це подобається, адже, можливо, копнувши глибше, вона зможе дізнатись більше про тутешні таємниці. Якщо, звісно, розбереться в усьому тому, що діється в голові.</p>

        <p>Амелі обрала собі декілька пряників у формі гарбузів та летючих мишей і, захопивши в холодильнику «Пепсі», пішла до каси.</p>

        <p>— Ти нічого не береш?</p>

        <p>Яся похитала головою, і, розрахувавшись, дівчата вже пішли було до виходу, але спинились, бо раптом магазин пішов ходуном — усе затрусилось. Амелі схопилась за прилавок, Яся впала на підлогу. Їм допоміг підвестись продавець.</p>

        <p>— На двір! Швидко! — кричав він.</p>

        <p>Опинившись зовні, вони побігли до найближчого дерева і, впавши на землю, затулили голови. Шалений гуркіт роздався з гір, посипалась земля, а асфальтом пішли тріщини.</p>

        <p>З очей потекли сльози, серце шалено калатало. А що, як вони помруть?
          <br />
          Ще кілька хвилин усе йшло обертом, а потім зупинилось. Яся отямилась від того, що її облили холодною водою.
        </p>

        <p>Вона широко відкрила очі й вдихнула повні легені повітря.</p>

        <p>— Що таке? Що сталось?! — крикнула вона.</p>

        <p>— Тебе охопила істерика, — пояснила Амелі.</p>

        <p>— А ще ми пережили легкий землетрус, — сказав хлопець із незвичною зовнішністю.</p>

        <p>Яся затулила обличчя. Це кінець. Їй кінець — бабця точно дізнається, де вона була.</p>
      </div>

